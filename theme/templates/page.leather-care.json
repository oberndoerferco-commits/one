            },
            "accordion_row_cnUNgA": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "How do you care for nubuck leather?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_NqngpU": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Nubuck should be cleaned using a soft brush designed for delicate leather. Avoid water and liquid cleaners, as they may leave marks. Protective sprays specifically made for nubuck can help prevent staining.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
