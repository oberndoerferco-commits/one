            "accordion_row_Gjgxan": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "Can you use regular leather products on nubuck?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_qyFVAH": {
                  "type": "text",
                  "settings": {
                    "text": "<p>No, traditional leather creams and conditioners should not be used on nubuck. They may darken or damage the surface. Always use products specifically designed for nubuck or suede.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
