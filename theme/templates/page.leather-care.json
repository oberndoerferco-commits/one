              },
              "blocks": {
                "text_XJTaPt": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Light stains can be removed using a nubuck brush or eraser. For more stubborn stains, professional cleaning is recommended. Avoid household cleaning products, as they may worsen the damage.</p>",
