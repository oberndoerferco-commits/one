            },
            "accordion_row_AQr7pY": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "What is nubuck leather?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_LgYz6F": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Nubuck is a type of top-grain leather that has been lightly sanded to create a soft, velvety surface. It is more delicate than smooth leather but offers a refined appearance.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
