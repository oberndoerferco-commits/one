            "accordion_row_4d4FXH": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "How should leather be stored long-term?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_rUzERB": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Leather should be stored in a dry, breathable environment away from direct sunlight. Use a dust bag and maintain the shape with soft filling. Proper storage helps preserve both structure and appearance.</p>",
