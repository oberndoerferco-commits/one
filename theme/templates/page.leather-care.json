            "accordion_row_PLqJ4d": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "What is patina in leather?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_xT4JJX": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Patina refers to the natural aging process of leather, resulting in a deeper color, soft sheen, and enhanced texture. It develops through use, light exposure, and handling, making each piece unique.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
