              ]
            },
            "accordion_row_GKtaUJ": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "Why does leather change color over time?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_XgTWGW": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Leather naturally reacts to light, air, and use. This gradual change in tone is part of its evolution and contributes to the unique identity of each piece.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
