            "accordion_row_FaYiJx": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "Does leather last a lifetime?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_nA3FHH": {
                  "type": "text",
                  "settings": {
                    "text": "<p>High-quality full-grain leather products can last for decades when properly maintained. Over time, they develop character rather than deteriorate, making them a long-term investment.</p>",
