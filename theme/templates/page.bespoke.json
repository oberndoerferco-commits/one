                "icon": "ruler",
                "width": 20
              },
              "blocks": {
                "text_zpRXkQ": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Initials or a monogram are hot-stamped in gold or silver foil, or blind. A logo or a drawing is stamped digitally. You see a proof before anything touches the leather.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
