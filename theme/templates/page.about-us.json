    "section_about_making": {
      "type": "section",
      "blocks": {
        "text_ab_eyebrow": {
          "type": "text",
          "settings": {
            "text": "<p>The making</p>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "custom",
            "font": "var(--font-subheading--family)",
            "font_size": "0.75rem",
            "line_height": "normal",
            "letter_spacing": "loose",
