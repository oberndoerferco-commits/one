{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
<meta
  name="theme-color"
  content=""
>

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  comment
    Fallback meta description for collection pages that don't have a dedicated
    SEO description set in the admin (page_description is blank in that case).
  endcomment
  assign meta_description = page_description
  if meta_description == blank and request.page_type == 'collection' and collection.description != blank
    assign meta_description = collection.description | strip_html | truncatewords: 40
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ page_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% if meta_description %}
  <meta
    name="description"
    content="{{ meta_description | escape }}"
  >
{% endif %}

{%- if request.page_type == 'collection' and collection -%}
  {%- comment -%}
    Additive structured data for collection pages: CollectionPage (with a basic
    ItemList of the products shown) and a Home > Collection breadcrumb trail.
    This does not replace or remove any sitewide Organization schema rendered
    elsewhere.
  {%- endcomment -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": {{ collection.title | json }},
      {%- if meta_description != blank %}
      "description": {{ meta_description | json }},
      {%- endif %}
      "url": {{ collection.url | prepend: request.origin | json }},
      "mainEntity": {
        "@type": "ItemList",
        "itemListElement": [
          {%- for product in collection.products limit: 24 -%}
            {
              "@type": "ListItem",
              "position": {{ forloop.index }},
              "name": {{ product.title | json }},
              "url": {{ product.url | prepend: request.origin | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }
    }
  </script>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ request.origin | json }}
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ collection.title | json }},
          "item": {{ collection.url | prepend: request.origin | json }}
        }
      ]
    }
  </script>
{%- elsif request.page_type == 'product' and product -%}
  {%- comment -%}
    Additive BreadcrumbList structured data for product pages: Home > Collection
    (the product's primary collection, if it belongs to one) > Product. Visual
    companion lives in blocks/_breadcrumbs.liquid, rendered above the product
    title on the PDP.

    2026-08-17 fix: this used to be product.collections.first, which put
    whatever collection happens to sort first for this product - for products
    that are ALSO tagged into "New in" or "Signature Pieces", that was
    frequently one of those two manual merchandising collections (both have
    ruleSet: null in the admin - curated by hand, not a real taxonomy
    category) instead of the product's actual category. e.g. the Leather
    Watch Box was showing Home / New in / ... even though it's a genuine
    member of the rule-based TRUNKS smart collection (whose rule set
    literally matches on title contains "Leather Watch Box").

    Both known non-category collections are excluded from the pick; the
    first REMAINING collection (a real, rule-based taxonomy collection such
    as Trunks) is used instead. If a product belongs to ONLY manual
    collections, the first of those is still used as a last resort so the
    breadcrumb never silently loses its second crumb.
  {%- endcomment -%}
  {%- liquid
    assign meta_ob_noncategory_collections = 'new-in,signature-pieces' | split: ','
    assign meta_product_collection = null
    for meta_pc in product.collections
      unless meta_ob_noncategory_collections contains meta_pc.handle
        assign meta_product_collection = meta_pc
        break
      endunless
    endfor
    if meta_product_collection == blank
      assign meta_product_collection = product.collections.first
    endif
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ request.origin | json }}
        }
        {%- if meta_product_collection -%}
        ,
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ meta_product_collection.title | json }},
          "item": {{ meta_product_collection.url | prepend: request.origin | json }}
        }
        {%- endif -%}
        ,
        {
          "@type": "ListItem",
          "position": {% if meta_product_collection %}3{% else %}2{% endif %},
          "name": {{ product.title | json }},
          "item": {{ product.url | prepend: request.origin | json }}
        }
      ]
    }
  </script>
{%- elsif request.page_type == 'page' and page.handle == 'leather-care-guide' -%}
  {%- comment -%}
    Additive FAQPage structured data for /pages/leather-care-guide. The
    question/answer content in snippets/oberndoerfer-care-schema.liquid is
    generated from the accordion in templates/page.leather-care.json.
  {%- endcomment -%}
  {%- render 'oberndoerfer-care-schema' -%}
{%- elsif request.page_type == 'page' and page.handle == 'faq' -%}
  {%- comment -%}
    Additive FAQPage structured data for /pages/faq. The question/answer
    content in snippets/oberndoerfer-faq-schema.liquid is generated from the
    accordion in templates/page.faq.json; regenerate it whenever that changes.
  {%- endcomment -%}
  {%- render 'oberndoerfer-faq-schema' -%}
{%- endif -%}

{%- comment -%}
  Additive Organization entity for search and answer engines: name variants,
  email and telephone, the social profiles from theme settings, and the two
  places the pieces can be seen. Shopify's own Organization block (name, logo,
  url) stays as it is.
{%- endcomment -%}
{%- render 'oberndoerfer-organization-schema' -%}
