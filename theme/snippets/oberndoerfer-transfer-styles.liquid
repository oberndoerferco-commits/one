{% comment %}
  Oberndoerfer Milano - pieces carried over from the "OBERNDÖRFER MILANO 5" design (10 September 2026)
  ------------------------------------------------------------------------------------------------
  The owner keeps this older theme live and asked for four things from the newer design: the
  ornament reveal at the start (snippets/oberndoerfer-reveal.liquid, rendered from layout/theme.liquid),
  the collection heroes and the photographs between the products (templates/collection*.json,
  sections/main-collection.liquid, snippets/oberndoerfer-grid-lifestyle.liquid), and the product
  page (templates/product*.json, blocks/_breadcrumbs.liquid, sections/oberndoerfer-recommendations.liquid,
  the gallery-by-colour patch in snippets/product-media-gallery-content.liquid). Later the same
  day: the mobile menu drawer (snippets/oberndoerfer-mobile-menu.liquid, rendered at the foot).

  Type stays this theme's own (the owner, 10 Sept: "I like the font used before on current live,
  don't change it"), so nothing here touches font families or weights. Only the heading sizes the
  product page was drawn with, the quieter price and the edge-to-edge card gallery on product
  page rows remain, scoped to product pages.
{% endcomment %}
{%- if request.page_type == 'product' -%}
  <style>
    main[data-template^='product'] {
      /* one shared heading scale, as on the newer theme */
      --ob-h1: clamp(1.5rem, 2.4vw, 2rem);
      --ob-h2: clamp(1.375rem, 2vw, 1.625rem);
      --ob-h3: clamp(1.125rem, 1.5vw, 1.25rem);
      --ob-h4: clamp(1rem, 1.25vw, 1.0625rem);
      --ob-label: 0.8125rem;
    }

    main[data-template^='product'] h1 { font-size: var(--ob-h1) !important; line-height: 1.2; letter-spacing: 0.01em; }
    main[data-template^='product'] h2 { font-size: var(--ob-h2) !important; line-height: 1.25; letter-spacing: 0.01em; }
    main[data-template^='product'] h3 { font-size: var(--ob-h3) !important; line-height: 1.3; letter-spacing: 0.012em; }
    main[data-template^='product'] h4 { font-size: var(--ob-h4) !important; line-height: 1.35; letter-spacing: 0.014em; }
    main[data-template^='product'] :is(h5, h6) {
      font-size: var(--ob-label) !important;
      line-height: 1.4;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    /* price treatment */
    main[data-template^='product'] product-price .price {
      font-size: 1rem !important;
      font-weight: 400 !important;
      color: rgba(0, 0, 0, 0.7) !important;
    }
    main[data-template^='product'] .product-card__content product-price .price {
      font-size: 0.75rem !important;
      color: rgba(0, 0, 0, 0.55) !important;
      letter-spacing: 0.02em;
    }

    /* product cards fill their tile (product page rows only: the collection grid keeps the
       live theme's own card, the owner's choice on 10 September) */
    main[data-template^='product'] .product-card .card-gallery.card-gallery {
      padding: 0 !important;
      background-color: transparent !important;
    }

    /* colourway line under the product title */
    .obm-colourway {
      font-family: var(--font-subheading--family);
      font-size: 0.8125rem !important;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(0, 0, 0, 0.55);
      margin-block: 6px 0 !important;
    }

    /* the house curve on hover */
    main[data-template^='product'] {
      --hover-transition-timing: cubic-bezier(0.22, 1, 0.36, 1);
      --hover-transition-duration: 0.38s;
    }
  </style>
{%- endif -%}
{%- comment -%}
  One card per colour on the Ready to Wear page (19 Sept). The owner's edit of
  templates/collection.ready-to-wear.json replaced the hero block that used to carry
  this script, so it lives here now and runs on that collection page only: a product
  whose Colour option is linked to the store's colours gets one card per colour, each
  showing that colour's photograph, its swatch ticked, and linking to its variant.
  Source: theme/assets-src/obm-colour-cards.js in the repo. The gate reads request.path: a
  rendered snippet does not see the collection object, so collection.handle is blank here.
{%- endcomment -%}
{%- if request.page_type == 'collection' and request.path contains '/collections/ready-to-wear' -%}
<script id="obm-colour-cards">
(function(){
  /* Oberndörfer Milano: one card per colour. A product with colour swatches gets a second
     card for each further colour, showing that colour's photograph and linking to its variant. */
  function split(card){
    if(card.dataset.obmSplit) return; card.dataset.obmSplit='1';
    var li=card.closest('li'); if(!li) return;
    var inputs=card.querySelectorAll('swatches-variant-picker-component input[type=radio]');
    if(inputs.length<2) return;
    var anchor=li;
    for(var i=1;i<inputs.length;i++){
      var inp=inputs[i], mediaId=inp.getAttribute('data-option-media-id'), variantId=inp.getAttribute('data-variant-id');
      if(!mediaId||!variantId) continue;
      var clone=li.cloneNode(true);
      clone.id=li.id+'-c'+i;
      var c=clone.querySelector('product-card'); if(!c) continue;
      /* cloneNode drops declarative shadow roots; rebuild them from the originals */
      var ol=li.querySelectorAll('overflow-list'), cl=clone.querySelectorAll('overflow-list');
      for(var k=0;k<ol.length&&k<cl.length;k++){ if(ol[k].shadowRoot&&!cl[k].shadowRoot){ try{ cl[k].attachShadow({mode:'open'}).innerHTML=ol[k].shadowRoot.innerHTML; }catch(e){} } }
      c.dataset.obmSplit='1'; c.dataset.obmClone='1'; c.id=c.id+'-c'+i;
      var scroller=clone.querySelector('slideshow-slides');
      var slides=scroller?Array.prototype.slice.call(scroller.querySelectorAll('slideshow-slide')):[];
      var target=null; slides.forEach(function(s){ if(s.getAttribute('slide-id')===mediaId) target=s; });
      if(!target||!scroller) continue;
      /* the colour's own photographs first: the front, then whatever follows it up to the next colour */
      var group=[target], n=target.nextElementSibling;
      while(n && !n.hasAttribute('variant-image')){ group.push(n); n=n.nextElementSibling; }
      slides.forEach(function(s){ if(s.hasAttribute('variant-image')){ s.hidden = group.indexOf(s)<0; } s.setAttribute('aria-hidden','true'); });
      group.slice().reverse().forEach(function(s){ scroller.insertBefore(s, scroller.firstChild); });
      target.hidden=false; target.setAttribute('aria-hidden','false');
      var comp=clone.querySelector('slideshow-component'); if(comp) comp.setAttribute('initial-slide','0');
      var hover=clone.querySelector('.card-gallery__hover-image .product-media');
      var back=group[1]&&group[1].querySelector('.product-media');
      if(hover){ if(back){ hover.replaceWith(back.cloneNode(true)); } else { hover.parentElement.remove(); } }
      /* links go to this colour */
      Array.prototype.forEach.call(clone.querySelectorAll('a[href]'), function(a){
        try{ var u=new URL(a.getAttribute('href'), location.origin); u.searchParams.set('variant', variantId); a.setAttribute('href', u.pathname+u.search); }catch(e){}
      });
      var cin=clone.querySelectorAll('swatches-variant-picker-component input[type=radio]');
      Array.prototype.forEach.call(cin, function(x,k){ x.checked=(k===i); if(k===i) x.setAttribute('checked',''); else x.removeAttribute('checked'); });
      c.removeAttribute('data-no-swatch-selected');
      anchor.insertAdjacentElement('afterend', clone); anchor=clone;
    }
  }
  function run(){ document.querySelectorAll('.product-grid product-card:not([data-obm-split])').forEach(split); }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', run); else run();
  new MutationObserver(function(){ run(); }).observe(document.documentElement,{childList:true,subtree:true});
})();
</script>
{%- endif -%}
{% render 'oberndoerfer-color-grouping' %}
{% render 'oberndoerfer-mobile-menu' %}
