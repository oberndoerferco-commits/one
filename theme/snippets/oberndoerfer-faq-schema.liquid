{%- liquid
  assign q1 = "Where are Oberndörfer Milano pieces made?"
  assign a1 = "Every piece is handmade in Italy by artisans in and around Milan, from Italian leather sourced from Italian tanneries."
  assign q2 = "What materials do you use?"
  assign a2 = "Italian leathers selected for durability and for how they age, including calf, nubuck and exotic leathers on selected pieces. Watch and jewellery boxes are built on a wood core and lined in microfiber or Alcantara."
  assign q3 = "How much does shipping cost?"
  assign a3 = "Shipping is complimentary on every order, worldwide, with DHL Express. There is no minimum order."
  assign q4 = "How long does delivery take?"
  assign a4 = "Pieces in stock are delivered within 7 days. You receive DHL tracking as soon as your order ships."
  assign q5 = "Will I pay import duties?"
  assign a5 = "Within the EU, no: prices include VAT. Outside the EU, local import duties and taxes may be charged by DHL on delivery and are paid by the customer."
  assign q6 = "What is your return policy?"
  assign a6 = "You can return a piece within 14 days of delivery, unused and in its original packaging. Personalised and made-to-order pieces cannot be returned."
  assign q7 = "Can I personalise a piece or choose a different leather or colour?"
  assign a7 = "Yes. Most pieces can be made in another leather, colour or lining, or personalised. Personalising an existing design takes 4–6 weeks."
  assign q8 = "How long does a bespoke commission take?"
  assign a8 = "Trunks take 2–6 months depending on complexity; furniture and highly detailed commissions take 4–6 months. We confirm your exact timeline before work begins."
  assign q9 = "Which payment methods do you accept?"
  assign a9 = "Credit and debit cards, PayPal, Klarna, Shop Pay and Google Pay. All payments are encrypted."
  assign q10 = "How should I care for my leather?"
  assign a10 = "Wipe it with a soft, dry cloth, keep it away from water, heat and direct sunlight, and condition it every 6–12 months. Store it in its dust bag when not in use."
  assign q11 = "How can I reach you?"
  assign a11 = "Write to info@oberndoerferco.com. We reply personally."
-%}
