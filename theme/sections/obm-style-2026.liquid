{% comment %}
  Oberndoerfer Milano - REDESIGN 2026 site-wide touches (draft theme only; sits in the header group so
  it loads on every page and prints no markup of its own):
  - the EB Garamond italic face (assets/obm-eb-garamond-italic.woff2, SIL Open Font Licence) used for
    collection titles and the "You may also like" heading, as Hermès sets its category names;
  - square colour chips and square buttons on product pages, as on Bottega Veneta's product page;
  - the phone header laid out like Bottega's: logo left, icons right, the menu icon last.
{% endcomment %}
<style>
  @font-face { font-family: 'OBM Garamond'; font-style: italic; font-weight: 400; font-display: swap; src: url('{{ 'obm-eb-garamond-italic.woff2' | asset_url }}') format('woff2'); }
</style>
{% stylesheet %}
  .ob-pdp-swatch { width: 28px; height: 28px; border-radius: 0; box-shadow: inset 0 0 0 1px rgba(24, 18, 12, 0.12); }
  .ob-pdp-swatch[aria-current='true'] { box-shadow: none; outline: 1px solid #1c1714; outline-offset: 3px; }
  .product-details .button,
  .product-details button[type='submit'],
  .product-details .quantity-selector,
  .product-details .variant-option__button-label { border-radius: 0 !important; }
  .shopify-section[id*='product_recommendations'] .text-block { margin-inline: auto; text-align: center; }
  .shopify-section[id*='product_recommendations'] .text-block > * { font-family: 'OBM Garamond', 'EB Garamond', Georgia, serif; font-style: italic; font-weight: 400; font-size: 26px; letter-spacing: 0; }
  @media screen and (min-width: 750px) { .shopify-section[id*='product_recommendations'] .text-block > * { font-size: 34px; } }
  /* Desktop header as on Bottega Veneta: the menu centred on the page between logo and icons. */
  @media screen and (min-width: 990px) {
    .header__row--top .header__column--center { justify-content: center !important; }
    .header__row--top .header__column--center .header-menu, .header__row--top .header__column--center .menu-list { justify-content: center !important; width: 100%; }
    .header__row--top .header__column--center .menu-list__list, .header__row--top .header__column--center .menu-list > ul { justify-content: center !important; margin-inline: auto !important; }
  }
  /* Phone header as on Bottega Veneta: the logo at the left, then search, account, bag and the menu
     icon at the far right (Horizon puts the menu and search at the left and centres the logo). */
  @media screen and (max-width: 989px) {
    .header__row--top .header__columns { grid-template-columns: minmax(0, 1fr) auto auto auto !important; grid-template-areas: "obmlogo obmsearch obmactions obmdrawer" !important; column-gap: 0 !important; }
    .header__row--top .header__columns .header-logo { grid-area: obmlogo !important; justify-self: start !important; margin: 0 !important; }
    .header__row--top .header__columns search-button.search-action--hidden-on-menu { grid-area: obmsearch !important; }
    .header__row--top .header__columns header-actions { grid-area: obmactions !important; }
    .header__row--top .header__columns .header__drawer { grid-area: obmdrawer !important; justify-self: end; }
  }
{% endstylesheet %}
{% schema %}
{ "name": "Site style (2026)", "settings": [], "presets": [ { "name": "Site style (2026)" } ] }
{% endschema %}
