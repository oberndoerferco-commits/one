{% comment %}
  Oberndoerfer Milano - "Our services" (REDESIGN 2026). Bottega Veneta closes its home page with service
  photographs, a centred label under each. Checked on bottegaveneta.com/it-it, 4 October: on a phone four
  pictures two by two (Appuntamento in negozio, Personalizzazione, Certificate of Craft, Store locator),
  labels in plain sentence case; on a desktop the first three in a row, labels in spaced capitals, the
  fourth hidden. "Pictures on a desktop" sets how many show there (3 as Bottega, or 4).
{% endcomment %}
<section class="obm-services">
  {%- if section.settings.heading != blank -%}<h2 class="obm-services__heading">{{ section.settings.heading }}</h2>{%- endif -%}
  {%- assign desk = section.settings.desktop_count | plus: 0 | at_most: section.blocks.size -%}
  <div class="obm-services__grid obm-services__grid--d{{ desk }}" style="--obm-services-cols: {{ desk }};">
    {%- for block in section.blocks -%}
      <a class="obm-services__item" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 750px) 30vw, 40vw', class: 'obm-services__img' }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'obm-services__img' }}
        {%- endif -%}
        <span class="obm-services__label">{{ block.settings.label }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>
{% stylesheet %}
  /* Bottega Veneta's "I nostri servizi": a centred uppercase heading, still lifes of one tone. Phone: two
     by two, generous side margins, the label in sentence case under each. Desktop: one row, the label in
     spaced capitals well below the picture. */
  .obm-services { background: #fff; padding: 64px 0 72px; display: flex; flex-direction: column; align-items: center; }
  @media screen and (min-width: 750px) { .obm-services { padding: 72px 9% 48px; } }
  .obm-services__heading { margin: 0; font-family: var(--font-body--family); font-size: 15px; font-weight: 400; letter-spacing: 0.08em; text-transform: uppercase; }
  .obm-services__grid { margin-top: 44px; width: 100%; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 8%; row-gap: 26px; padding: 0 16%; }
  @media screen and (min-width: 750px) {
    .obm-services__grid { margin-top: 64px; grid-template-columns: repeat(var(--obm-services-cols, 3), minmax(0, 1fr)); column-gap: 3%; row-gap: 40px; padding: 0 10%; }
    .obm-services__grid--d3 .obm-services__item:nth-child(n+4) { display: none; }
  }
  .obm-services__item { display: flex; flex-direction: column; align-items: center; gap: 0; text-align: center; color: #1c1714; text-decoration: none; }
  .obm-services__img { width: 100%; height: auto; aspect-ratio: 5 / 7; object-fit: cover; display: block; background: #efece7; }
  .obm-services__label { margin-top: 12px; font-size: 13px; line-height: 1.45; letter-spacing: 0.01em; }
  @media screen and (min-width: 750px) { .obm-services__label { margin-top: 56px; font-size: 14px; letter-spacing: 0.08em; text-transform: uppercase; } }
  .obm-services__item:hover .obm-services__label { text-decoration: underline; text-underline-offset: 4px; }
{% endstylesheet %}
{% schema %}
{
  "name": "Our services",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our services" },
    { "type": "select", "id": "desktop_count", "label": "Pictures on a desktop", "info": "Phones always show every picture, two by two. Bottega shows three on a desktop and four on a phone.", "options": [ { "value": "3", "label": "3 (the fourth on phones only)" }, { "value": "4", "label": "4" } ], "default": "3" }
  ],
  "blocks": [ { "type": "service", "name": "Service", "settings": [ { "type": "image_picker", "id": "image", "label": "Photograph" }, { "type": "text", "id": "label", "label": "Label" }, { "type": "url", "id": "link", "label": "Link" } ] } ],
  "max_blocks": 8,
  "presets": [ { "name": "Our services", "blocks": [ { "type": "service" }, { "type": "service" }, { "type": "service" }, { "type": "service" } ] } ]
}
{% endschema %}
