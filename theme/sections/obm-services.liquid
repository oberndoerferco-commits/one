{% comment %}
  Oberndoerfer Milano - "Our services" (REDESIGN 2026). Bottega Veneta closes its home page with four
  service photographs, a centred label under each: two by two on a phone, four in a row on a desktop.
{% endcomment %}
<section class="obm-services">
  {%- if section.settings.heading != blank -%}<h2 class="obm-services__heading">{{ section.settings.heading }}</h2>{%- endif -%}
  <div class="obm-services__grid" style="--obm-services-cols: {{ section.blocks.size | at_most: 4 }};">
    {%- for block in section.blocks -%}
      <a class="obm-services__item" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 750px) 30vw, 78vw', class: 'obm-services__img' }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'obm-services__img' }}
        {%- endif -%}
        <span class="obm-services__label">{{ block.settings.label }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>
{% stylesheet %}
  /* Bottega Veneta's "I nostri servizi": a centred uppercase heading, still lifes of one tone in a row
     with the label underneath in spaced capitals; on a phone the row scrolls sideways. */
  .obm-services { background: #fff; padding: 64px 0 32px; display: flex; flex-direction: column; align-items: center; }
  @media screen and (min-width: 750px) { .obm-services { padding: 72px 9% 48px; } }
  .obm-services__heading { margin: 0; font-family: var(--font-body--family); font-size: 15px; font-weight: 400; letter-spacing: 0.08em; text-transform: uppercase; }
  .obm-services__grid { margin-top: 40px; width: 100%; display: grid; grid-auto-flow: column; grid-auto-columns: 78%; gap: 6px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 0 16px; scrollbar-width: none; }
  .obm-services__grid::-webkit-scrollbar { display: none; }
  @media screen and (min-width: 750px) { .obm-services__grid { margin-top: 64px; grid-auto-flow: row; grid-template-columns: repeat(var(--obm-services-cols, 3), minmax(0, 1fr)); grid-auto-columns: auto; overflow: visible; padding: 0; } }
  .obm-services__item { display: flex; flex-direction: column; align-items: center; gap: 0; text-align: center; color: #1c1714; text-decoration: none; scroll-snap-align: center; }
  .obm-services__img { width: 100%; height: auto; aspect-ratio: 5 / 7; object-fit: cover; display: block; background: #efece7; }
  .obm-services__label { margin-top: 28px; font-size: 14px; line-height: 1.4; letter-spacing: 0.08em; text-transform: uppercase; }
  @media screen and (min-width: 750px) { .obm-services__label { margin-top: 56px; } }
  .obm-services__item:hover .obm-services__label { text-decoration: underline; text-underline-offset: 4px; }
{% endstylesheet %}
{% schema %}
{
  "name": "Our services",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Our services" } ],
  "blocks": [ { "type": "service", "name": "Service", "settings": [ { "type": "image_picker", "id": "image", "label": "Photograph" }, { "type": "text", "id": "label", "label": "Label" }, { "type": "url", "id": "link", "label": "Link" } ] } ],
  "max_blocks": 8,
  "presets": [ { "name": "Our services", "blocks": [ { "type": "service" }, { "type": "service" }, { "type": "service" }, { "type": "service" } ] } ]
}
{% endschema %}
