{% comment %}
  Oberndoerfer Milano - "Our services" (REDESIGN 2026). Bottega Veneta closes its home page with four
  service photographs, a centred label under each: two by two on a phone, four in a row on a desktop.
{% endcomment %}
<section class="obm-services">
  {%- if section.settings.heading != blank -%}<h2 class="obm-services__heading">{{ section.settings.heading }}</h2>{%- endif -%}
  <div class="obm-services__grid">
    {%- for block in section.blocks -%}
      <a class="obm-services__item" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 750px) 25vw, 45vw', class: 'obm-services__img' }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'obm-services__img' }}
        {%- endif -%}
        <span class="obm-services__label">{{ block.settings.label }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>
{% stylesheet %}
  .obm-services { background: #fff; padding: 56px 32px 24px; display: flex; flex-direction: column; align-items: center; }
  @media screen and (min-width: 750px) { .obm-services { padding: 80px 120px 40px; } }
  .obm-services__heading { margin: 0; font-family: var(--font-body--family); font-size: 15px; font-weight: 400; letter-spacing: 0.08em; text-transform: uppercase; }
  .obm-services__grid { margin-top: 32px; width: 100%; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 18px; row-gap: 30px; }
  @media screen and (min-width: 750px) { .obm-services__grid { margin-top: 40px; grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: 28px; } }
  .obm-services__item { display: flex; flex-direction: column; align-items: center; gap: 12px; text-align: center; color: #1c1714; text-decoration: none; }
  .obm-services__img { width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; display: block; background: #F2EFEA; }
  .obm-services__label { font-size: 14px; line-height: 1.4; }
  .obm-services__item:hover .obm-services__label { text-decoration: underline; text-underline-offset: 3px; }
{% endstylesheet %}
{% schema %}
{
  "name": "Our services",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Our services" } ],
  "blocks": [ { "type": "service", "name": "Service", "settings": [ { "type": "image_picker", "id": "image", "label": "Photograph" }, { "type": "text", "id": "label", "label": "Label" }, { "type": "url", "id": "link", "label": "Link" } ] } ],
  "max_blocks": 8,
  "presets": [ { "name": "Our services", "blocks": [ { "type": "service" }, { "type": "service" }, { "type": "service" }, { "type": "service" } ] } ]
}
{% endschema %}
