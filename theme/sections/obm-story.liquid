{% comment %}
  Oberndoerfer Milano - story page (REDESIGN 2026, 9 October). One section for About us, Art of Living and
  Leather care, built from the mockup the owner chose: a full-width photograph, a centred eyebrow, title and
  short text, then any of: three small photographs with a line each, a pair of photographs, a row of products,
  plain rules (title and one or two lines), folded questions, underlined links and a button. Every part is a
  block, so the order and the words can be changed in the theme editor.
{% endcomment %}
<div class="obm-story">
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'hero' -%}
        {%- if block.settings.image != blank -%}
          {%- assign pos = 'object-position: ' | append: block.settings.focal_x | append: '% ' | append: block.settings.focal_y | append: '%;' -%}
          <div class="obm-story__hero obm-story__hero--{{ block.settings.height }}" {{ block.shopify_attributes }}>
            {{ block.settings.image | image_url: width: 2400, format: 'pjpg' | image_tag:
              widths: '600, 900, 1200, 1600, 2000, 2400',
              sizes: '100vw',
              loading: 'eager',
              fetchpriority: 'high',
              style: pos,
              alt: block.settings.image.alt
            }}
          </div>
        {%- endif -%}

      {%- when 'intro' -%}
        <div class="obm-story__intro" {{ block.shopify_attributes }}>
          {%- if block.settings.eyebrow != blank -%}<p class="obm-story__eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
          {%- if block.settings.title != blank -%}<h1 class="obm-story__title">{{ block.settings.title }}</h1>{%- endif -%}
          {%- if block.settings.text != blank -%}<div class="obm-story__text">{{ block.settings.text }}</div>{%- endif -%}
        </div>

      {%- when 'pillar' -%}
        <div class="obm-story__pillar" {{ block.shopify_attributes }}>
          <div class="obm-story__pillar-img">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: widths: '200, 300, 400, 600', sizes: '(min-width: 750px) 200px, 120px', loading: 'lazy', alt: block.settings.image.alt }}
            {%- endif -%}
          </div>
          <div class="obm-story__pillar-copy">
            <h2 class="obm-story__pillar-title">{{ block.settings.title }}</h2>
            <p>{{ block.settings.text }}</p>
          </div>
        </div>

      {%- when 'pair' -%}
        <div class="obm-story__pair" {{ block.shopify_attributes }}>
          {%- for i in (1..2) -%}
            {%- liquid
              assign key = 'image_' | append: i
              assign img = block.settings[key]
            -%}
            <div class="obm-story__pair-img">
              {%- if img != blank -%}
                {{ img | image_url: width: 1400 | image_tag: widths: '400, 600, 900, 1200, 1400', sizes: '50vw', loading: 'lazy', alt: img.alt }}
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

      {%- when 'products' -%}
        <div class="obm-story__products" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}<h2 class="obm-story__subhead">{{ block.settings.heading }}</h2>{%- endif -%}
          <div class="obm-story__product-row">
            {%- for i in (1..3) -%}
              {%- liquid
                assign key = 'product_' | append: i
                assign p = block.settings[key]
              -%}
              {%- if p != blank -%}
                <a class="obm-story__product" href="{{ p.url }}">
                  <span class="obm-story__product-img">
                    {%- if p.featured_image -%}
                      {%- assign palt = p.featured_image.alt | default: p.title -%}
                      {{ p.featured_image | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: '(min-width: 750px) 260px, 33vw', loading: 'lazy', alt: palt }}
                    {%- endif -%}
                  </span>
                  <span class="obm-story__product-name">{{ p.title }}</span>
                  <span class="obm-story__product-price">{{ p.price | money }}</span>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

      {%- when 'rule' -%}
        <div class="obm-story__rule" {{ block.shopify_attributes }}>
          <h2 class="obm-story__rule-title">{{ block.settings.title }}</h2>
          <p>{{ block.settings.text }}</p>
        </div>

      {%- when 'question' -%}
        <details class="obm-story__q" {{ block.shopify_attributes }}>
          <summary><span>{{ block.settings.question }}</span><span class="obm-story__plus" aria-hidden="true"></span></summary>
          <div class="obm-story__a">{{ block.settings.answer }}</div>
        </details>

      {%- when 'links' -%}
        <div class="obm-story__links" {{ block.shopify_attributes }}>
          {%- if block.settings.label_1 != blank -%}<a href="{{ block.settings.link_1 }}">{{ block.settings.label_1 }}</a>{%- endif -%}
          {%- if block.settings.label_2 != blank -%}<a href="{{ block.settings.link_2 }}">{{ block.settings.label_2 }}</a>{%- endif -%}
        </div>

      {%- when 'button' -%}
        <div class="obm-story__button-wrap" {{ block.shopify_attributes }}>
          <a class="obm-story__button{% if block.settings.style == 'dark' %} obm-story__button--dark{% endif %}" href="{{ block.settings.link }}">{{ block.settings.label }}</a>
        </div>

      {%- when 'space' -%}
        <div class="obm-story__space" style="height: {{ block.settings.height }}px" {{ block.shopify_attributes }}></div>
    {%- endcase -%}
  {%- endfor -%}
</div>

{% stylesheet %}
  .obm-story { padding-bottom: 64px; color: #1c1714; }
  .obm-story__hero { position: relative; width: 100%; height: 62svh; min-height: 380px; overflow: hidden; background: #eeede8; }
  .obm-story__hero--short { height: 46svh; min-height: 320px; }
  .obm-story__hero img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  @media screen and (min-width: 750px) {
    .obm-story__hero { height: calc(100svh - 72px); max-height: 900px; }
    .obm-story__hero--short { height: 62svh; max-height: 680px; }
  }
  .obm-story__intro { text-align: center; padding: 44px 24px 0; max-width: 640px; margin: 0 auto; }
  .obm-story__eyebrow { margin: 0; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: #6b625b; }
  .obm-story__title { margin: 12px 0 0; font-family: var(--obm-font-display); font-style: normal; font-weight: 400; font-size: 30px; line-height: 1.1; letter-spacing: 0; text-transform: uppercase; }
  @media screen and (min-width: 750px) { .obm-story__title { font-size: 40px; } .obm-story__intro { padding-top: 64px; } }
  .obm-story__text { margin: 18px auto 0; max-width: 40ch; font-size: 15px; line-height: 1.7; color: #3a322c; }
  .obm-story__text p { margin: 0 0 12px; }
  .obm-story__text p:last-child { margin-bottom: 0; }

  .obm-story__pillar { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 18px; align-items: center; max-width: 560px; margin: 0 auto; padding: 14px 24px; }
  .obm-story__intro + .obm-story__pillar { margin-top: 26px; }
  .obm-story__pillar-img { aspect-ratio: 1; overflow: hidden; background: #eeede8; }
  .obm-story__pillar-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .obm-story__pillar-title { margin: 0 0 6px; font-family: var(--obm-font-display); font-style: normal; font-weight: 700; font-size: 14px; letter-spacing: 0.06em; text-transform: uppercase; }
  .obm-story__pillar-copy p { margin: 0; font-size: 14px; line-height: 1.6; color: #3a322c; }
  @media screen and (min-width: 750px) { .obm-story__pillar { grid-template-columns: 180px minmax(0, 1fr); gap: 28px; } }

  .obm-story__pair { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; margin-top: 34px; }
  .obm-story__pair-img { aspect-ratio: 4 / 5; overflow: hidden; background: #eeede8; }
  .obm-story__pair-img img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .obm-story__products { max-width: 900px; margin: 44px auto 0; padding: 0 14px; }
  .obm-story__subhead { margin: 0 0 18px; text-align: center; font-family: var(--obm-font-display); font-style: normal; font-weight: 700; font-size: 16px; letter-spacing: 0.04em; text-transform: uppercase; }
  .obm-story__product-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  @media screen and (min-width: 750px) { .obm-story__product-row { gap: 24px; } }
  .obm-story__product { display: block; color: inherit; text-decoration: none; }
  .obm-story__product-img { display: block; aspect-ratio: 1; overflow: hidden; background: #eeede8; }
  .obm-story__product-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .6s ease; }
  .obm-story__product:hover .obm-story__product-img img { transform: scale(1.03); }
  .obm-story__product-name { display: block; margin-top: 8px; font-size: 11px; line-height: 1.4; letter-spacing: 0.06em; text-transform: uppercase; }
  .obm-story__product-price { display: block; margin-top: 2px; font-size: 11px; color: #6b625b; }

  .obm-story__rule { max-width: 560px; margin: 0 auto; padding: 20px 24px 0; }
  .obm-story__intro + .obm-story__rule { margin-top: 18px; }
  .obm-story__rule-title { margin: 0; font-family: var(--obm-font-display); font-style: normal; font-weight: 700; font-size: 14px; letter-spacing: 0.06em; text-transform: uppercase; }
  .obm-story__rule p { margin: 6px 0 0; font-size: 14px; line-height: 1.65; color: #3a322c; }

  .obm-story__q { max-width: 560px; margin: 0 auto; padding: 0 24px; }
  .obm-story__rule + .obm-story__q { margin-top: 34px; }
  .obm-story__q summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 15px 0; border-bottom: 1px solid #d9d3cb; font-size: 14px; line-height: 1.45; cursor: pointer; }
  .obm-story__rule + .obm-story__q summary, .obm-story__intro + .obm-story__q summary { border-top: 1px solid #1c1714; }
  .obm-story__q summary::-webkit-details-marker { display: none; }
  .obm-story__plus { position: relative; flex: none; width: 12px; height: 12px; }
  .obm-story__plus::before, .obm-story__plus::after { content: ''; position: absolute; left: 0; top: 5.5px; width: 12px; height: 1px; background: currentColor; transition: transform .25s ease; }
  .obm-story__plus::after { transform: rotate(90deg); }
  .obm-story__q[open] .obm-story__plus::after { transform: rotate(0deg); }
  .obm-story__a { padding: 4px 0 18px; border-bottom: 1px solid #d9d3cb; font-size: 14px; line-height: 1.7; color: #3a322c; }
  .obm-story__a p { margin: 0 0 10px; }

  .obm-story__links { display: flex; flex-direction: column; align-items: center; gap: 14px; margin-top: 34px; }
  .obm-story__links a { color: inherit; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 1px; }
  .obm-story__button-wrap { text-align: center; margin-top: 34px; padding: 0 24px; }
  .obm-story__button { display: inline-block; min-width: 230px; padding: 13px 22px; border: 1px solid #1c1714; color: #1c1714; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; text-decoration: none; transition: background-color .25s ease, color .25s ease; }
  .obm-story__button:hover, .obm-story__button--dark { background: #1c1714; color: #fff; }
  .obm-story__button--dark:hover { background: transparent; color: #1c1714; }
  @media (prefers-reduced-motion: reduce) { .obm-story__product-img img, .obm-story__plus::after, .obm-story__button { transition: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Story page (2026)",
  "blocks": [
    { "type": "hero", "name": "Photograph", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "range", "id": "focal_x", "label": "Focus left–right", "min": 0, "max": 100, "step": 5, "default": 50, "unit": "%" },
      { "type": "range", "id": "focal_y", "label": "Focus top–bottom", "min": 0, "max": 100, "step": 5, "default": 50, "unit": "%" },
      { "type": "select", "id": "height", "label": "Height", "default": "tall", "options": [ { "value": "tall", "label": "Tall" }, { "value": "short", "label": "Short" } ] }
    ] },
    { "type": "intro", "name": "Title and text", "settings": [
      { "type": "text", "id": "eyebrow", "label": "Small line above" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "richtext", "id": "text", "label": "Text" }
    ] },
    { "type": "pillar", "name": "Small photo and line", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ] },
    { "type": "pair", "name": "Two photographs", "settings": [
      { "type": "image_picker", "id": "image_1", "label": "Left" },
      { "type": "image_picker", "id": "image_2", "label": "Right" }
    ] },
    { "type": "products", "name": "Products", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the pieces" },
      { "type": "product", "id": "product_1", "label": "Product 1" },
      { "type": "product", "id": "product_2", "label": "Product 2" },
      { "type": "product", "id": "product_3", "label": "Product 3" }
    ] },
    { "type": "rule", "name": "Rule", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ] },
    { "type": "question", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "richtext", "id": "answer", "label": "Answer" }
    ] },
    { "type": "links", "name": "Links", "settings": [
      { "type": "text", "id": "label_1", "label": "Label 1" },
      { "type": "url", "id": "link_1", "label": "Link 1" },
      { "type": "text", "id": "label_2", "label": "Label 2" },
      { "type": "url", "id": "link_2", "label": "Link 2" }
    ] },
    { "type": "button", "name": "Button", "settings": [
      { "type": "text", "id": "label", "label": "Label" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "select", "id": "style", "label": "Style", "default": "outline", "options": [ { "value": "outline", "label": "Outline" }, { "value": "dark", "label": "Dark" } ] }
    ] },
    { "type": "space", "name": "Space", "settings": [
      { "type": "range", "id": "height", "label": "Height", "min": 0, "max": 120, "step": 4, "default": 24, "unit": "px" }
    ] }
  ],
  "presets": [ { "name": "Story page (2026)" } ]
}
{% endschema %}
