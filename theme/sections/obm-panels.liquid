{% comment %}
  Oberndoerfer Milano - full-bleed photo panels (REDESIGN 2026, 4 October).
  The owner: "the homepage i like how bottega did it". Bottega Veneta's home page is a column of
  full-bleed photographs, each with one short uppercase line and one boxed button at the foot.
  One section holds one to three panels: on a phone they stack, on a desktop they sit side by side.
  A panel can carry a muted looping video (Bottega opens on a full-screen film); "Full screen" fills the
  window under the header.
{% endcomment %}
{%- liquid
  assign cols = section.settings.columns_desktop | default: 1
  assign ncols = cols | plus: 0
-%}
<section class="obm-panels obm-panels--{{ cols }} obm-panels--show-{{ section.settings.show_on | default: 'all' }}{% if section.settings.height_mode == 'screen' %} obm-panels--screen{% endif %}{% if section.settings.shape_mobile != blank and section.settings.shape_mobile != 'fixed' %} obm-panels--{{ section.settings.shape_mobile }}-m{% endif %}" style="--obm-h-desktop: {{ section.settings.height_desktop }}px; --obm-h-mobile: {{ section.settings.height_mobile }}px; --obm-gap-top: {{ section.settings.gap_top }}px; --obm-offset-desktop: {{ section.settings.offset_desktop | default: 0 }}px; --obm-offset-mobile: {{ section.settings.offset_mobile | default: 0 }}px;">
  {%- for block in section.blocks -%}
    <div class="obm-panel{% if block.settings.tone == 'dark' %} obm-panel--dark{% endif %}" {{ block.shopify_attributes }}>
      {%- if block.settings.link != blank -%}<a class="obm-panel__media" href="{{ block.settings.link }}" tabindex="-1" aria-hidden="true">{%- else -%}<div class="obm-panel__media">{%- endif -%}
        {%- assign vdesk = block.settings.video_url | strip -%}
        {%- assign vmob = block.settings.video_url_mobile | strip | default: vdesk -%}
        {%- if block.settings.video != blank -%}{%- assign vsrc = block.settings.video.sources | where: 'mime_type', 'video/mp4' | sort: 'width' | last -%}{%- assign vdesk = vsrc.url -%}{%- if block.settings.video_url_mobile == blank -%}{%- assign vmob = vdesk -%}{%- endif -%}{%- endif -%}
        {%- if vdesk != blank -%}
          {%- assign has_video = true -%}
          {%- assign poster = block.settings.image | image_url: width: 1920, format: 'pjpg' -%}
          {%- assign poster_m = block.settings.image_mobile | default: block.settings.image | image_url: width: 1400, format: 'pjpg' -%}
          <video class="obm-panel__video" muted autoplay loop playsinline preload="metadata" poster="{{ poster }}" data-src-desktop="{{ vdesk }}" data-src-mobile="{{ vmob }}" data-poster-mobile="{{ poster_m }}" aria-label="{{ block.settings.image.alt | default: block.settings.eyebrow | escape }}"></video>
        {%- elsif block.settings.image != blank -%}
          {%- assign mobile = block.settings.image_mobile | default: block.settings.image -%}
          <picture>
            {%- comment -%} Full-width heroes are served as progressive JPEG: the CDN's automatic WebP broke the dark
              wall of the mirror-bag hero into visible blocks on phones (owner, 8 October). {%- endcomment -%}
            {%- if ncols == 1 -%}
            <source media="(max-width: 749px), (max-width: 1100px) and (orientation: portrait)" srcset="{{ mobile | image_url: width: 900, format: 'pjpg' }} 900w, {{ mobile | image_url: width: 1400, format: 'pjpg' }} 1400w, {{ mobile | image_url: width: 1800, format: 'pjpg' }} 1800w" sizes="100vw">
            <img src="{{ block.settings.image | image_url: width: 1800, format: 'pjpg' }}" srcset="{{ block.settings.image | image_url: width: 1200, format: 'pjpg' }} 1200w, {{ block.settings.image | image_url: width: 1800, format: 'pjpg' }} 1800w, {{ block.settings.image | image_url: width: 2600, format: 'pjpg' }} 2600w"
            {%- else -%}
            <source media="(max-width: 749px)" srcset="{{ mobile | image_url: width: 900 }} 900w, {{ mobile | image_url: width: 1400 }} 1400w" sizes="100vw">
            <img src="{{ block.settings.image | image_url: width: 1800 }}" srcset="{{ block.settings.image | image_url: width: 1200 }} 1200w, {{ block.settings.image | image_url: width: 1800 }} 1800w, {{ block.settings.image | image_url: width: 2600 }} 2600w"
            {%- endif %} sizes="{% if ncols == 2 %}50vw{% else %}100vw{% endif %}" alt="{{ block.settings.image.alt | escape }}" loading="{% if section.index <= 2 %}eager{% else %}lazy{% endif %}" style="object-position: {{ block.settings.focal_x }}% {{ block.settings.focal_y }}%;">
          </picture>
        {%- else -%}
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'obm-panel__placeholder' }}
        {%- endif -%}
      {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
      <div class="obm-panel__foot">
        {%- if block.settings.eyebrow != blank -%}<p class="obm-panel__eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
        {%- if block.settings.label != blank or block.settings.label_2 != blank -%}
          <div class="obm-panel__buttons">
            {%- if block.settings.label != blank -%}<a class="obm-panel__button" href="{{ block.settings.link | default: '#' }}">{{ block.settings.label }}</a>{%- endif -%}
            {%- if block.settings.label_2 != blank -%}<a class="obm-panel__button" href="{{ block.settings.link_2 | default: '#' }}">{{ block.settings.label_2 }}</a>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}
</section>
{%- if has_video -%}
<script>
  (function () {
    var root = document.currentScript.previousElementSibling;
    var vids = root ? root.querySelectorAll('.obm-panel__video') : [];
    var mobile = window.matchMedia('(max-width: 749px)').matches;
    var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    vids.forEach(function (v) {
      if (mobile && v.dataset.posterMobile) v.poster = v.dataset.posterMobile;
      if (still) return;
      v.src = mobile ? v.dataset.srcMobile : v.dataset.srcDesktop;
      var p = v.play(); if (p && p.catch) p.catch(function () {});
    });
  })();
</script>
{%- endif -%}

{% stylesheet %}
  .obm-panels { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; margin-top: var(--obm-gap-top, 12px); background: #fff; }
  @media screen and (min-width: 750px) { .obm-panels { gap: 16px; } }
  .obm-panel__buttons { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 16px; pointer-events: none; }
  @media screen and (min-width: 750px) { .obm-panels--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); } .obm-panels--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media screen and (max-width: 749px) { .obm-panels--show-desktop { display: none; } }
  @media screen and (min-width: 750px) { .obm-panels--show-mobile { display: none; } }
  .obm-panel { position: relative; overflow: hidden; height: var(--obm-h-mobile, 620px); background: #F2EFEA; }
  @media screen and (min-width: 750px) { .obm-panel { height: var(--obm-h-desktop, 820px); } }
  /* Phone shapes measured on Bottega's phone home (360, 390 and 430px wide): the two middle pictures are
     square, the tall one 9:16, whatever the phone. */
  @media screen and (max-width: 749px) { .obm-panels--square-m .obm-panel { height: auto; aspect-ratio: 1 / 1; } .obm-panels--tall-m .obm-panel { height: auto; aspect-ratio: 9 / 16; } }
  .obm-panels--screen .obm-panel { height: calc(100svh - var(--obm-offset-mobile, 0px)); min-height: 520px; }
  @media screen and (min-width: 750px) { .obm-panels--screen .obm-panel { height: calc(100svh - var(--obm-offset-desktop, 0px)); min-height: 600px; } }
  .obm-panel__media, .obm-panel__media picture { position: absolute; inset: 0; display: block; }
  .obm-panel__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .obm-panel__media img, .obm-panel__placeholder { width: 100%; height: 100%; object-fit: cover; display: block; }
  .obm-panel::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 45%; background: linear-gradient(to top, rgba(20, 16, 14, 0.38), rgba(20, 16, 14, 0)); pointer-events: none; }
  .obm-panel--dark::after { display: none; }
  .obm-panel--dark .obm-panel__eyebrow { color: #1c1714; text-shadow: none; }
  .obm-panel__foot { z-index: 1; position: absolute; left: 0; right: 0; bottom: 40px; display: flex; flex-direction: column; align-items: center; gap: 14px; padding-inline: 16px; pointer-events: none; }
  @media screen and (min-width: 750px) { .obm-panel__foot { bottom: 56px; gap: 16px; } }
  .obm-panel__eyebrow { margin: 0; max-width: 34ch; line-height: 1.5; text-wrap: balance; color: #fff; font-size: 15px; letter-spacing: 0.08em; text-transform: uppercase; text-align: center; text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35); }
  @media screen and (min-width: 750px) { .obm-panel__eyebrow { max-width: 72ch; } }
  .obm-panel__button { pointer-events: auto; display: block; box-sizing: border-box; width: 196px; max-width: 100%; padding: 12px 16px; background: #fff; color: #1c1714; border: 1px solid #1c1714; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; text-align: center; text-decoration: none; transition: background-color .25s ease, color .25s ease; }
  @media screen and (min-width: 750px) { .obm-panel__button { width: 290px; padding: 17px 20px; font-size: 14px; } }
  .obm-panel__button:hover, .obm-panel__button:focus-visible { background: #1c1714; color: #fff; }
{% endstylesheet %}

{% schema %}
{
  "name": "Photo panels",
  "class": "obm-panels-section",
  "settings": [
    { "type": "select", "id": "columns_desktop", "label": "Panels side by side on desktop", "options": [ { "value": "1", "label": "One" }, { "value": "2", "label": "Two" }, { "value": "3", "label": "Three" } ], "default": "1" },
    { "type": "select", "id": "height_mode", "label": "Height", "options": [ { "value": "fixed", "label": "Fixed (below)" }, { "value": "screen", "label": "Full screen" } ], "default": "fixed" },
    { "type": "range", "id": "offset_desktop", "label": "Full screen: header height to leave on desktop", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "offset_mobile", "label": "Full screen: header height to leave on phone", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "height_desktop", "label": "Height on desktop", "min": 400, "max": 1100, "step": 20, "unit": "px", "default": 820 },
    { "type": "range", "id": "height_mobile", "label": "Height on phone", "min": 360, "max": 900, "step": 20, "unit": "px", "default": 620 },
    { "type": "select", "id": "shape_mobile", "label": "Shape on phone", "info": "Square and tall (9:16) follow the phone's width, as on Bottega; they override the phone height.", "options": [ { "value": "fixed", "label": "Phone height (above)" }, { "value": "square", "label": "Square" }, { "value": "tall", "label": "Tall (9:16)" } ], "default": "fixed" },
    { "type": "select", "id": "show_on", "label": "Show on", "options": [ { "value": "all", "label": "Phone and desktop" }, { "value": "desktop", "label": "Desktop only" }, { "value": "mobile", "label": "Phone only" } ], "default": "all" },
    { "type": "range", "id": "gap_top", "label": "Space above", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 12 }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Panel",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photograph" },
        { "type": "image_picker", "id": "image_mobile", "label": "Photograph on phone (optional)" },
        { "type": "video", "id": "video", "label": "Video (plays muted in a loop; the photograph is its poster)" },
        { "type": "text", "id": "video_url", "label": "Or video address (.mp4)" },
        { "type": "text", "id": "video_url_mobile", "label": "Video address on phone (.mp4, optional)" },
        { "type": "range", "id": "focal_x", "label": "Focus left to right", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
        { "type": "range", "id": "focal_y", "label": "Focus top to bottom", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
        { "type": "select", "id": "tone", "label": "Text colour", "options": [ { "value": "light", "label": "White, for dark photographs" }, { "value": "dark", "label": "Ink, for light photographs" } ], "default": "light" },
        { "type": "text", "id": "eyebrow", "label": "Line above the button" },
        { "type": "text", "id": "label", "label": "Button", "default": "Discover" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "label_2", "label": "Second button (optional)" },
        { "type": "url", "id": "link_2", "label": "Second link" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [ { "name": "Photo panels", "blocks": [ { "type": "panel" } ] } ]
}
{% endschema %}
