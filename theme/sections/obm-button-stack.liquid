{% comment %}
  Oberndoerfer Milano - outlined buttons on white (REDESIGN 2026). Bottega Veneta follows its photographs
  with a short stack of outlined rectangular buttons; on a desktop they sit in a row.
{% endcomment %}
<div class="obm-buttons" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  {%- for block in section.blocks -%}
    <a class="obm-buttons__item" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
  {%- endfor -%}
</div>
{% stylesheet %}
  .obm-buttons { display: flex; flex-direction: column; align-items: center; gap: 12px; background: #fff; padding-inline: 16px; }
  @media screen and (min-width: 750px) { .obm-buttons { flex-direction: row; justify-content: center; gap: 16px; } }
  .obm-buttons__item { display: block; box-sizing: border-box; width: 248px; max-width: 100%; padding: 16px 20px; border: 1px solid #1c1714; color: #1c1714; background: #fff; font-size: 14px; letter-spacing: 0.08em; text-transform: uppercase; text-align: center; text-decoration: none; transition: background-color .25s ease, color .25s ease; }
  @media screen and (min-width: 750px) { .obm-buttons__item { width: 290px; padding: 17px 20px; } }
  .obm-buttons__item:hover, .obm-buttons__item:focus-visible { background: #1c1714; color: #fff; }
{% endstylesheet %}
{% schema %}
{
  "name": "Button stack",
  "settings": [
    { "type": "range", "id": "padding_top", "label": "Space above", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 44 },
    { "type": "range", "id": "padding_bottom", "label": "Space below", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 8 }
  ],
  "blocks": [ { "type": "button", "name": "Button", "settings": [ { "type": "text", "id": "label", "label": "Label", "default": "Discover" }, { "type": "url", "id": "link", "label": "Link" } ] } ],
  "max_blocks": 6,
  "presets": [ { "name": "Button stack", "blocks": [ { "type": "button" }, { "type": "button" } ] } ]
}
{% endschema %}
