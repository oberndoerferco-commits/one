{% comment %}
  Oberndoerfer Milano - collaboration lookbook (REDESIGN 2026). The owner, 7 October, with Gallery
  Dept.'s "OTW by Vans x Gallery Dept." page: "I love how they show their collaboration pages ... apply
  the same to my collaboration". As there: the name centred in a plain sans, a short paragraph in
  Courier, then chapters, each a bold heading over the pieces in Courier capitals (each a link to its
  product), followed by photographs: one full-width landscape, the rest centred (narrow for square photos, wider for landscape ones) with a lot of
  white around them. No grid of product cards; the piece names are the way to the products.
{% endcomment %}
<section class="obm-lookbook" aria-label="{{ section.settings.title | escape }}">
  <header class="obm-lookbook__head">
    <h1 class="obm-lookbook__title">{{ section.settings.title }}</h1>
    {%- if section.settings.text != blank -%}<div class="obm-lookbook__text">{{ section.settings.text }}</div>{%- endif -%}
  </header>

  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'chapter' -%}
        <div class="obm-lookbook__chapter" {{ block.shopify_attributes }}>
          <h2 class="obm-lookbook__chapter-title">{{ block.settings.title }}</h2>
          <ul class="obm-lookbook__pieces">
            {%- for i in (1..4) -%}
              {%- assign key = 'piece_' | append: i -%}
              {%- assign lkey = 'piece_link_' | append: i -%}
              {%- if block.settings[key] != blank -%}
                <li>{%- if block.settings[lkey] != blank -%}<a href="{{ block.settings[lkey] }}">{{ block.settings[key] }}</a>{%- else -%}{{ block.settings[key] }}{%- endif -%}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- when 'photo' -%}
        {%- if block.settings.image != blank -%}
          {%- liquid
            if block.settings.layout == 'full'
              assign sizes = '(min-width: 750px) 96vw, 96vw'
            elsif block.settings.layout == 'wide'
              assign sizes = '(min-width: 750px) 58vw, 84vw'
            else
              assign sizes = '(min-width: 750px) 40vw, 56vw'
            endif
          -%}
          <figure class="obm-lookbook__photo obm-lookbook__photo--{{ block.settings.layout }}" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
            {{ block.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1800, 2400', sizes: sizes, alt: block.settings.image.alt | default: section.settings.title, style: block.settings.image.presentation.focal_point }}
            {%- if block.settings.link != blank -%}</a>{%- endif -%}
          </figure>
        {%- endif -%}
    {%- endcase -%}
  {%- endfor -%}
</section>

{% stylesheet %}
  .obm-lookbook { padding: 48px 16px 120px; color: #1c1714; text-align: center; }
  .obm-lookbook__head { max-width: 560px; margin: 0 auto; }
  .obm-lookbook__title { margin: 0; font-family: var(--obm-font-display, Helvetica, Arial, sans-serif); font-weight: 400; font-size: 22px; line-height: 1.2; letter-spacing: 0; text-transform: uppercase; }
  .obm-lookbook__text { margin-top: 24px; font-family: var(--obm-font-text, 'Courier New', Courier, monospace); font-size: 12.5px; line-height: 1.55; }
  .obm-lookbook__text p { margin: 0; }
  .obm-lookbook__chapter { margin: 120px auto 32px; }
  .obm-lookbook__chapter-title { margin: 0; font-family: var(--obm-font-display, Helvetica, Arial, sans-serif); font-weight: 700; font-size: 20px; line-height: 1.2; letter-spacing: 0; text-transform: uppercase; }
  .obm-lookbook__pieces { list-style: none; margin: 18px 0 0; padding: 0; font-family: var(--obm-font-text, 'Courier New', Courier, monospace); font-size: 12.5px; line-height: 1.7; text-transform: uppercase; }
  .obm-lookbook__pieces a { color: inherit; text-decoration: none; }
  .obm-lookbook__pieces a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .obm-lookbook__photo { margin: 0 auto; }
  .obm-lookbook__photo + .obm-lookbook__photo { margin-top: 48px; }
  .obm-lookbook__photo a { display: block; }
  .obm-lookbook__photo img { display: block; width: 100%; height: auto; }
  .obm-lookbook__photo--full { width: 100%; }
  .obm-lookbook__photo--centre { width: 56%; }
  .obm-lookbook__photo--wide { width: 84%; }
  @media screen and (min-width: 750px) {
    .obm-lookbook { padding: 64px 3.5% 200px; }
    .obm-lookbook__title { font-size: 34px; }
    .obm-lookbook__text { margin-top: 32px; font-size: 12.5px; }
    .obm-lookbook__chapter { margin: 200px auto 40px; }
    .obm-lookbook__photo + .obm-lookbook__photo { margin-top: 136px; }
    .obm-lookbook__photo--centre { width: 39%; max-width: 560px; }
    .obm-lookbook__photo--wide { width: 58%; max-width: 900px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collaboration lookbook",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Oberndörfer × Trax NYC" },
    { "type": "richtext", "id": "text", "label": "Text" }
  ],
  "blocks": [
    {
      "type": "chapter", "name": "Chapter",
      "settings": [
        { "type": "text", "id": "title", "label": "Heading" },
        { "type": "text", "id": "piece_1", "label": "Piece 1" }, { "type": "url", "id": "piece_link_1", "label": "Piece 1 link" },
        { "type": "text", "id": "piece_2", "label": "Piece 2" }, { "type": "url", "id": "piece_link_2", "label": "Piece 2 link" },
        { "type": "text", "id": "piece_3", "label": "Piece 3" }, { "type": "url", "id": "piece_link_3", "label": "Piece 3 link" },
        { "type": "text", "id": "piece_4", "label": "Piece 4" }, { "type": "url", "id": "piece_link_4", "label": "Piece 4 link" }
      ]
    },
    {
      "type": "photo", "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "layout", "label": "Layout", "options": [ { "value": "full", "label": "Full width" }, { "value": "wide", "label": "Centred, wide (for landscape photos)" }, { "value": "centre", "label": "Centred, narrow" } ], "default": "centre" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [ { "name": "Collaboration lookbook" } ]
}
{% endschema %}
