# Copy to .env for local development. In Cloudflare Pages set these as environment variables.
# Newsletter form action URL from your provider (Buttondown / MailerLite / Brevo).
PUBLIC_NEWSLETTER_ACTION=
# Supabase project (EU region). Both values are public by design; security is in row-level rules.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Cookie-free analytics (Cloudflare Web Analytics). Leave unset to load nothing.
PUBLIC_CF_ANALYTICS_TOKEN=
