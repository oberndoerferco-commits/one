---
import Base from '../../../layouts/Base.astro';
import AnimalsFilter from '../../../components/AnimalsFilter.astro';
import { ANIMALS } from '../../../lib/animals-i18n';
import { PROFILES } from '../../../data/species';
export async function getStaticPaths() {
  return [...Object.keys(ANIMALS.de.species), ...Object.keys(ANIMALS.de.categories)].map((filter) => ({ params: { filter } }));
}
const { filter } = Astro.params;
const profile = (PROFILES as any)[filter!];
const label = profile?.name.de ?? (ANIMALS.de.species as any)[filter!] ?? (ANIMALS.de.categories as any)[filter!]?.[0];
---
<Base title={label} description={profile ? profile.intro.de : `${label}: verständliche Artikel für Halter zu Symptomen, wann in die Praxis, Pflege und Vorbeugung, aus tierärztlichen Quellen. Jeder zeigt, ob er schon tierärztlich geprüft ist.`} lang="de">
  <AnimalsFilter lang="de" filter={filter!} />
</Base>
