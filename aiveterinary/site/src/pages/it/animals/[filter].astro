---
import Base from '../../../layouts/Base.astro';
import AnimalsFilter from '../../../components/AnimalsFilter.astro';
import AnimalPage from '../../../components/AnimalPage.astro';
import { animalPaths, animalPage } from '../../../lib/animal-data';
// /animals/<key>: species and topics (src/lib/animals-i18n.ts) plus every lexicon entry in this language.
export function getStaticPaths() {
  return animalPaths('it');
}
const { filter } = Astro.params;
const page = await animalPage('it', filter!);
---
<Base title={page.title} description={page.description} lang="it">
  {page.kind === 'animal' ? <AnimalPage lang="it" filter={filter!} /> : <AnimalsFilter lang="it" filter={filter!} />}
</Base>
