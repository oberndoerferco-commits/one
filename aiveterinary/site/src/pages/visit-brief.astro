---
import Base from '../layouts/Base.astro';
---
<Base title="Prepare for the vet visit" description="Answer a few questions about what is going on with your animal and get a one-page brief to bring to the vet. No diagnosis, just the information your vet will ask for.">
  <section class="wrap hero">
    <p class="eyebrow">For animal owners</p>
    <h1>Prepare for the vet visit</h1>
    <p class="lead">Vets ask the same questions at every visit: since when, how often, what changed, what does the animal eat, which medications. Answer them calmly at home and bring a one-page brief. The visit goes faster and nothing is forgotten.</p>
    <div class="notice"><p><strong>This is not a diagnosis.</strong> The brief organises what you know. It does not tell you what your animal has, and it does not replace calling your vet. If any of the emergency signs below apply, stop and call a clinic now.</p></div>
    <div class="notice danger"><p><strong>Go now, don't fill in forms:</strong> trouble breathing, collapse, uncontrolled bleeding, seizures, a hard swollen belly, suspected poisoning, a cat straining to urinate, a rabbit that hasn't eaten for 12 hours.</p></div>
  </section>

  <section class="wrap" id="vb-app">
    <form id="vb-form" class="card" autocomplete="off">
      <h2>About your animal</h2>
      <p class="pp-hint">If you keep a <a href="/passport">digital pet passport</a> on this device, pick the animal and these fields fill themselves.</p>
      <div class="pp-fields">
        <label>From passport<select id="vb-passport"><option value="">—</option></select></label>
        <label>Name<input name="name" /></label>
        <label>Species<select name="species"><option value="">—</option><option>Dog</option><option>Cat</option><option>Rabbit</option><option>Guinea pig</option><option>Horse</option><option>Bird</option><option>Other</option></select></label>
        <label>Breed<input name="breed" /></label>
        <label>Age<input name="age" placeholder="e.g. 6 years" /></label>
        <label>Sex<select name="sex"><option value="">—</option><option>Female</option><option>Male</option><option>Female, spayed</option><option>Male, neutered</option></select></label>
        <label>Weight (kg), if known<input name="weight" type="number" step="0.1" min="0" /></label>
      </div>

      <h2>What is going on</h2>
      <div class="pp-fields">
        <label class="wide">Main concern, in your own words<textarea name="concern" rows="3" placeholder="e.g. She has been vomiting since yesterday evening, three times, and doesn't want her food."></textarea></label>
        <label>Since when<input name="since" placeholder="e.g. yesterday evening / 3 days / 2 weeks" /></label>
        <label>How often / how bad<input name="frequency" placeholder="e.g. 3 times, getting worse" /></label>
        <label>Getting better, worse or the same?<select name="trend"><option value="">—</option><option>Better</option><option>Same</option><option>Worse</option><option>Comes and goes</option></select></label>
        <label>Anything that happened before it started<input name="trigger" placeholder="new food, walk in the woods, visitors, something eaten…" /></label>
      </div>

      <h2>Other things you have noticed</h2>
      <div class="vb-checks">
        {['Eating less', 'Not eating at all', 'Drinking more', 'Drinking less', 'Vomiting', 'Diarrhoea', 'Constipation', 'Straining to urinate', 'Urinating more', 'Coughing', 'Sneezing', 'Breathing differently', 'Limping', 'Scratching / itching', 'Lethargic, sleeping more', 'Restless, pacing', 'Hiding', 'Aggressive or unusual behaviour', 'Weight loss', 'Weight gain', 'Lump or swelling', 'Bad smell (mouth, ears, skin)'].map((s) => (
          <label><input type="checkbox" name="signs" value={s} /> {s}</label>
        ))}
      </div>
      <div class="pp-fields" style="margin-top:12px">
        <label class="wide">Anything else<input name="other" /></label>
      </div>

      <h2>Food, medication, history</h2>
      <div class="pp-fields">
        <label class="wide">What does your animal eat (brand, type, treats, scraps)?<input name="diet" /></label>
        <label class="wide">Current medications or supplements, exactly as on the label<textarea name="meds" rows="2" placeholder="name, strength, how often, since when"></textarea></label>
        <label class="wide">Known conditions, allergies, past surgeries<input name="history" /></label>
        <label>Vaccinations up to date?<select name="vacc"><option value="">—</option><option>Yes</option><option>No</option><option>Not sure</option></select></label>
        <label>Parasite treatment (flea/tick/worm) last given<input name="parasite" placeholder="e.g. 3 weeks ago, product name" /></label>
        <label>Indoor / outdoor / travel recently?<input name="lifestyle" /></label>
        <label>Other animals at home, are they well?<input name="others" /></label>
      </div>

      <h2>For the vet</h2>
      <div class="pp-fields">
        <label class="wide">Questions you want to ask<textarea name="questions" rows="2"></textarea></label>
        <label class="wide">Photos or videos you will show (note what and when)<input name="media" placeholder="e.g. video of the limp from this morning on my phone" /></label>
      </div>

      <div class="ws-actions" style="margin-top:20px">
        <button class="btn" type="button" id="vb-make">Make the brief</button>
        <button class="btn secondary" type="button" id="vb-clear">Clear</button>
      </div>
      <p class="pp-status" id="vb-status"></p>
    </form>

    <article id="vb-out" class="card vb-out" hidden>
      <div class="ws-actions" style="float:right">
        <button class="btn secondary" type="button" id="vb-copy">Copy</button>
        <button class="btn secondary" type="button" id="vb-print">Print / save as PDF</button>
      </div>
      <h2 style="margin-top:0">Veterinary visit brief</h2>
      <div id="vb-content" class="prose"></div>
      <p class="pp-hint" style="margin-top:16px">Prepared by the owner with aiveterinary.org. This is the owner's account, not a clinical record.</p>
    </article>
  </section>

  <style is:global>
    #vb-form h2 { font-size: 1.15rem; margin: 22px 0 8px; }
    #vb-form h2:first-child { margin-top: 0; }
    .pp-fields label.wide { grid-column: 1 / -1; }
    .vb-checks { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 6px 14px; }
    .vb-checks label { display: flex; gap: 8px; align-items: center; font-size: .95rem; }
    .vb-out { margin-top: 24px; }
    .vb-out dl { display: grid; grid-template-columns: max-content 1fr; gap: 6px 16px; margin: 0; }
    .vb-out dt { color: var(--ink-3); font-weight: 600; }
    .vb-out dd { margin: 0; }
    .vb-out h3 { margin: 18px 0 6px; font-size: 1rem; }
    @media print { .site-header, .site-footer, .hero, #vb-form, .vb-out .ws-actions, .pp-hint { display: none !important; } .vb-out { border: 0; } }
  </style>

  <script>
    const $ = (s: string) => document.querySelector(s) as HTMLElement;
    const form = $('#vb-form') as HTMLFormElement;
    const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

    // passport on this device → prefill
    try {
      const raw = localStorage.getItem('aiveterinary.passport.v1');
      const store = raw ? JSON.parse(raw) : null;
      const sel = $('#vb-passport') as HTMLSelectElement;
      if (store?.animals?.length) {
        for (const a of store.animals) { const o = document.createElement('option'); o.value = a.id; o.textContent = a.name || 'Unnamed'; sel.appendChild(o); }
        sel.addEventListener('change', () => {
          const a = store.animals.find((x: any) => x.id === sel.value); if (!a) return;
          const set = (n: string, v: string) => { const el = form.elements.namedItem(n) as HTMLInputElement | null; if (el && v) el.value = v; };
          set('name', a.name); set('species', a.species); set('breed', a.breed); set('weight', a.weight);
          set('sex', a.sex && a.neutered === 'Yes' ? `${a.sex}, ${a.sex === 'Female' ? 'spayed' : 'neutered'}` : a.sex);
          if (a.dob) { const y = (Date.now() - new Date(a.dob).getTime()) / 31557600000; set('age', y < 1 ? `${Math.round(y * 12)} months` : `${Math.floor(y)} years`); }
          set('meds', (a.medications ?? []).map((m: any) => [m.name, m.dose, m.started && `since ${m.started}`].filter(Boolean).join(', ')).join('\n'));
          set('history', (a.conditions ?? []).map((c: any) => [c.type, c.description].filter(Boolean).join(': ')).join('; '));
          const lastVac = (a.vaccinations ?? []).map((v: any) => v.validUntil).filter(Boolean).sort().pop();
          if (lastVac) set('vacc', new Date(lastVac) > new Date() ? 'Yes' : 'No');
          const lastPar = (a.treatments ?? []).map((t: any) => `${t.product ?? ''} ${t.date ?? ''}`.trim()).filter(Boolean).pop();
          if (lastPar) set('parasite', lastPar);
        });
      } else { (sel.closest('label') as HTMLElement).hidden = true; }
    } catch {}

    $('#vb-make').addEventListener('click', () => {
      const d = new FormData(form);
      const g = (n: string) => String(d.get(n) ?? '').trim();
      const signs = d.getAll('signs').map(String);
      const row = (k: string, v: string) => (v ? `<dt>${esc(k)}</dt><dd>${esc(v).replace(/\n/g, '<br>')}</dd>` : '');
      const animal = [g('name'), g('species'), g('breed'), g('sex'), g('age'), g('weight') && `${g('weight')} kg`].filter(Boolean).join(' · ');
      const html = `
        <p><strong>${esc(animal || 'Animal')}</strong> — ${new Date().toLocaleDateString()}</p>
        <h3>Main concern</h3>
        <p>${esc(g('concern')) || '<em>not described</em>'}</p>
        <dl>${row('Since', g('since'))}${row('How often / how bad', g('frequency'))}${row('Trend', g('trend'))}${row('Possible trigger', g('trigger'))}</dl>
        <h3>Other signs noticed</h3>
        <p>${signs.length ? esc(signs.join(', ')) : 'None ticked'}${g('other') ? '. ' + esc(g('other')) : ''}</p>
        <h3>Food, medication, history</h3>
        <dl>${row('Diet', g('diet'))}${row('Medications', g('meds'))}${row('Known conditions', g('history'))}${row('Vaccinations up to date', g('vacc'))}${row('Last parasite treatment', g('parasite'))}${row('Lifestyle', g('lifestyle'))}${row('Other animals', g('others'))}</dl>
        ${g('questions') ? `<h3>Questions for the vet</h3><p>${esc(g('questions')).replace(/\n/g, '<br>')}</p>` : ''}
        ${g('media') ? `<h3>Photos / videos to show</h3><p>${esc(g('media'))}</p>` : ''}`;
      $('#vb-content').innerHTML = html;
      ($('#vb-out') as HTMLElement).hidden = false;
      $('#vb-out').scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    $('#vb-clear').addEventListener('click', () => { form.reset(); ($('#vb-out') as HTMLElement).hidden = true; });
    $('#vb-print').addEventListener('click', () => window.print());
    $('#vb-copy').addEventListener('click', () => {
      const t = ($('#vb-content') as HTMLElement).innerText;
      navigator.clipboard?.writeText('Veterinary visit brief\n\n' + t).then(() => { $('#vb-status').textContent = 'Copied.'; });
    });
  </script>
</Base>
