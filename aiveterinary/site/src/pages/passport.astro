---
import Base from '../layouts/Base.astro';
---
<Base title="Digital pet passport" description="Keep your animal's identity, vaccinations, medications and vet contacts in one place, on your own device. Back it up, restore it anywhere, print it for the vet.">
  <section class="wrap hero" id="pp-intro">
    <p class="eyebrow">For animal owners</p>
    <h1>Digital pet passport</h1>
    <p class="lead">Everything about your animal in one place: identity, microchip, vaccinations, medications, allergies, your vet's number. Stored on your own device, not on our servers. Back it up to a file, open it on any device, print it before a visit.</p>
    <div class="notice"><p><strong>Private by design.</strong> Nothing you enter here leaves your browser. We never see it. That also means it is your copy: use <em>Back up</em> regularly and keep the file somewhere safe (your email, cloud drive or phone). This is a companion to, not a replacement for, the official EU pet passport issued by your vet.</p></div>
  </section>

  <section class="wrap" id="pp-app">
    <div class="pp-toolbar">
      <label class="sr" for="pp-select">Animal</label>
      <select id="pp-select" aria-label="Choose animal"></select>
      <button class="btn secondary" id="pp-new" type="button">+ New animal</button>
      <span class="pp-spacer"></span>
      <button class="btn secondary" id="pp-export" type="button">Back up</button>
      <label class="btn secondary" for="pp-import">Restore<input id="pp-import" type="file" accept="application/json,.json" class="sr" /></label>
      <button class="btn secondary" id="pp-print" type="button">Print</button>
      <button class="btn secondary pp-danger" id="pp-delete" type="button">Delete</button>
    </div>

    <div id="pp-empty" class="card" hidden>
      <h2>No animal yet</h2>
      <p>Create a passport for your first animal, or restore one from a backup file.</p>
      <button class="btn" id="pp-empty-new" type="button">Create passport</button>
    </div>

    <div id="pp-form" hidden>
      <div class="pp-grid">
        <section class="card">
          <h2>Identity</h2>
          <div class="pp-photo-row">
            <img id="pp-photo" alt="" hidden />
            <div>
              <label class="btn secondary" for="pp-photo-input">Add photo<input id="pp-photo-input" type="file" accept="image/*" class="sr" /></label>
              <button class="btn secondary" id="pp-photo-remove" type="button" hidden>Remove photo</button>
            </div>
          </div>
          <div class="pp-fields">
            <label>Name<input data-f="name" required /></label>
            <label>Species<select data-f="species"><option value="">—</option><option>Dog</option><option>Cat</option><option>Ferret</option><option>Rabbit</option><option>Guinea pig</option><option>Hamster</option><option>Horse</option><option>Bird</option><option>Reptile</option><option>Other</option></select></label>
            <label>Breed<input data-f="breed" /></label>
            <label>Sex<select data-f="sex"><option value="">—</option><option>Female</option><option>Male</option></select></label>
            <label>Neutered / spayed<select data-f="neutered"><option value="">—</option><option>Yes</option><option>No</option></select></label>
            <label>Date of birth<input data-f="dob" type="date" /></label>
            <label>Colour / markings<input data-f="colour" /></label>
            <label>Weight (kg)<input data-f="weight" type="number" step="0.1" min="0" /></label>
            <label>Microchip number<input data-f="microchip" inputmode="numeric" placeholder="15 digits" /></label>
            <label>Chip implanted on<input data-f="microchipDate" type="date" /></label>
            <label>Chip registered with<input data-f="microchipRegistry" placeholder="Registry name" /></label>
            <label>Passport / ID number<input data-f="passportNo" placeholder="Official EU pet passport number" /></label>
          </div>
        </section>

        <section class="card">
          <h2>Owner & vet</h2>
          <div class="pp-fields">
            <label>Owner name<input data-f="ownerName" /></label>
            <label>Owner phone<input data-f="ownerPhone" type="tel" /></label>
            <label>Owner email<input data-f="ownerEmail" type="email" /></label>
            <label>Address<input data-f="ownerAddress" /></label>
            <label>Veterinary clinic<input data-f="vetClinic" /></label>
            <label>Clinic phone<input data-f="vetPhone" type="tel" /></label>
            <label>Emergency clinic (after hours)<input data-f="emergencyClinic" /></label>
            <label>Emergency phone<input data-f="emergencyPhone" type="tel" /></label>
            <label>Insurance<input data-f="insurance" placeholder="Company and policy number" /></label>
          </div>
        </section>
      </div>

      <section class="card pp-list" data-list="vaccinations">
        <h2>Vaccinations</h2>
        <p class="pp-hint">Copy from the official passport or the clinic invoice. The "valid until" date is what border staff and kennels ask for.</p>
        <table><thead><tr><th>Vaccine</th><th>Date given</th><th>Valid until</th><th>Clinic / vet</th><th>Batch</th><th></th></tr></thead><tbody></tbody></table>
        <button class="btn secondary pp-add" type="button">+ Add vaccination</button>
      </section>

      <section class="card pp-list" data-list="treatments">
        <h2>Parasite treatments</h2>
        <p class="pp-hint">Worming, flea and tick products. Tapeworm treatment is required before entering some countries.</p>
        <table><thead><tr><th>Product</th><th>Date</th><th>Next due</th><th>Given by</th><th></th></tr></thead><tbody></tbody></table>
        <button class="btn secondary pp-add" type="button">+ Add treatment</button>
      </section>

      <section class="card pp-list" data-list="medications">
        <h2>Current medications</h2>
        <p class="pp-hint">Exactly as your vet wrote it. Never change a dose without asking the vet.</p>
        <table><thead><tr><th>Medication</th><th>Dose & how often</th><th>Started</th><th>Prescribed by</th><th></th></tr></thead><tbody></tbody></table>
        <button class="btn secondary pp-add" type="button">+ Add medication</button>
      </section>

      <section class="card pp-list" data-list="conditions">
        <h2>Allergies, conditions & surgeries</h2>
        <p class="pp-hint">Anything a new vet should know in the first minute: allergies, chronic conditions, past surgeries, reactions to drugs or anaesthesia.</p>
        <table><thead><tr><th>Type</th><th>Description</th><th>Since / date</th><th></th></tr></thead><tbody></tbody></table>
        <button class="btn secondary pp-add" type="button">+ Add entry</button>
      </section>

      <section class="card pp-list" data-list="visits">
        <h2>Vet visits</h2>
        <p class="pp-hint">A short line per visit keeps the history readable: reason, what was found, what was done.</p>
        <table><thead><tr><th>Date</th><th>Reason</th><th>Outcome / notes</th><th>Clinic</th><th></th></tr></thead><tbody></tbody></table>
        <button class="btn secondary pp-add" type="button">+ Add visit</button>
      </section>

      <section class="card">
        <h2>Notes</h2>
        <textarea data-f="notes" rows="4" placeholder="Diet, behaviour, things to tell a pet-sitter or a new vet…"></textarea>
      </section>

      <p class="pp-status" id="pp-status" aria-live="polite"></p>
    </div>
  </section>

  <section class="wrap narrow" id="pp-faq" style="margin-top:48px">
    <h2>Questions</h2>
    <h3>Where is the data?</h3>
    <p>In your browser's storage on this device. If you clear the browser data, use a private window, or switch phone, it is gone unless you have a backup file. Press <em>Back up</em> after every change that matters and keep the file in your email or a cloud drive. <em>Restore</em> loads it on any device.</p>
    <h3>Is this the official pet passport?</h3>
    <p>No. The official EU pet passport is a paper document issued by an authorised veterinarian and is what you need at borders. This is your own organised copy so you never have to search for a vaccination date or a microchip number again.</p>
    <h3>Will there be accounts and sharing with my vet?</h3>
    <p>That is the plan: an owner account, a secure link you can give your vet or a pet-sitter, and reminders when a vaccination is about to expire. We will only build it with proper data protection in place, which is why this first version keeps everything on your device.</p>
  </section>

  <style is:global>
    .pp-toolbar { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-bottom: 20px; }
    .pp-toolbar select { padding: 10px 12px; font: inherit; border: 1.5px solid var(--line); border-radius: 8px; background: var(--surface); color: var(--ink); min-width: 180px; }
    .pp-spacer { flex: 1; }
    .pp-danger { color: var(--danger); border-color: var(--danger); }
    .pp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
    @media (max-width: 760px) { .pp-grid { grid-template-columns: 1fr; } }
    .pp-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 16px; }
    @media (max-width: 520px) { .pp-fields { grid-template-columns: 1fr; } }
    .pp-fields label, .pp-list td label { display: block; font-size: .85rem; color: var(--ink-2); font-weight: 600; }
    .pp-fields input, .pp-fields select, .pp-list input, .pp-list select, textarea { width: 100%; margin-top: 4px; padding: 8px 10px; font: inherit; border: 1.5px solid var(--line); border-radius: 8px; background: var(--surface); color: var(--ink); }
    textarea { width: 100%; }
    .pp-photo-row { display: flex; gap: 16px; align-items: center; margin-bottom: 16px; flex-wrap: wrap; }
    .pp-photo-row img { width: 96px; height: 96px; object-fit: cover; border-radius: 50%; border: 1px solid var(--line); }
    .pp-list { margin-bottom: 20px; }
    .pp-list table { width: 100%; border-collapse: collapse; margin: 8px 0 12px; }
    .pp-list th { text-align: left; font-size: .8rem; color: var(--ink-3); text-transform: uppercase; letter-spacing: .05em; padding: 6px 6px 6px 0; }
    .pp-list td { padding: 4px 6px 4px 0; vertical-align: top; }
    .pp-list td:last-child { width: 36px; }
    .pp-list .pp-rm { background: none; border: 0; color: var(--ink-3); cursor: pointer; font-size: 1.1rem; padding: 8px 4px; }
    .pp-list .pp-rm:hover { color: var(--danger); }
    .pp-hint { color: var(--ink-3); font-size: .9rem; margin: -4px 0 8px; }
    .pp-status { color: var(--ink-3); font-size: .9rem; min-height: 1.4em; }
    @media (max-width: 720px) {
      .pp-list table, .pp-list thead, .pp-list tbody, .pp-list tr, .pp-list td { display: block; }
      .pp-list thead { display: none; }
      .pp-list tr { border: 1px solid var(--line); border-radius: 8px; padding: 10px; margin-bottom: 10px; position: relative; }
      .pp-list td { padding: 4px 0; }
      .pp-list td:last-child { position: absolute; top: 4px; right: 4px; width: auto; }
      .pp-list td::before { content: attr(data-label); display: block; font-size: .78rem; color: var(--ink-3); font-weight: 600; }
    }
    /* print */
    @media print {
      .site-header, .site-footer, .pp-toolbar, .pp-add, .pp-rm, #pp-faq, .pp-hint, .notice, label[for="pp-photo-input"], #pp-photo-remove, .pp-status { display: none !important; }
      .pp-list th:last-child, .pp-list td:last-child { display: none; }
      body { font-size: 11pt; background: #fff; color: #000; }
      .card { border: 1px solid #999; break-inside: avoid; padding: 12px; }
      .pp-grid { grid-template-columns: 1fr 1fr; }
      input, select, textarea { border: 0 !important; border-bottom: 1px solid #bbb !important; border-radius: 0 !important; padding: 2px 0 !important; background: #fff !important; color: #000 !important; -webkit-appearance: none; appearance: none; }
      .hero { padding: 0 0 12px; }
      .hero h1::after { content: " — " attr(data-animal); font-weight: 500; }
    }
  </style>

  <script>
    // Digital pet passport. Local-first: all data lives in localStorage under one key.
    // Shape: { version: 1, animals: [ { id, name, ..., vaccinations: [], treatments: [], medications: [], conditions: [], visits: [], notes, photo } ], current }
    type Row = Record<string, string>;
    type Animal = Record<string, any> & { id: string; vaccinations: Row[]; treatments: Row[]; medications: Row[]; conditions: Row[]; visits: Row[] };
    type Store = { version: number; animals: Animal[]; current: string | null };

    const KEY = 'aiveterinary.passport.v1';
    const LISTS: Record<string, { cols: { key: string; label: string; type?: string; options?: string[] }[] }> = {
      vaccinations: { cols: [
        { key: 'vaccine', label: 'Vaccine' }, { key: 'date', label: 'Date given', type: 'date' }, { key: 'validUntil', label: 'Valid until', type: 'date' },
        { key: 'clinic', label: 'Clinic / vet' }, { key: 'batch', label: 'Batch' } ] },
      treatments: { cols: [
        { key: 'product', label: 'Product' }, { key: 'date', label: 'Date', type: 'date' }, { key: 'nextDue', label: 'Next due', type: 'date' }, { key: 'givenBy', label: 'Given by' } ] },
      medications: { cols: [
        { key: 'name', label: 'Medication' }, { key: 'dose', label: 'Dose & how often' }, { key: 'started', label: 'Started', type: 'date' }, { key: 'prescribedBy', label: 'Prescribed by' } ] },
      conditions: { cols: [
        { key: 'type', label: 'Type', type: 'select', options: ['Allergy', 'Condition', 'Surgery', 'Drug reaction', 'Other'] }, { key: 'description', label: 'Description' }, { key: 'date', label: 'Since / date', type: 'date' } ] },
      visits: { cols: [
        { key: 'date', label: 'Date', type: 'date' }, { key: 'reason', label: 'Reason' }, { key: 'outcome', label: 'Outcome / notes' }, { key: 'clinic', label: 'Clinic' } ] },
    };

    const $ = <T extends Element>(s: string, root: ParentNode = document) => root.querySelector(s) as T;
    const $$ = <T extends Element>(s: string, root: ParentNode = document) => Array.from(root.querySelectorAll(s)) as T[];
    const uid = () => Math.random().toString(36).slice(2, 10) + Date.now().toString(36);

    function load(): Store {
      try {
        const raw = localStorage.getItem(KEY);
        if (raw) { const s = JSON.parse(raw); if (s && Array.isArray(s.animals)) return s; }
      } catch {}
      return { version: 1, animals: [], current: null };
    }
    let store: Store = load();
    let saveTimer: number | undefined;
    function save(msg = 'Saved on this device') {
      try { localStorage.setItem(KEY, JSON.stringify(store)); status(msg); }
      catch { status('Could not save: browser storage is full or blocked. Back up to a file.'); }
    }
    function scheduleSave() { clearTimeout(saveTimer); saveTimer = window.setTimeout(() => save(), 400); }
    function status(t: string) { const el = $('#pp-status'); if (el) el.textContent = t; }

    const blank = (): Animal => ({ id: uid(), name: '', vaccinations: [], treatments: [], medications: [], conditions: [], visits: [], notes: '' });
    const current = () => store.animals.find((a) => a.id === store.current) ?? null;

    function renderSelect() {
      const sel = $<HTMLSelectElement>('#pp-select');
      sel.innerHTML = '';
      for (const a of store.animals) {
        const o = document.createElement('option');
        o.value = a.id; o.textContent = a.name || 'Unnamed'; sel.appendChild(o);
      }
      sel.value = store.current ?? '';
      sel.hidden = store.animals.length === 0;
    }

    function renderList(name: string, a: Animal) {
      const sec = $(`[data-list="${name}"]`);
      const tbody = $('tbody', sec)!;
      tbody.innerHTML = '';
      const { cols } = LISTS[name];
      a[name].forEach((row: Row, i: number) => {
        const tr = document.createElement('tr');
        for (const c of cols) {
          const td = document.createElement('td'); td.dataset.label = c.label;
          let input: HTMLInputElement | HTMLSelectElement;
          if (c.type === 'select') {
            input = document.createElement('select');
            for (const opt of ['', ...(c.options ?? [])]) { const o = document.createElement('option'); o.value = opt; o.textContent = opt || '—'; input.appendChild(o); }
          } else { input = document.createElement('input'); input.type = c.type ?? 'text'; }
          input.value = row[c.key] ?? '';
          input.setAttribute('aria-label', c.label);
          input.addEventListener('input', () => { row[c.key] = input.value; scheduleSave(); });
          td.appendChild(input); tr.appendChild(td);
        }
        const td = document.createElement('td');
        const rm = document.createElement('button'); rm.type = 'button'; rm.className = 'pp-rm'; rm.textContent = '×'; rm.setAttribute('aria-label', 'Remove row');
        rm.addEventListener('click', () => { a[name].splice(i, 1); renderList(name, a); save('Row removed'); });
        td.appendChild(rm); tr.appendChild(td); tbody.appendChild(tr);
      });
    }

    function renderForm() {
      const a = current();
      const form = $('#pp-form') as HTMLElement, empty = $('#pp-empty') as HTMLElement;
      form.hidden = !a; empty.hidden = !!a;
      $('#pp-delete')!.toggleAttribute('hidden', !a);
      $('#pp-print')!.toggleAttribute('hidden', !a);
      $('h1')!.setAttribute('data-animal', a?.name ?? '');
      if (!a) return;
      for (const el of $$<HTMLInputElement>('[data-f]', form)) el.value = a[el.dataset.f!] ?? '';
      const img = $<HTMLImageElement>('#pp-photo');
      img.hidden = !a.photo; if (a.photo) img.src = a.photo;
      $('#pp-photo-remove')!.toggleAttribute('hidden', !a.photo);
      for (const name of Object.keys(LISTS)) renderList(name, a);
    }

    function render() { renderSelect(); renderForm(); }

    // field bindings
    for (const el of $$<HTMLInputElement>('#pp-form [data-f]')) {
      el.addEventListener('input', () => {
        const a = current(); if (!a) return;
        a[el.dataset.f!] = el.value;
        if (el.dataset.f === 'name') { renderSelect(); $('h1')!.setAttribute('data-animal', el.value); }
        scheduleSave();
      });
    }
    for (const sec of $$('.pp-list')) {
      $('.pp-add', sec)!.addEventListener('click', () => {
        const a = current(); if (!a) return;
        const name = (sec as HTMLElement).dataset.list!;
        a[name].push({}); renderList(name, a); save();
        const last = $$('tbody tr', sec).pop(); (last?.querySelector('input,select') as HTMLElement)?.focus();
      });
    }

    const newAnimal = () => { const a = blank(); store.animals.push(a); store.current = a.id; render(); save('New passport created'); $<HTMLInputElement>('#pp-form [data-f="name"]').focus(); };
    $('#pp-new')!.addEventListener('click', newAnimal);
    $('#pp-empty-new')!.addEventListener('click', newAnimal);
    $<HTMLSelectElement>('#pp-select').addEventListener('change', (e) => { store.current = (e.target as HTMLSelectElement).value; renderForm(); save(); });
    $('#pp-delete')!.addEventListener('click', () => {
      const a = current(); if (!a) return;
      if (!confirm(`Delete the passport for ${a.name || 'this animal'} from this device? Make a backup first if you want to keep it.`)) return;
      store.animals = store.animals.filter((x) => x.id !== a.id);
      store.current = store.animals[0]?.id ?? null; render(); save('Deleted');
    });
    $('#pp-print')!.addEventListener('click', () => window.print());

    // photo: resize to 320px max side before storing, to keep localStorage small
    $<HTMLInputElement>('#pp-photo-input').addEventListener('change', async (e) => {
      const file = (e.target as HTMLInputElement).files?.[0]; const a = current(); if (!file || !a) return;
      const bmp = await createImageBitmap(file);
      const scale = Math.min(1, 320 / Math.max(bmp.width, bmp.height));
      const c = document.createElement('canvas'); c.width = Math.round(bmp.width * scale); c.height = Math.round(bmp.height * scale);
      c.getContext('2d')!.drawImage(bmp, 0, 0, c.width, c.height);
      a.photo = c.toDataURL('image/jpeg', 0.8); renderForm(); save('Photo added');
      (e.target as HTMLInputElement).value = '';
    });
    $('#pp-photo-remove')!.addEventListener('click', () => { const a = current(); if (!a) return; delete a.photo; renderForm(); save('Photo removed'); });

    // backup / restore
    $('#pp-export')!.addEventListener('click', () => {
      const blob = new Blob([JSON.stringify(store, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const aEl = document.createElement('a');
      const names = store.animals.map((x) => x.name).filter(Boolean).join('-') || 'passport';
      aEl.href = url; aEl.download = `aiveterinary-passport-${names}-${new Date().toISOString().slice(0, 10)}.json`;
      document.body.appendChild(aEl); aEl.click(); aEl.remove(); URL.revokeObjectURL(url);
      status('Backup file downloaded. Keep it somewhere safe.');
    });
    $<HTMLInputElement>('#pp-import').addEventListener('change', async (e) => {
      const file = (e.target as HTMLInputElement).files?.[0]; if (!file) return;
      try {
        const data = JSON.parse(await file.text());
        if (!data || !Array.isArray(data.animals)) throw new Error('bad');
        const incoming: Animal[] = data.animals.map((x: any) => ({ ...blank(), ...x, id: x.id || uid() }));
        if (store.animals.length && !confirm(`Restore ${incoming.length} animal(s) from the file? Animals with the same ID will be replaced; others are added.`)) return;
        for (const inc of incoming) { const i = store.animals.findIndex((x) => x.id === inc.id); if (i >= 0) store.animals[i] = inc; else store.animals.push(inc); }
        store.current = incoming[0]?.id ?? store.current; render(); save('Restored from backup');
      } catch { status('That file is not an AI Veterinary passport backup.'); }
      (e.target as HTMLInputElement).value = '';
    });

    render();
  </script>
</Base>
