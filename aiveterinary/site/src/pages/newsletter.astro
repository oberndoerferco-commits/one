---
import Base from '../layouts/Base.astro';
import Newsletter from '../components/Newsletter.astro';
---
<Base title="Newsletter" description="Occasional email from AI Veterinary for animal owners and veterinary teams.">
  <section class="wrap narrow hero">
    <h1>Newsletter</h1>
    <p class="lead">One email now and then. For owners: new reviewed articles. For vets: progress on the documentation tool and an invitation to test it.</p>
    <Newsletter compact />
  </section>
</Base>
