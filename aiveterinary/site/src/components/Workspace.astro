  </style>

  <script type="application/json" id="ws-i18n" set:html={JSON.stringify({ ...j, pageLang: lang, abbrNone: t.abbrNone, abbrSave: t.abbrSave, handouts: t.handouts, handoutsNone: t.handoutsNone, timer: t.timer, identityOk: t.identityOk, identityFail: t.identityFail, handoutIndex })} />

  <script>
    import { ClinicalRecord, PatientHeader, type ClinicalRecord as Rec } from 'aiveterinary-app/src/schema.ts';
    import { normalizeNotes, findAbbreviations, DEFAULT_ABBREVIATIONS } from 'aiveterinary-app/src/normalize.ts';
    import { validateAll, requiredMissing, type Finding } from 'aiveterinary-app/src/validators.ts';
    import { renderConsultReport, renderOwnerSummary, renderReferralLetter, renderDischargeLetter, renderPrescription, renderVaccinationEntry, renderConsentForm, renderCostEstimate, renderDentalChart, renderOwnerSummaryBilingual, crossDocumentMedicationCheck } from 'aiveterinary-app/src/render.ts';
    import { countryMissing, VisitContext } from 'aiveterinary-app/src/country.ts';
    import { clinicMissing } from 'aiveterinary-app/src/clinic-required.ts';
    import { soapFields, exportBundle } from 'aiveterinary-app/src/export.ts';
    import { approve as approveVersion, amend as amendVersion, documentFrom, propagationMap, type ApprovedVersion, type GeneratedDocument } from 'aiveterinary-app/src/versions.ts';
    import c1 from 'aiveterinary-app/eval/cases/001-luna-vomiting.json';
    import c2 from 'aiveterinary-app/eval/cases/002-milo-otitis-de.json';
    import c3 from 'aiveterinary-app/eval/cases/003-gatto-inappetenza-it.json';
    import c4 from 'aiveterinary-app/eval/cases/004-adversarial-pregnant-owner.json';
    import c6 from 'aiveterinary-app/eval/cases/006-adversarial-dose-not-given.json';
    import c7 from 'aiveterinary-app/eval/cases/007-adversarial-de-decimal-comma.json';
    import c8 from 'aiveterinary-app/eval/cases/008-adversarial-it-performed-vs-planned.json';
    import c9 from 'aiveterinary-app/eval/cases/009-adversarial-other-pet.json';
    import c10 from 'aiveterinary-app/eval/cases/010-vaccination-visit.json';
    import c11 from 'aiveterinary-app/eval/cases/011-dental-de-triadan.json';

    type Case = { id: string; language: 'en' | 'de' | 'it'; header: any; notes: string; fixture_record: any };
    const cases = [c1, c2, c3, c4, c6, c7, c8, c9, c10, c11] as Case[];
    const J = JSON.parse(document.getElementById('ws-i18n')!.textContent!);
    const CLINIC_KEY = 'aiveterinary.clinic.v1';
    const loadClinic = (): Record<string, any> => { try { return JSON.parse(localStorage.getItem(CLINIC_KEY) ?? '{}'); } catch { return {}; } };
    const clinicAuthor = () => { const c = loadClinic(); return { name: c.vet || 'Dr. Demo', registration: c.reg || null }; };
    function renderLetterhead() {
      const c = loadClinic(); const el = $('#ws-letterhead') as HTMLElement;
      const lines = [c.name, c.address, [c.vet, c.reg].filter(Boolean).join(' · ')].filter(Boolean);
      el.hidden = lines.length === 0; el.innerHTML = lines.map((l, i) => `<div class="${i === 0 ? 'lh-name' : ''}">${esc(l)}</div>`).join('');
    }
    for (const input of document.querySelectorAll<HTMLInputElement>('.ws-clinic [data-c]')) {
      input.value = loadClinic()[input.dataset.c!] ?? '';
      input.addEventListener('input', () => { const c = loadClinic(); c[input.dataset.c!] = input.value.trim(); try { localStorage.setItem(CLINIC_KEY, JSON.stringify(c)); } catch {} renderLetterhead(); if (cur) render(); });
    }
    // Clinic-required fields: stored with the letterhead. They only ever add a flag for an absent field.
    const clinicRequired = (): string[] => { const r = loadClinic().required; return Array.isArray(r) ? r.filter((x: unknown) => typeof x === 'string') : []; };
    for (const cb of document.querySelectorAll<HTMLInputElement>('.ws-clinic [data-req]')) {
      cb.checked = clinicRequired().includes(cb.dataset.req!);
      cb.addEventListener('change', () => {
        const c = loadClinic(); const set = new Set(clinicRequired());
        if (cb.checked) set.add(cb.dataset.req!); else set.delete(cb.dataset.req!);
        c.required = [...set]; try { localStorage.setItem(CLINIC_KEY, JSON.stringify(c)); } catch {}
        if (cur) render();
      });
    }
    const GLOSSARY_KEY = 'aiveterinary.glossary.v1';
    const loadGlossary = (): Record<string, string> => { try { return JSON.parse(localStorage.getItem(GLOSSARY_KEY) ?? '{}'); } catch { return {}; } };
    const saveGlossary = (g: Record<string, string>) => { try { localStorage.setItem(GLOSSARY_KEY, JSON.stringify(g)); } catch {} };
    function renderAttachments() {
      const ul = $('#ws-attach-list'); ul.innerHTML = '';
      for (const f of cur.files) { const li = document.createElement('li'); li.textContent = `${f.name} · ${Math.max(1, Math.round(f.size / 1024))} KB`; ul.appendChild(li); }
    }
    function renderHandouts() {
      const ul = $('#ws-handouts'); ul.innerHTML = '';
      const text = [cur.record.assessment.text ?? '', ...cur.record.assessment.differentials.map((d: any) => d.text), cur.record.presenting_complaint?.text ?? ''].join(' ').toLowerCase();
      const words = text.split(/[^a-zäöüßàèéìòù]+/).filter((w) => w.length > 4);
      const species = cur.header.species;
      const hits = (J.handoutIndex as { title: string; href: string; species: string; draft: boolean }[])
        .filter((h) => h.species === species || h.species === 'general')
        .map((h) => ({ h, score: words.filter((w) => h.title.toLowerCase().includes(w)).length }))
        .filter((x) => x.score > 0).sort((a, b) => b.score - a.score).slice(0, 3);
      if (!hits.length) { const li = document.createElement('li'); li.className = 'pp-hint'; li.textContent = J.handoutsNone; ul.appendChild(li); return; }
      for (const { h } of hits) { const li = document.createElement('li'); const a = document.createElement('a'); a.href = h.href; a.target = '_blank'; a.rel = 'noopener'; a.textContent = h.title; li.appendChild(a); if (h.draft) { const sp = document.createElement('span'); sp.className = 'pp-hint'; sp.textContent = ' · draft'; li.appendChild(sp); } ul.appendChild(li); }
    }
    function renderAbbr() {
      const list = $('#ws-abbr-list'); list.innerHTML = '';
      const table = { ...DEFAULT_ABBREVIATIONS, ...loadGlossary() };
      const seen = new Map<string, { meaning: string; spans: [number, number][] }>();
      for (const x of findAbbreviations(cur.notes, table)) {
        const k = x.abbr.toLowerCase(); const e = seen.get(k) ?? { meaning: x.meaning, spans: [] }; e.spans.push([x.index, x.index + x.abbr.length]); seen.set(k, e);
      }
      if (!seen.size) { const li = document.createElement('li'); li.className = 'pp-hint'; li.textContent = J.abbrNone; list.appendChild(li); return; }
      for (const [k, e] of seen) {
        const li = document.createElement('li');
        const code = document.createElement('code'); code.textContent = k; li.appendChild(code);
        const input = document.createElement('input'); input.value = e.meaning; input.setAttribute('aria-label', k);
        const btn = document.createElement('button'); btn.type = 'button'; btn.textContent = J.abbrSave; btn.className = 'ws-abbr-save'; btn.hidden = true;
        input.addEventListener('input', () => { btn.hidden = input.value.trim() === e.meaning; });
        btn.addEventListener('click', () => { const g = loadGlossary(); g[k] = input.value.trim(); saveGlossary(g); renderAbbr(); });
        li.addEventListener('mouseenter', () => light(e.spans, true)); li.addEventListener('mouseleave', () => light(e.spans, false));
        li.append(input, btn); list.appendChild(li);
      }
    }
    const labels: Record<string, string> = J.cases;
    const $ = (s: string) => document.querySelector(s) as HTMLElement;

    let cur: { notes: string; header: any; record: Rec; lang: 'en' | 'de' | 'it'; resolved: Record<string, string>; approved: boolean; meds: boolean[]; handed: boolean; files: { name: string; size: number; type: string }[]; started: number; v: ApprovedVersion | null; docs: GeneratedDocument[] };

    const sel = $('#ws-case') as HTMLSelectElement;
    for (const c of [...cases].sort((a, b) => Object.keys(labels).indexOf(a.id) - Object.keys(labels).indexOf(b.id))) { const o = document.createElement('option'); o.value = c.id; o.textContent = labels[c.id] ?? c.id; sel.appendChild(o); }
    sel.addEventListener('change', () => load(sel.value));
    const csel = $('#ws-country') as HTMLSelectElement;
    csel.addEventListener('change', () => { if (cur) renderFlags(); });
    const dsel = $('#ws-doc') as HTMLSelectElement; const refIn = $('#ws-referral') as HTMLInputElement;
    const docHead = $('.ws-pane + .ws-pane .ws-h') as HTMLElement; const docHeadDefault = docHead.firstChild?.textContent ?? '';
    ($('#ws-lang2') as HTMLSelectElement).addEventListener('change', () => { if (cur) render(); });
    dsel.addEventListener('change', () => { ($('#ws-lang2-wrap') as HTMLElement).hidden = dsel.value !== 'owner'; ($('#ws-referral-wrap') as HTMLElement).hidden = dsel.value !== 'referral'; if (docHead.firstChild) docHead.firstChild.textContent = dsel.value === 'report' ? docHeadDefault : dsel.options[dsel.selectedIndex].text + ' '; if (cur) render(); });
    refIn.addEventListener('input', () => { if (cur) render(); });
    function renderDoc(approved: boolean) {
      const { record, header, lang } = cur;
      const l2 = ($('#ws-lang2') as HTMLSelectElement).value as any;
      if (dsel.value === 'owner' && l2 && l2 !== lang) return renderOwnerSummaryBilingual(record, header, lang, l2, { approved });
      if (dsel.value === 'owner') return renderOwnerSummary(record, header, lang, { approved });
      if (dsel.value === 'referral') return renderReferralLetter(record, header, lang, { approved, reason: refIn.value.trim() || null });
      if (dsel.value === 'discharge') return renderDischargeLetter(record, header, lang, { approved });
      if (dsel.value === 'dental') return renderDentalChart(cur.notes, lang);
      if (dsel.value === 'estimate') return renderCostEstimate(record, header, VisitContext.parse({ country: csel.value, author: clinicAuthor() }), lang);
      if (dsel.value === 'consent') return renderConsentForm(record, header, VisitContext.parse({ country: csel.value, author: clinicAuthor() }), lang);
      if (dsel.value === 'vacc') return renderVaccinationEntry(record, header, VisitContext.parse({ country: csel.value, author: clinicAuthor() }), lang, { approved });
      if (dsel.value === 'rx') return renderPrescription(record, header, VisitContext.parse({ country: csel.value, author: clinicAuthor() }), lang, { approved });
      return renderConsultReport(record, header, lang, { approved });
    }
    const rsel = $('#ws-role') as HTMLSelectElement;
    const approveBtn = $('#ws-approve') as HTMLButtonElement; const approveLabel = approveBtn.innerHTML;
    rsel.addEventListener('change', () => { approveBtn.innerHTML = rsel.value === 'nurse' ? `${J.handOver} <kbd>Ctrl+Shift+Enter</kbd>` : approveLabel; if (cur) renderFlags(); });

    function load(id: string) {
      const c = cases.find((x) => x.id === id)!;
      cur = { notes: normalizeNotes(c.notes), header: PatientHeader.parse(c.header), record: ClinicalRecord.parse(c.fixture_record), lang: c.language, resolved: {}, approved: false, meds: [], handed: false, files: [], started: Date.now(), v: null, docs: [] };
      const h = cur.header;
      $('#ws-patient').textContent = [h.name, h.species, h.breed, h.sex, h.age && `${h.age.value} ${h.age.unit}${h.age.value === 1 ? '' : 's'}`, h.weight_kg && `${h.weight_kg} kg`].filter(Boolean).join(' · ');
      $('#ws-lang').textContent = { en: 'English', de: 'Deutsch', it: 'Italiano' }[cur.lang];
      csel.value = { en: 'DE', de: 'DE', it: 'IT' }[cur.lang];
      document.body.classList.remove('ws-approved'); ($('#ws-amend') as HTMLElement).hidden = true;
      $('#ws-state').innerHTML = `<span class="badge draft">● ${J.draft}</span>`;
      $('#ws-status').textContent = '';
      render();
    }

    // Collect every span-bearing item so report text can link back to the notes.
    function spanItems(r: Rec): { text: string; spans: [number, number][] }[] {
      const out: { text: string; spans: [number, number][] }[] = [];
      const push = (text: string | null | undefined, spans?: [number, number][]) => { if (text && spans?.length) out.push({ text, spans }); };
      push(r.presenting_complaint?.text, r.presenting_complaint?.source_spans);
      r.history.forEach((h) => push(h.value, h.source_spans));
      for (const k of ['temperature', 'heart_rate', 'respiratory_rate', 'weight'] as const) { const q = r.examination.vitals[k]; if (q) push(String(q.value), q.source_spans); }
      r.examination.findings.forEach((f) => push(f.text, f.source_spans));
      r.diagnostics.forEach((d) => { push(d.test, d.source_spans); push(d.result, d.source_spans); });
      push(r.assessment.text, r.assessment.source_spans);
      r.treatments.forEach((t) => push(t.text, t.source_spans));
      r.medications.forEach((m) => { push(m.drug, m.source_spans); push(m.class_as_written, m.source_spans); push(m.duration, m.source_spans); push(m.frequency, m.source_spans); });
      push(r.plan.follow_up?.text, r.plan.follow_up?.source_spans);
      r.plan.instructions.forEach((i) => push(i.text, i.source_spans));
      return out;
    }

    function render() {
      renderSoap();
      const { notes, header, record, lang } = cur;
      // notes with one <mark> per character run, so any span can be lit
      const notesEl = $('#ws-notes'); notesEl.innerHTML = '';
      const frag = document.createDocumentFragment();
      [...notes].forEach((ch, i) => { const m = document.createElement('mark'); m.textContent = ch; m.dataset.i = String(i); frag.appendChild(m); });
      notesEl.appendChild(frag);

      // report: markdown from the renderer → minimal HTML, then wrap sourced phrases
      const md = renderDoc(cur.approved);
      let html = md.split('\n').map((line) => {
        if (line.startsWith('# ')) return '';
        if (line.startsWith('_')) return '';
        if (line.startsWith('### ')) return `<h2>${esc(line.slice(4))}</h2>`;
        if (line.startsWith('## ')) return `<h2>${esc(line.slice(3))}</h2>`;
        if (line.startsWith('|')) return line;
        if (line.startsWith('- ')) return `<li>${esc(line.slice(2))}</li>`;
        if (!line.trim()) return '';
        return `<p>${esc(line).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')}</p>`;
      }).join('\n');
      html = html.replace(/((?:^\|.*\n?)+)/gm, (t) => table(t));
      html = html.replace(/(<li>[\s\S]*?<\/li>\n?)+/g, (t) => `<ul>${t}</ul>`);
      html = html.replace(/▲ ([^<|]+)/g, (_m, t) => `<span class="flag">▲ ${t}</span>`);
      html = html.replace(/(Owner reports|Laut Besitzer|Il proprietario riferisce):/g, '<span class="own">$1:</span>');
      for (const it of spanItems(record)) {
        const e = esc(it.text);
        html = html.replace(new RegExp(`(?<![\\w-])${escRe(e)}(?![\\w-])`), `<span class="src" data-spans='${JSON.stringify(it.spans)}'>${e}</span>`);
      }
      if (cur.files.length) html += `<h2>${esc(J.attachments)}</h2><ul>${cur.files.map((f) => `<li>${esc(f.name)}</li>`).join('')}</ul>`;
      $('#ws-report').innerHTML = html;
      renderAttachments();
      for (const s of document.querySelectorAll<HTMLElement>('.ws-report .src')) {
        s.addEventListener('mouseenter', () => light(JSON.parse(s.dataset.spans!), true));
        s.addEventListener('mouseleave', () => light(JSON.parse(s.dataset.spans!), false));
        s.addEventListener('click', () => { light(JSON.parse(s.dataset.spans!), true); setTimeout(() => light(JSON.parse(s.dataset.spans!), false), 1500); });
      }
      document.querySelectorAll<HTMLInputElement>('.ws-med-tick').forEach((cb) => cb.addEventListener('change', () => { cur.meds[Number(cb.dataset.i)] = cb.checked; renderFlags(); }));
      // owner-reported vs vet-observed: one click flips a history line; the renderer then drops or adds the prefix
      if (!cur.approved) for (const h of record.history) {
        const needle = `${h.finding}: ${h.value}`;
        const li = Array.from(document.querySelectorAll<HTMLElement>('.ws-report li')).find((el) => el.textContent?.includes(needle));
        if (!li) continue;
        const b = document.createElement('button'); b.type = 'button'; b.className = 'ws-role-toggle';
        const owner = h.source_role === 'owner_reported';
        b.textContent = owner ? '→ vet' : '→ owner'; b.title = owner ? J.toVet : J.toOwner; b.setAttribute('aria-label', b.title);
        b.addEventListener('click', () => { h.source_role = owner ? 'vet_observed' : 'owner_reported'; render(); });
        li.appendChild(b);
      }
      renderFlags();
      renderAbbr();
      renderLetterhead();
      renderHandouts();
      trackDoc();
    }

    function light(spans: [number, number][], on: boolean) {
      for (const [a, b] of spans) for (let i = a; i < b; i++) document.querySelector(`#ws-notes mark[data-i="${i}"]`)?.classList.toggle('on', on);
    }

    function renderFlags() {
      const { notes, header, record } = cur;
      const findings: Finding[] = validateAll(record, notes, header);
      const blocks = findings.filter((f) => f.severity === 'block');
      const warns = findings.filter((f) => f.severity === 'warn');
      const ctx = VisitContext.parse({ country: csel.value, author: clinicAuthor() });
      const cflags = countryMissing(record, header, ctx);
      const reasons: Record<string, string> = {}; for (const f of cflags) reasons[f.field] = f.reason;
      const clinic = clinicMissing(record, clinicRequired(), { lang: J.pageLang, header });
      for (const f of clinic) reasons[f.field] ??= f.reason;
      const missing = [...requiredMissing(record, 'consult_report', header), ...cflags.map((f) => f.field), ...clinic.map((f) => f.field)].filter((f, i, a) => a.indexOf(f) === i);
      const list = $('#ws-flaglist'); list.innerHTML = '';
      const li = (html: string) => { const el = document.createElement('li'); el.innerHTML = html; list.appendChild(el); return el; };
      for (const b of blocks) li(`<span class="f-block">${J.blocked}</span> ${esc(b.field)}: ${esc(b.message)}`);
      for (const w of warns) li(`<span class="f-warn">${J.check}</span> ${esc(w.field)}: ${esc(w.message)}`);
      for (const m of missing) {
        const done = cur.resolved[m];
        const el = li(`<span class="f-miss">${done ? '✓' : '▲'} ${J.missing}</span> <code>${esc(m)}</code> ${reasons[m] ? `<span class="ws-hint">${esc(reasons[m])}</span> ` : ''}${done ? `<em>${esc(done)}</em>` : ''}`);
        if (!done) {
          const input = document.createElement('input'); input.placeholder = J.placeholder; input.setAttribute('aria-label', `${J.valueFor} ${m}`);
          const add = document.createElement('button'); add.textContent = J.add; add.type = 'button';
          const nr = document.createElement('button'); nr.textContent = J.notRecorded; nr.type = 'button';
          add.addEventListener('click', () => { if (input.value.trim()) { cur.resolved[m] = input.value.trim(); renderFlags(); } });
          input.addEventListener('keydown', (e) => { if (e.key === 'Enter') add.click(); });
          nr.addEventListener('click', () => { cur.resolved[m] = J.notRecorded; renderFlags(); });
          el.append(input, add, nr);
        }
      }
      for (const u of record.uncertain) li(`<span class="f-warn">${J.setAside}</span> “${esc(u.original_text)}” — ${esc(u.reason)}`);
      if (!blocks.length && !warns.length && !missing.length && !record.uncertain.length) li(`<span style="color:var(--ok);font-weight:600">${J.nothing}</span> ${J.nothingRest}`);
      let identityProblems = 0;
      {
        const ctx = VisitContext.parse({ country: csel.value, author: clinicAuthor() });
        const docsAll: Record<string, string> = { report: renderConsultReport(record, header, cur.lang), owner: renderOwnerSummary(record, header, cur.lang), referral: renderReferralLetter(record, header, cur.lang), discharge: renderDischargeLetter(record, header, cur.lang), rx: renderPrescription(record, header, ctx, cur.lang) };
        const l2 = ($('#ws-lang2') as HTMLSelectElement).value as any; if (l2 && l2 !== cur.lang) docsAll[`owner_${l2}`] = renderOwnerSummary(record, header, l2);
        if (record.medications.some((m: any) => m.status !== 'declined')) {
          const probs = crossDocumentMedicationCheck(record, docsAll); identityProblems = probs.length;
          li(probs.length ? `<span class="f-block">${J.blocked}</span> ${esc(J.identityFail)} ${esc(probs.map((p) => `${p.doc}: ${p.field} "${p.value}"`).join('; '))}` : `<span style="color:var(--ok);font-weight:600">✓</span> ${esc(J.identityOk)}`);
        }
      }
      const unresolved = missing.filter((m) => !cur.resolved[m]).length;
      const unticked = record.medications.filter((_, i) => !cur.meds[i]).length;
      ($('#ws-approve') as HTMLButtonElement).disabled = cur.approved || blocks.length > 0 || identityProblems > 0 || unresolved > 0 || unticked > 0;
      $('#ws-status').textContent = cur.approved ? J.approvedStatus : blocks.length ? J.blocking.replace('{n}', String(blocks.length)) : unresolved ? J.unresolved.replace('{n}', String(unresolved)) : unticked ? J.medsUnchecked.replace('{n}', String(unticked)) : J.ready;
    }

    function approve() {
      if (($('#ws-approve') as HTMLButtonElement).disabled) return;
      const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      if (rsel.value === 'nurse') {
        // A nurse or assistant prepares the draft; only a veterinarian can approve.
        cur.handed = true;
        $('#ws-state').innerHTML = `<span class="badge draft">● ${J.nurseDraft} · ${time}</span>`;
        $('#ws-status').textContent = J.handedStatus;
        return;
      }
      const secs = Math.round((Date.now() - cur.started) / 1000);
      const who = clinicAuthor().name;
      let staleNote = '';
      if (!cur.v) cur.v = approveVersion(cur.record, who);
      else {
        const reason = window.prompt(J.amendReason.replace('{n}', String(cur.v.version + 1)), '');
        if (reason === null) return;
        try { cur.v = amendVersion(cur.v, cur.record, who, reason); }
        catch (e: any) { $('#ws-status').textContent = e.message; return; }
        const { stale } = propagationMap(cur.v, cur.docs);
        staleNote = stale.length ? J.staleDocs.replace('{list}', [...new Set(stale.map((d) => d.kind))].join(', ')) : J.noStale;
      }
      cur.approved = true; document.body.classList.add('ws-approved');
      $('#ws-state').innerHTML = `<span class="badge reviewed">✓ ${J.approved} ${J.version.replace('{n}', String(cur.v.version))}${cur.handed ? ` (${J.cosigned})` : ''} · ${time} · ${J.timer}: ${Math.floor(secs / 60)}:${String(secs % 60).padStart(2, '0')}</span>`;
      ($('#ws-amend') as HTMLElement).hidden = false;
      render();
      if (staleNote) $('#ws-status').textContent = staleNote;
    }
    function trackDoc() {
      if (!cur.approved || !cur.v) return;
      const kind = dsel.value;
      if (!cur.docs.some((d) => d.kind === kind && d.lang === cur.lang && d.from_version === cur.v!.version)) cur.docs.push(documentFrom(cur.v, kind, cur.lang));
    }
    $('#ws-amend').addEventListener('click', () => {
      if (!cur.v) return;
      cur.approved = false; document.body.classList.remove('ws-approved');
      $('#ws-state').innerHTML = `<span class="badge draft">● ${J.amending.replace('{n}', String(cur.v.version + 1))}</span>`;
      ($('#ws-amend') as HTMLElement).hidden = true;
      render();
    });
    function copyOut() {
      const txt = renderDoc(cur.approved)
        .replace(/^#+ (.*)$/gm, (_m, h) => h.toUpperCase()).replace(/^_|_$/gm, '').replace(/\*\*/g, '').replace(/\|/g, ' ').replace(/^ *-{3,}.*$/gm, '').replace(/\n{3,}/g, '\n\n');
      navigator.clipboard?.writeText(txt).then(() => { $('#ws-status').textContent = J.copied; }, () => { $('#ws-status').textContent = J.copyFail; });
    }
    function renderSoap() {
      const box = $('#ws-soap') as HTMLElement;
      box.hidden = !(cur.approved && cur.v);
      if (box.hidden) return;
      const fields = soapFields(cur.v!.record, cur.lang, cur.resolved);
      $('#ws-soap-fields').innerHTML = fields.map((f, i) => `<div class="ws-soap-f"><div class="ws-soap-h"><strong>${esc(f.label)}</strong> <button class="btn secondary sm" type="button" data-i="${i}">${esc(J.soapCopy)}</button></div><pre>${esc(f.text)}</pre></div>`).join('');
      $('#ws-soap-fields').querySelectorAll<HTMLButtonElement>('button[data-i]').forEach((b) => b.addEventListener('click', () => {
        const f = fields[Number(b.dataset.i)];
        navigator.clipboard?.writeText(f.text).then(() => { $('#ws-status').textContent = J.soapCopied.replace('{label}', f.label); }, () => { $('#ws-status').textContent = J.copyFail; });
      }));
    }
    $('#ws-json').addEventListener('click', () => {
      if (!cur.approved || !cur.v) return;
      const bundle = exportBundle(cur.v, cur.header, cur.lang, undefined, cur.resolved);
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([JSON.stringify(bundle, null, 2)], { type: 'application/json' }));
      a.download = `${String(cur.header.name || 'record').replace(/[^\p{L}\p{N}_-]+/gu, '-')}-v${cur.v.version}.json`;
      a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    });
    $('#ws-approve').addEventListener('click', approve);
    // Phone bar: a mirror of the status line and the real Approve button, so the rules are identical.
    // It is hidden from assistive tech, which reaches the same controls in the page.
    const mirror = () => {
      const real = $('#ws-approve') as HTMLButtonElement;
      $('#ws-mbar-status').textContent = $('#ws-status').textContent;
      ($('#ws-mbar-approve') as HTMLButtonElement).disabled = real.disabled || !seenEnd;
      $('#ws-mbar').classList.toggle('is-approved', cur.approved);
    };
    // Approving from the bar only after the end of the report has been on screen once: read first, then sign.
    let seenEnd = false;
    new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { seenEnd = true; mirror(); } }).observe($('#ws-flaglist'));
    new MutationObserver(mirror).observe($('#ws-status'), { childList: true, characterData: true, subtree: true });
    new MutationObserver(mirror).observe($('#ws-approve'), { attributes: true, attributeFilter: ['disabled'] });
    $('#ws-mbar-approve').addEventListener('click', () => { approve(); mirror(); });
    $('#ws-copy').addEventListener('click', copyOut);
    $('#ws-print').addEventListener('click', () => window.print());
    document.addEventListener('keydown', (e) => {
      if (e.ctrlKey && e.shiftKey && e.key === 'Enter') { e.preventDefault(); approve(); }
      if (e.ctrlKey && e.shiftKey && (e.key === 'C' || e.key === 'c')) { e.preventDefault(); copyOut(); }
    });

    const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
    const escRe = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    function table(block: string) {
      const rows = block.trim().split('\n').filter((r) => !/^\|\s*-/.test(r)).map((r) => r.slice(1, -1).split('|').map((c) => c.trim()));
      const [head, ...body] = rows;
      const isMeds = ['Drug', 'Wirkstoff', 'Farmaco'].includes(head[0]);
      if (!isMeds) return `<table><thead><tr>${head.map((h) => `<th>${h}</th>`).join('')}</tr></thead><tbody>${body.map((r) => `<tr>${r.map((c) => `<td>${c}</td>`).join('')}</tr>`).join('')}</tbody></table>`;
      const tick = (i: number) => `<td class="ws-tick"><label><input type="checkbox" class="ws-med-tick" data-i="${i}" ${cur.meds[i] ? 'checked' : ''} ${cur.approved ? 'disabled' : ''} aria-label="${J.medsTick}"> ${J.medsTick}</label></td>`;
      return `<table><thead><tr>${head.map((h) => h ? `<th>${h}</th>` : `<th><span class="sr-only">Status</span></th>`).join('')}<th>${J.medsTick}</th></tr></thead><tbody>${body.map((r, i) => `<tr>${r.map((c) => `<td>${c}</td>`).join('')}${tick(i)}</tr>`).join('')}</tbody></table>`;
    }

    const fileInput = $('#ws-file') as HTMLInputElement;
    fileInput.addEventListener('change', () => {
      for (const f of Array.from(fileInput.files ?? [])) cur.files.push({ name: f.name, size: f.size, type: f.type });
      fileInput.value = ''; render();
    });
    load(J.first);
  </script>
