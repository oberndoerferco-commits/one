        btn.addEventListener('click', () => { const g = loadGlossary(); g[k] = input.value.trim(); saveGlossary(g); renderAbbr(); });
        li.addEventListener('mouseenter', () => light(e.spans, true)); li.addEventListener('mouseleave', () => light(e.spans, false));
        li.append(input, btn); list.appendChild(li);
      }
    }
    const labels: Record<string, string> = J.cases;
    const $ = (s: string) => document.querySelector(s) as HTMLElement;

    let cur: { notes: string; header: any; record: Rec; lang: 'en' | 'de' | 'it'; resolved: Record<string, string>; approved: boolean; meds: boolean[]; handed: boolean; files: { name: string; size: number; type: string }[]; started: number; v: ApprovedVersion | null; docs: GeneratedDocument[] };

    const sel = $('#ws-case') as HTMLSelectElement;
    for (const c of [...cases].sort((a, b) => Object.keys(labels).indexOf(a.id) - Object.keys(labels).indexOf(b.id))) { const o = document.createElement('option'); o.value = c.id; o.textContent = labels[c.id] ?? c.id; sel.appendChild(o); }
    sel.addEventListener('change', () => load(sel.value));
    const csel = $('#ws-country') as HTMLSelectElement;
    const dsel = $('#ws-doc') as HTMLSelectElement; const refIn = $('#ws-referral') as HTMLInputElement;
    const docHead = $('.ws-pane + .ws-pane .ws-h') as HTMLElement; const docHeadDefault = docHead.firstChild?.textContent ?? '';
    ($('#ws-lang2') as HTMLSelectElement).addEventListener('change', () => { if (cur) render(); });
    function docShown() {
      ($('#ws-lang2-wrap') as HTMLElement).hidden = dsel.value !== 'owner'; ($('#ws-referral-wrap') as HTMLElement).hidden = dsel.value !== 'referral';
      ($('#ws-rev-wrap') as HTMLElement).hidden = dsel.value !== 'rev'; ($('#ws-claim-wrap') as HTMLElement).hidden = dsel.value !== 'claim';
      if (docHead.firstChild) docHead.firstChild.textContent = dsel.value === 'report' ? docHeadDefault : dsel.options[dsel.selectedIndex].text + ' ';
    }
    dsel.addEventListener('change', () => { docShown(); if (cur) render(); });
    // The REV draft exists only under Italian rules: the option is offered only while the country is IT.
    // If the country changes away from IT with the REV draft on screen, fall back to the report and say so.
    const revOpt = dsel.querySelector('option[value="rev"]') as HTMLOptionElement;
    function syncRev(): boolean {
      const it = csel.value === 'IT'; revOpt.disabled = !it; revOpt.hidden = !it;
      if (it || dsel.value !== 'rev') return false;
      dsel.value = 'report'; docShown(); return true;
    }
    csel.addEventListener('change', () => { const switched = syncRev(); renderClaimLines(); if (cur) render(); if (switched) $('#ws-status').textContent = J.revSwitched; });
    refIn.addEventListener('input', () => { if (cur) render(); });
    // Structured referral: urgency (no default, "—" is empty), service and owner contact, all typed by the vet.
    // The owner fields describe the synthetic case: they live in these inputs only, are never written to
    // localStorage, and are cleared with the case (like the notes, nothing about the patient is stored).
    const refUrg = $('#ws-ref-urgency') as HTMLSelectElement; const refSvc = $('#ws-ref-service') as HTMLInputElement;
    const refOwner = { name: $('#ws-ref-owner-name') as HTMLInputElement, phone: $('#ws-ref-owner-phone') as HTMLInputElement, email: $('#ws-ref-owner-email') as HTMLInputElement };
    const refCaseInputs = [refIn, refSvc, refOwner.name, refOwner.phone, refOwner.email];
    for (const el of [refSvc, refOwner.name, refOwner.phone, refOwner.email]) el.addEventListener('input', () => { if (cur) render(); });
    refUrg.addEventListener('change', () => { if (cur) render(); });
    const refVal = (el: HTMLInputElement) => el.value.trim() || null;
    function referralInput() {
      const c = loadClinic(); // the letterhead, as typed; no 'Dr. Demo' fallback here
      const s = (x: unknown) => (typeof x === 'string' && x.trim() ? x.trim() : null);
      return {
        referrer: { practice: s(c.name), address: s(c.address), email: s(c.email), vet: s(c.vet), registration: s(c.reg) },
        request: { urgency: (refUrg.value || null) as 'emergency' | 'urgent' | 'routine' | null, service: refVal(refSvc), question: refVal(refIn) },
        owner: { name: refVal(refOwner.name), phone: refVal(refOwner.phone), email: refVal(refOwner.email) },
      };
    }
    // REV number and PIN (after issuing) and the claim inputs: same rule as the referral owner fields.
    // Values live in these inputs and in `claimLines` only, are never written to localStorage, and are cleared with the case.
    const revNum = $('#ws-rev-number') as HTMLInputElement; const revPin = $('#ws-rev-pin') as HTMLInputElement;
    const claimDx = $('#ws-claim-dx') as HTMLInputElement; const claimFirst = $('#ws-claim-first') as HTMLInputElement; const claimPre = $('#ws-claim-pre') as HTMLSelectElement;
    for (const el of [revNum, revPin, claimDx, claimFirst]) el.addEventListener('input', () => { if (cur) render(); });
    claimPre.addEventListener('change', () => { if (cur) render(); });
    type ClaimLine = { got: string; desc: string; factor: string; amount: string };
    let claimLines: ClaimLine[] = [];
    const blankLine = (): ClaimLine => ({ got: '', desc: '', factor: '', amount: '' });
    // Rows are rebuilt only when a line is added or removed or the country changes, so typing keeps focus.
    function renderClaimLines(focusRow?: number) {
      const box = $('#ws-claim-lines'); box.innerHTML = '';
      const de = csel.value === 'DE';
      const cols: [keyof ClaimLine, string, string][] = de
        ? [['got', J.claimGot, 'ws-claim-got'], ['desc', J.claimDesc, 'ws-claim-desc'], ['factor', J.claimFactor, 'ws-claim-factor'], ['amount', J.claimAmount, 'ws-claim-amount']]
        : [['desc', J.claimDesc, 'ws-claim-desc'], ['amount', J.claimAmount, 'ws-claim-amount']];
      claimLines.forEach((line, i) => {
        const n = String(i + 1);
        const row = document.createElement('div'); row.className = `ws-claim-line${de ? ' de' : ''}`; row.setAttribute('role', 'group'); row.setAttribute('aria-label', J.claimLineN.replace('{n}', n));
        for (const [k, label, cls] of cols) {
          const cell = document.createElement('div'); cell.className = cls;
          const id = `ws-claim-l${i}-${k}`;
          const lab = document.createElement('label'); lab.className = 'ws-label'; lab.htmlFor = id; lab.textContent = `${label} · ${n}`;
          const inp = document.createElement('input'); inp.id = id; inp.type = 'text'; inp.autocomplete = 'off'; inp.value = line[k];
          if (k === 'factor' || k === 'amount') inp.inputMode = 'decimal';
