          cell.append(lab, inp); row.appendChild(cell);
        }
        const rm = document.createElement('button'); rm.type = 'button'; rm.textContent = '✕'; rm.setAttribute('aria-label', J.claimRemove.replace('{n}', n)); rm.title = rm.getAttribute('aria-label')!;
        rm.addEventListener('click', () => {
