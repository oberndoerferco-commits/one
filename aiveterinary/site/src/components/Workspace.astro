    }
    const claimPack = (approved: boolean) => buildClaimPack(cur.record, cur.header, visitCtx(), claimOpts(approved));
    const revDraft = () => buildRevDraft(cur.record, cur.header, visitCtx(), { numero: revNum.value.trim() || null, pin: revPin.value.trim() || null });
    /** The language a document is printed in: REV is an Italian system; the claim follows the page; the rest follow the case. */
    const docLang = (): 'en' | 'de' | 'it' => (dsel.value === 'rev' ? 'it' : dsel.value === 'claim' ? J.pageLang : cur.lang);
    function renderDoc(approved: boolean) {
      const { record, header, lang } = cur;
      const l2 = ($('#ws-lang2') as HTMLSelectElement).value as any;
      if (dsel.value === 'owner' && l2 && l2 !== lang) return renderOwnerSummaryBilingual(record, header, lang, l2, { approved });
      if (dsel.value === 'owner') return renderOwnerSummary(record, header, lang, { approved });
      if (dsel.value === 'referral') return renderReferralLetter(record, header, lang, { approved, referral: referralInput() });
      if (dsel.value === 'discharge') return renderDischargeLetter(record, header, lang, { approved });
      if (dsel.value === 'dental') return renderDentalChart(cur.notes, lang);
      if (dsel.value === 'estimate') return renderCostEstimate(record, header, VisitContext.parse({ country: csel.value, author: clinicAuthor() }), lang);
      if (dsel.value === 'consent') return renderConsentForm(record, header, VisitContext.parse({ country: csel.value, author: clinicAuthor() }), lang);
      if (dsel.value === 'vacc') return renderVaccinationEntry(record, header, VisitContext.parse({ country: csel.value, author: clinicAuthor() }), lang, { approved });
      if (dsel.value === 'rev' && csel.value === 'IT') return renderRevDraftText(revDraft(), 'it');
      if (dsel.value === 'claim') return renderClaimSummary(claimPack(approved), J.pageLang);
      if (dsel.value === 'rx') return renderPrescription(record, header, VisitContext.parse({ country: csel.value, author: clinicAuthor() }), lang, { approved });
      return renderConsultReport(record, header, lang, { approved });
    }
    const rsel = $('#ws-role') as HTMLSelectElement;
    const approveBtn = $('#ws-approve') as HTMLButtonElement; const approveLabel = approveBtn.innerHTML;
    rsel.addEventListener('change', () => { approveBtn.innerHTML = rsel.value === 'nurse' ? `${J.handOver} <kbd>Ctrl+Shift+Enter</kbd>` : approveLabel; if (cur) renderFlags(); });

    function load(id: string) {
      const c = cases.find((x) => x.id === id)!;
      resetCaseInputs();
      cur = { notes: normalizeNotes(c.notes), header: PatientHeader.parse(c.header), record: ClinicalRecord.parse(c.fixture_record), lang: c.language, resolved: {}, approved: false, meds: [], handed: false, files: [], started: Date.now(), v: null, docs: [] };
      const h = cur.header;
      const sig = J.sig; const unit = h.age && sig.unit[h.age.unit];
      $('#ws-patient').textContent = [h.name, h.species && (sig.species[h.species] ?? h.species), h.breed, h.sex && (sig.sex[h.sex] ?? h.sex), h.age && `${h.age.value.toLocaleString(J.pageLang)} ${unit ? unit[h.age.value === 1 ? 0 : 1] : h.age.unit}`, h.weight_kg && `${h.weight_kg.toLocaleString(J.pageLang)} kg`].filter(Boolean).join(' · ');
      csel.value = { en: 'DE', de: 'DE', it: 'IT' }[cur.lang]; syncRev(); renderClaimLines();
      document.body.classList.remove('ws-approved'); ($('#ws-amend') as HTMLElement).hidden = true;
      $('#ws-state').innerHTML = `<span class="badge draft">● ${J.draft}</span>`;
      $('#ws-status').textContent = '';
