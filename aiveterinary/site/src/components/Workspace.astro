      for (const { h } of hits) { const li = document.createElement('li'); const a = document.createElement('a'); a.href = h.href; a.target = '_blank'; a.rel = 'noopener'; a.textContent = h.title; li.appendChild(a); if (h.draft) { const sp = document.createElement('span'); sp.className = 'pp-hint'; sp.textContent = ` · ${J.handoutDraft}`; li.appendChild(sp); } ul.appendChild(li); }
    }
    function renderAbbr() {
      const list = $('#ws-abbr-list'); list.innerHTML = '';
      const table = { ...DEFAULT_ABBREVIATIONS, ...loadGlossary() };
      const seen = new Map<string, { meaning: string; spans: [number, number][] }>();
      for (const x of findAbbreviations(cur.notes, table)) {
        const k = x.abbr.toLowerCase(); const e = seen.get(k) ?? { meaning: x.meaning, spans: [] }; e.spans.push([x.index, x.index + x.abbr.length]); seen.set(k, e);
      }
      if (!seen.size) { const li = document.createElement('li'); li.className = 'pp-hint'; li.textContent = J.abbrNone; list.appendChild(li); return; }
      for (const [k, e] of seen) {
        const li = document.createElement('li');
