        const input = document.createElement('input'); input.value = e.meaning; input.setAttribute('aria-label', k);
        const btn = document.createElement('button'); btn.type = 'button'; btn.textContent = J.abbrSave; btn.className = 'ws-abbr-save'; btn.hidden = true;
