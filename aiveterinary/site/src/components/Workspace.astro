---
  <section class="wrap" style="padding-top:24px">
    <h1 class="sr-only">{({ en: 'Workspace preview', it: "Anteprima dell'area di lavoro", de: 'Vorschau des Arbeitsbereichs' } as any)[lang]}</h1>
    <p class="eyebrow"><a href={t.vetsHref}>{t.eyebrowLink}</a> · {t.eyebrowRest}</p>
    <div class="ws-top">
      <div>
        <label for="ws-case" class="ws-label">{t.caseLabel}</label>
        <select id="ws-case"></select>
      </div>
      <div>
        <label for="ws-country" class="ws-label">{t.countryLabel}</label>
        <select id="ws-country"><option value="DE">DE</option><option value="IT">IT</option><option value="CH">CH</option><option value="AT">AT</option></select>
      </div>
      <div>
        <label for="ws-doc" class="ws-label">{t.docLabel}</label>
        <select id="ws-doc"><option value="report">{t.docReport}</option><option value="owner">{t.docOwner}</option><option value="referral">{t.docReferral}</option><option value="discharge">{t.docDischarge}</option><option value="rx">{t.docRx}</option><option value="vacc">{t.docVacc}</option><option value="consent">{t.docConsent}</option><option value="estimate">{t.docEstimate}</option><option value="dental">{t.docDental}</option></select>
      </div>
      <div id="ws-lang2-wrap" hidden>
        <label for="ws-lang2" class="ws-label">{t.secondLang}</label>
        <select id="ws-lang2"><option value="">{t.none}</option><option value="en">English</option><option value="it">Italiano</option><option value="de">Deutsch</option></select>
      </div>
      <div id="ws-referral-wrap" hidden>
        <label for="ws-referral" class="ws-label">{t.referralReason}</label>
        <input id="ws-referral" type="text" />
      </div>
      <div>
        <label for="ws-role" class="ws-label">{t.roleLabel}</label>
        <select id="ws-role"><option value="vet">{t.roleVet}</option><option value="nurse">{t.roleNurse}</option></select>
      </div>
      <div class="ws-patient" id="ws-patient"></div>
      <div class="ws-state" id="ws-state"><span class="badge draft">● {j.draft}</span></div>
    </div>
    <p class="notice" style="margin-top:12px" set:html={t.notice} />
  </section>

  <section class="wrap ws" aria-label="Workspace">
    <div class="ws-pane">
      <div class="ws-h">{t.notes} <span class="ws-hint">{t.notesHint}</span></div>
      <pre id="ws-notes" class="ws-notes" tabindex="0"></pre>
      <div class="ws-attach">
        <label class="btn secondary" for="ws-file">{t.attachLabel}</label>
        <input id="ws-file" type="file" accept="image/*,.pdf" multiple class="sr" />
        <span class="ws-hint">{t.attachHint}</span>
        <ul id="ws-attach-list" class="ws-attach-list"></ul>
      </div>
    </div>
    <div class="ws-pane">
      <div class="ws-h">{t.report} <span class="ws-hint" id="ws-lang"></span></div>
      <div id="ws-letterhead" class="ws-letterhead" hidden></div>
      <div id="ws-report" class="ws-report"></div>
    </div>
  </section>

  <section class="wrap">
    <details class="card ws-clinic">
      <summary>{t.clinicTitle}</summary>
      <p class="pp-hint">{t.clinicHint}</p>
      <div class="pp-fields">
        <label>{t.clinicName}<input data-c="name" /></label>
        <label>{t.clinicAddress}<input data-c="address" /></label>
        <label>{t.clinicVet}<input data-c="vet" /></label>
        <label>{t.clinicReg}<input data-c="reg" /></label>
      </div>
      <fieldset class="ws-require">
        <legend>{j.clinicRequire}</legend>
        <p class="pp-hint" id="ws-require-hint">{j.clinicRequireHint}</p>
        <div class="ws-require-list">
          {CLINIC_FIELDS.map((f) => <label><input type="checkbox" data-req={f.id} aria-describedby="ws-require-hint" /> {(j.clinicFields as any)[f.id]}</label>)}
        </div>
      </fieldset>
    </details>
  </section>

  <section class="wrap">
    <div class="card ws-abbr">
      <h2 style="margin-top:0;font-size:1.1rem">{t.abbrTitle}</h2>
      <p class="pp-hint">{t.abbrHint}</p>
      <ul id="ws-abbr-list" class="ws-abbr-list"></ul>
    </div>
  </section>

  <section class="wrap">
    <div class="ws-flags card">
      <h2 style="margin-top:0">{t.before}</h2>
      <ul id="ws-flaglist" class="ws-flaglist"></ul>
      <div class="ws-actions">
        <button class="btn" id="ws-approve" type="button" disabled><Fragment set:html={t.approve} /> <kbd>Ctrl+Shift+Enter</kbd></button>
        <button class="btn secondary" id="ws-amend" type="button" hidden>{(JS[lang] as any).amend}</button>
        <button class="btn secondary" id="ws-copy" type="button">{t.copy} <kbd>Ctrl+Shift+C</kbd></button>
        <button class="btn secondary" id="ws-print" type="button">{t.print}</button>
      </div>
      <p class="pp-status" id="ws-status" aria-live="polite"></p>
      <div class="ws-soap" id="ws-soap" hidden><div class="ws-h">{(JS[lang] as any).soapTitle}</div><p class="pp-hint">{(JS[lang] as any).soapHint}</p><div id="ws-soap-fields" class="ws-soap-fields"></div><button class="btn secondary" id="ws-json" type="button">{(JS[lang] as any).json}</button></div>
      <div class="ws-handouts"><div class="ws-h">{t.handouts}</div><ul id="ws-handouts"></ul></div>
    </div>
  </section>

  <div class="ws-mbar" id="ws-mbar" aria-hidden="true">
    <span class="ws-mbar-status" id="ws-mbar-status"></span>
    <a class="btn secondary sm" href="#ws-flaglist" tabindex="-1">{(JS[lang] as any).mFlags}</a>
    <button class="btn sm" type="button" id="ws-mbar-approve" tabindex="-1">{(JS[lang] as any).mApprove}</button>
  </div>

  <style is:global>
    .ws-top { display: flex; gap: 20px; align-items: flex-end; flex-wrap: wrap; }
    .ws-top > * { min-width: 0; max-width: 100%; }
    .ws-top select { max-width: 100%; }
