---
  <section class="wrap" style="padding-top:24px">
    <h1 class="sr-only">{({ en: 'Workspace preview', it: "Anteprima dell'area di lavoro", de: 'Vorschau des Arbeitsbereichs' } as any)[lang]}</h1>
    <p class="eyebrow"><a href={t.vetsHref}>{t.eyebrowLink}</a> · {t.eyebrowRest}</p>
    <div class="ws-top">
      <div>
        <label for="ws-case" class="ws-label">{t.caseLabel}</label>
        <select id="ws-case"></select>
      </div>
      <div>
        <label for="ws-country" class="ws-label">{t.countryLabel}</label>
        <select id="ws-country"><option value="DE">DE</option><option value="IT">IT</option><option value="CH">CH</option><option value="AT">AT</option></select>
      </div>
      <div>
        <label for="ws-doc" class="ws-label">{t.docLabel}</label>
        <select id="ws-doc"><option value="report">{t.docReport}</option><option value="owner">{t.docOwner}</option><option value="referral">{t.docReferral}</option><option value="discharge">{t.docDischarge}</option><option value="rx">{t.docRx}</option><option value="rev" data-countries="IT" disabled hidden>{t.docRev}</option><option value="vacc">{t.docVacc}</option><option value="consent">{t.docConsent}</option><option value="estimate">{t.docEstimate}</option><option value="dental">{t.docDental}</option><option value="claim">{t.docClaim}</option><option value="bite" data-countries="CH IT" disabled hidden>{n.docBite}</option><option value="registry" data-countries="AT IT" disabled hidden>{n.docRegistry}</option></select>
      </div>
      <!-- CH only, and only for species that can be food-producing (not dog, cat, ferret): the vet's statement. Memory only. -->
      <div id="ws-food-wrap" hidden>
        <label for="ws-food" class="ws-label">{n.foodLabel}</label>
        <select id="ws-food" aria-describedby="ws-food-hint"><option value="">—</option><option value="yes">{n.foodYes}</option><option value="no">{n.foodNo}</option></select>
        <p class="pp-hint ws-food-hint" id="ws-food-hint">{n.foodHint}</p>
      </div>
      <div id="ws-lang2-wrap" hidden>
        <label for="ws-lang2" class="ws-label">{t.secondLang}</label>
        <select id="ws-lang2"><option value="">{t.none}</option><option value="en">English</option><option value="it">Italiano</option><option value="de">Deutsch</option></select>
      </div>
      <div id="ws-referral-wrap" class="ws-referral" hidden>
        <p class="pp-hint" id="ws-ref-from">{t.refFromLetterhead}</p>
        <div class="ws-ref-row">
          <div>
            <label for="ws-ref-urgency" class="ws-label">{t.referralUrgency}</label>
            <select id="ws-ref-urgency"><option value="">—</option><option value="emergency">{t.urgEmergency}</option><option value="urgent">{t.urgUrgent}</option><option value="routine">{t.urgRoutine}</option></select>
          </div>
          <div>
            <label for="ws-ref-service" class="ws-label">{t.referralService}</label>
            <input id="ws-ref-service" type="text" />
          </div>
          <div>
            <label for="ws-referral" class="ws-label">{t.referralReason}</label>
            <input id="ws-referral" type="text" />
          </div>
        </div>
        <fieldset class="ws-ref-owner">
          <legend>{t.refOwnerTitle}</legend>
          <p class="pp-hint" id="ws-ref-owner-hint">{t.refOwnerHint}</p>
          <div class="ws-ref-row">
            <div><label for="ws-ref-owner-name" class="ws-label">{t.refOwnerName}</label><input id="ws-ref-owner-name" type="text" autocomplete="off" aria-describedby="ws-ref-owner-hint" /></div>
            <div><label for="ws-ref-owner-phone" class="ws-label">{t.refOwnerPhone}</label><input id="ws-ref-owner-phone" type="tel" autocomplete="off" aria-describedby="ws-ref-owner-hint" /></div>
            <div><label for="ws-ref-owner-email" class="ws-label">{t.refOwnerEmail}</label><input id="ws-ref-owner-email" type="email" autocomplete="off" aria-describedby="ws-ref-owner-hint" /></div>
          </div>
        </fieldset>
      </div>
      <!-- REV number and PIN exist only after issuing in the official system. Memory only, like the referral owner fields. -->
      <div id="ws-rev-wrap" class="ws-referral" hidden>
        <fieldset class="ws-ref-owner">
          <legend>{t.revIssuedTitle}</legend>
          <p class="pp-hint" id="ws-rev-hint">{t.refOwnerHint}</p>
          <div class="ws-ref-row">
            <div><label for="ws-rev-number" class="ws-label">{t.revNumber}</label><input id="ws-rev-number" type="text" autocomplete="off" spellcheck="false" aria-describedby="ws-rev-hint" /></div>
            <div><label for="ws-rev-pin" class="ws-label">{t.revPin}</label><input id="ws-rev-pin" type="text" inputmode="numeric" autocomplete="off" spellcheck="false" aria-describedby="ws-rev-hint" /></div>
          </div>
        </fieldset>
      </div>
      <!-- Insurance claim: everything typed by the vet for this claim. Memory only, cleared with the case. -->
      <div id="ws-claim-wrap" class="ws-referral" hidden>
        <p class="pp-hint" id="ws-claim-hint">{t.claimHint}</p>
        <div class="ws-ref-row">
          <div><label for="ws-claim-dx" class="ws-label">{t.claimDiagnosis}</label><input id="ws-claim-dx" type="text" autocomplete="off" aria-describedby="ws-claim-hint" /></div>
          <div><label for="ws-claim-first" class="ws-label">{t.claimFirst}</label><input id="ws-claim-first" type="date" autocomplete="off" aria-describedby="ws-claim-hint" /></div>
          <div><label for="ws-claim-pre" class="ws-label">{t.claimPre}</label><select id="ws-claim-pre" aria-describedby="ws-claim-hint"><option value="">—</option><option value="yes">{t.claimYes}</option><option value="no">{t.claimNo}</option><option value="unknown">{t.claimUnknown}</option></select></div>
        </div>
        <fieldset class="ws-ref-owner">
          <legend>{t.claimLines}</legend>
          <div id="ws-claim-lines" class="ws-claim-lines"></div>
          <button type="button" class="btn secondary sm" id="ws-claim-add">{t.claimAdd}</button>
        </fieldset>
      </div>
      <!-- Bite report (CH, IT): everything typed by the vet for this letter. Memory only, cleared with the case. -->
      <div id="ws-bite-wrap" class="ws-referral" hidden>
        <p class="pp-hint" id="ws-bite-hint">{n.memHint}</p>
        <div class="ws-ref-row">
          <div><label for="ws-bite-to" class="ws-label">{n.biteTo}</label><input id="ws-bite-to" type="text" autocomplete="off" aria-describedby="ws-bite-hint" /></div>
          <div><label for="ws-bite-reason" class="ws-label">{n.biteReason}</label><select id="ws-bite-reason" aria-describedby="ws-bite-hint"><option value="">—</option><option value="injury_person">{n.reasonPerson}</option><option value="injury_animal">{n.reasonAnimal}</option><option value="aggression">{n.reasonAggression}</option></select></div>
          <div><label for="ws-bite-role" class="ws-label">{n.biteRole}</label><select id="ws-bite-role" aria-describedby="ws-bite-hint"><option value="">—</option><option value="biting_dog">{n.roleBiting}</option><option value="injured_animal">{n.roleInjured}</option></select></div>
        </div>
        <fieldset class="ws-ref-owner">
          <legend>{n.biteIncidentTitle}</legend>
          <div class="ws-ref-row">
            <div><label for="ws-bite-date" class="ws-label">{n.biteDate}</label><input id="ws-bite-date" type="date" autocomplete="off" aria-describedby="ws-bite-hint" /></div>
            <div><label for="ws-bite-place" class="ws-label">{n.bitePlace}</label><input id="ws-bite-place" type="text" autocomplete="off" aria-describedby="ws-bite-hint" /></div>
            <div><label for="ws-bite-what" class="ws-label">{n.biteWhat}</label><input id="ws-bite-what" type="text" autocomplete="off" aria-describedby="ws-bite-hint" /></div>
          </div>
        </fieldset>
        <fieldset class="ws-ref-owner">
          <legend>{n.biteInjuredTitle}</legend>
          <div class="ws-ref-row">
            <div><label for="ws-bite-injury" class="ws-label">{n.biteInjury}</label><input id="ws-bite-injury" type="text" autocomplete="off" aria-describedby="ws-bite-hint" /></div>
            <div><label for="ws-bite-severity" class="ws-label">{n.biteSeverity}</label><input id="ws-bite-severity" type="text" autocomplete="off" aria-describedby="ws-bite-hint" /></div>
            <div><label for="ws-bite-kind" class="ws-label">{n.biteKind}</label><select id="ws-bite-kind" aria-describedby="ws-bite-hint"><option value="">—</option><option value="person">{n.kindPerson}</option><option value="animal">{n.kindAnimal}</option></select></div>
            <div><label for="ws-bite-name" class="ws-label">{n.biteInjuredName}</label><input id="ws-bite-name" type="text" autocomplete="off" aria-describedby="ws-bite-hint" /></div>
            <div id="ws-bite-consent-wrap" hidden><label for="ws-bite-consent" class="ws-label">{n.biteConsent}</label><select id="ws-bite-consent" aria-describedby="ws-bite-hint"><option value="">—</option><option value="yes">{n.yes}</option><option value="no">{n.no}</option></select></div>
          </div>
        </fieldset>
        <fieldset class="ws-ref-owner" id="ws-bite-obs" hidden>
          <legend>{n.biteObsTitle}</legend>
          <div class="ws-ref-row">
            <div><label for="ws-bite-obs-start" class="ws-label">{n.biteObsStart}</label><input id="ws-bite-obs-start" type="date" autocomplete="off" aria-describedby="ws-bite-hint" /></div>
            <div><label for="ws-bite-obs-end" class="ws-label">{n.biteObsEnd}</label><input id="ws-bite-obs-end" type="date" autocomplete="off" aria-describedby="ws-bite-hint" /></div>
          </div>
        </fieldset>
      </div>
      <!-- Registry entry (AT-HDB, IT-SINAC): the event and the fields that registry asks for it, typed by the vet. Memory only. -->
      <div id="ws-reg-wrap" class="ws-referral" hidden>
        <p class="pp-hint" id="ws-reg-hint">{n.memHint}</p>
        <div class="ws-ref-row">
          <div><label for="ws-reg-event" class="ws-label">{n.regEvent}</label><select id="ws-reg-event" aria-describedby="ws-reg-hint">{Object.entries(n.events).map(([k, v]) => <option value={k}>{v}</option>)}</select></div>
