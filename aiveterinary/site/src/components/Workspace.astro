    }
    $('#ws-claim-add').addEventListener('click', () => { claimLines.push(blankLine()); renderClaimLines(claimLines.length - 1); if (cur) render(); });
    function resetCaseInputs() {
      for (const el of [...refCaseInputs, revNum, revPin, claimDx, claimFirst]) el.value = ''; refUrg.value = ''; claimPre.value = '';
      claimLines = [blankLine()]; renderClaimLines();
    }
    const visitCtx = () => VisitContext.parse({ country: csel.value, author: clinicAuthor() });
    function claimOpts(approved: boolean): ClaimOpts {
      const c = loadClinic(); const de = csel.value === 'DE';
      const s = (x: unknown) => (typeof x === 'string' && x.trim() ? x.trim() : null);
      const pre = ({ yes: true, no: false, unknown: 'unknown' } as Record<string, boolean | 'unknown'>)[claimPre.value];
      return {
        approved,
        diagnosis: s(claimDx.value), first_symptom_date: s(claimFirst.value), pre_existing: pre ?? null,
        practice: { name: s(c.name), address: s(c.address) },
        invoice: { lines: claimLines.map((l) => ({ date: null, description: l.desc, got_number: de ? s(l.got) : null, factor: de ? s(l.factor) : null, amount: s(l.amount) })) },
