      for (const it of spanItems(record)) {
        const e = esc(it.text);
        html = html.replace(new RegExp(`(?<![\\w-])${escRe(e)}(?![\\w-])`), `<span class="src" data-spans='${JSON.stringify(it.spans)}'>${e}</span>`);
      }
      if (cur.files.length) html += `<h2>${esc(J.attachments)}</h2><ul>${cur.files.map((f) => `<li>${esc(f.name)}</li>`).join('')}</ul>`;
      $('#ws-report').innerHTML = html;
      renderAttachments();
      for (const s of document.querySelectorAll<HTMLElement>('.ws-report .src')) {
        s.addEventListener('mouseenter', () => light(JSON.parse(s.dataset.spans!), true));
        s.addEventListener('mouseleave', () => light(JSON.parse(s.dataset.spans!), false));
        s.addEventListener('click', () => { light(JSON.parse(s.dataset.spans!), true); setTimeout(() => light(JSON.parse(s.dataset.spans!), false), 1500); });
      }
      document.querySelectorAll<HTMLInputElement>('.ws-med-tick').forEach((cb) => cb.addEventListener('change', () => { cur.meds[Number(cb.dataset.i)] = cb.checked; renderFlags(); }));
      // owner-reported vs vet-observed: one click flips a history line; the renderer then drops or adds the prefix
      if (!cur.approved) for (const h of record.history) {
        const needle = `${h.finding}: ${h.value}`;
        const li = Array.from(document.querySelectorAll<HTMLElement>('.ws-report li')).find((el) => el.textContent?.includes(needle));
        if (!li) continue;
        const b = document.createElement('button'); b.type = 'button'; b.className = 'ws-role-toggle';
        const owner = h.source_role === 'owner_reported';
        b.textContent = owner ? J.roleToVet : J.roleToOwner; b.title = owner ? J.toVet : J.toOwner; b.setAttribute('aria-label', b.title);
        b.addEventListener('click', () => {
          const at = Array.from(document.querySelectorAll('.ws-role-toggle')).indexOf(b);
          h.source_role = owner ? 'vet_observed' : 'owner_reported'; render();
          document.querySelectorAll<HTMLElement>('.ws-role-toggle')[at]?.focus();
        });
        li.appendChild(b);
      }
      renderFlags();
      renderAbbr();
      renderLetterhead();
      renderHandouts();
      trackDoc();
    }

    function light(spans: [number, number][], on: boolean) {
      for (const [a, b] of spans) for (let i = a; i < b; i++) document.querySelector(`#ws-notes mark[data-i="${i}"]`)?.classList.toggle('on', on);
    }

    function renderFlags() {
      const { notes, header, record } = cur;
      const findings: Finding[] = validateAll(record, notes, header);
      const blocks = findings.filter((f) => f.severity === 'block');
      const warns = findings.filter((f) => f.severity === 'warn');
      const ctx = visitCtx();
      const cflags = countryMissing(record, header, ctx, J.pageLang);
      const reasons: Record<string, string> = {}; for (const f of cflags) reasons[f.field] = f.reason;
      const clinic = clinicMissing(record, clinicRequired(), { lang: J.pageLang, header });
      for (const f of clinic) reasons[f.field] ??= f.reason;
      const missing = [...requiredMissing(record, 'consult_report', header), ...cflags.map((f) => f.field), ...clinic.map((f) => f.field)].filter((f, i, a) => a.indexOf(f) === i);
      const list = $('#ws-flaglist'); list.innerHTML = '';
      const li = (html: string) => { const el = document.createElement('li'); el.innerHTML = html; list.appendChild(el); return el; };
      for (const b of blocks) li(`<span class="f-block">${J.blocked}</span> ${esc(b.field)}: ${esc(b.message)}`);
      for (const w of warns) li(`<span class="f-warn">${J.check}</span> ${esc(w.field)}: ${esc(w.message)}`);
      for (const m of missing) {
        const done = cur.resolved[m];
        const el = li(`<span class="f-miss">${done ? '✓' : '▲'} ${J.missing}</span> <code>${esc(m)}</code> ${reasons[m] ? `<span class="ws-hint">${esc(reasons[m])}</span> ` : ''}${done ? `<em>${esc(done)}</em>` : ''}`);
        if (!done) {
          const input = document.createElement('input'); input.placeholder = J.placeholder; input.setAttribute('aria-label', `${J.valueFor} ${m}`);
          const add = document.createElement('button'); add.textContent = J.add; add.type = 'button';
          const nr = document.createElement('button'); nr.textContent = J.notRecorded; nr.type = 'button';
          add.addEventListener('click', () => { if (input.value.trim()) { cur.resolved[m] = input.value.trim(); renderFlags(); focusNextFlag(); } });
          input.addEventListener('keydown', (e) => { if (e.key === 'Enter') add.click(); });
          nr.addEventListener('click', () => { cur.resolved[m] = J.notRecorded; renderFlags(); focusNextFlag(); });
          el.append(input, add, nr);
        }
      }
      // Referral question: outside the record, so not in requiredMissing and not blocking approval;
      // shown in the same missing style while the referral letter is the document on screen.
      const refQuestionMissing = dsel.value === 'referral' && !refIn.value.trim();
      if (refQuestionMissing) {
        const el = li(`<span class="f-miss">▲ ${J.missing}</span> <code>referral.reason</code> <span class="ws-hint">${esc(J.refQuestionMissing)}</span> `);
        const go = document.createElement('button'); go.type = 'button'; go.textContent = J.refQuestionGo;
        go.addEventListener('click', () => refIn.focus());
        el.append(go);
      }
      // REV draft and insurance claim: their own missing fields (outside the record) in the same missing style while
      // the document is on screen. Like the referral question they do not block approval: they are completed on the
      // official system or the insurer's form. REV lists what is required or conditional; optional items stay in the draft.
      // Bite report and registry entry follow the same rule: their missing fields are listed while they are on screen and
      // do not block approval (the vet completes them on the office's form or in the registry).
      const docMissing: string[] = dsel.value === 'claim' ? claimPack(cur.approved).missing as string[]
        : dsel.value === 'rev' && csel.value === 'IT' ? revDraft().missing.filter((m) => m.requirement !== 'facoltativo').map((m) => m.field)
        : dsel.value === 'bite' && biteOk() ? bitePack(cur.approved).missing
        : dsel.value === 'registry' && REGISTRY[csel.value] ? regEntry(cur.approved).missing : [];
      if (docMissing.length) {
        const hint = ({ claim: J.docMissingClaim, rev: J.docMissingRev, bite: J.n.docMissingBite, registry: J.n.docMissingRegistry } as Record<string, string>)[dsel.value];
        const el = li(`<span class="f-miss">▲ ${J.missing}</span> ${docMissing.map((f) => `<code>${esc(f)}</code>`).join(', ')} <span class="ws-hint">${esc(hint)}</span> `);
        const panel = ({ claim: '#ws-claim-wrap', bite: '#ws-bite-wrap', registry: '#ws-reg-wrap' } as Record<string, string>)[dsel.value];
        if (panel) {
          const go = document.createElement('button'); go.type = 'button'; go.textContent = J.docMissingGo;
          go.addEventListener('click', () => {
            if (dsel.value === 'claim') { claimDx.focus(); return; }
            // the first visible empty field of the panel, else its first field
            const els = [...$(panel).querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select')].filter((x) => !x.closest('[hidden]'));
            (els.find((x) => !x.value) ?? els[0])?.focus();
          });
          el.append(go);
        }
      }
      for (const u of record.uncertain) li(`<span class="f-warn">${J.setAside}</span> “${esc(u.original_text)}” — ${esc(u.reason)}`);
      if (!blocks.length && !warns.length && !missing.length && !record.uncertain.length && !refQuestionMissing && !docMissing.length) li(`<span style="color:var(--ok);font-weight:600">${J.nothing}</span> ${J.nothingRest}`);
      let identityProblems = 0;
      {
        const ctx = visitCtx();
        const docsAll: Record<string, string> = { report: renderConsultReport(record, header, cur.lang), owner: renderOwnerSummary(record, header, cur.lang), referral: renderReferralLetter(record, header, cur.lang), discharge: renderDischargeLetter(record, header, cur.lang), rx: renderPrescription(record, header, ctx, cur.lang) };
        const l2 = ($('#ws-lang2') as HTMLSelectElement).value as any; if (l2 && l2 !== cur.lang) docsAll[`owner_${l2}`] = renderOwnerSummary(record, header, l2);
        if (record.medications.some((m: any) => m.status !== 'declined')) {
          // The claim prints the shared medication table for the medications given today (dispensed, prescribed,
          // performed), so it is checked against exactly those. The REV draft is not included: it is a transcription
          // checklist that joins dose, route and frequency into one "posologia" line, prints only drug and quantity for
          // stock dispensing and lists administered/declined items by name only, so a string-identity check would
          // report differences that are by design. Its values come from the same record fields (see rev.ts provenance).
          // The bite report and the registry entry print no medication table (the bite letter lists performed treatments
          // as the record's sentences; the registry lists no medicines), so there is nothing for this check to compare.
          const pack = claimPack(false);
          const probs = [...crossDocumentMedicationCheck(record, docsAll), ...crossDocumentMedicationCheck({ ...record, medications: pack.clinical.medications }, { claim: renderClaimSummary(pack, J.pageLang) })]; identityProblems = probs.length;
          li(probs.length ? `<span class="f-block">${J.blocked}</span> ${esc(J.identityFail)} ${esc(probs.map((p) => `${p.doc}: ${p.field} "${p.value}"`).join('; '))}` : `<span style="color:var(--ok);font-weight:600">✓</span> ${esc(J.identityOk)}`);
        }
      }
      const unresolved = missing.filter((m) => !cur.resolved[m]).length;
      const unticked = record.medications.filter((_, i) => !cur.meds[i]).length;
      ($('#ws-approve') as HTMLButtonElement).disabled = cur.approved || blocks.length > 0 || identityProblems > 0 || unresolved > 0 || unticked > 0;
      $('#ws-status').textContent = cur.approved ? J.approvedStatus : blocks.length ? J.blocking.replace('{n}', String(blocks.length)) : unresolved ? J.unresolved.replace('{n}', String(unresolved)) : unticked ? J.medsUnchecked.replace('{n}', String(unticked)) : J.ready;
    }

    // The flag list is rebuilt on every change: keep keyboard focus on the next thing to do.
    function focusNextFlag() {
      const approveEl = $('#ws-approve') as HTMLButtonElement;
      (($('#ws-flaglist input') as HTMLElement | null) ?? ($('.ws-med-tick:not(:checked)') as HTMLElement | null) ?? (approveEl.disabled ? null : approveEl))?.focus();
    }
    const focusLost = () => !document.activeElement || document.activeElement === document.body;
    function approve() {
      if (($('#ws-approve') as HTMLButtonElement).disabled) return;
      const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      if (rsel.value === 'nurse') {
        // A nurse or assistant prepares the draft; only a veterinarian can approve.
        cur.handed = true;
        $('#ws-state').innerHTML = `<span class="badge draft">● ${J.nurseDraft} · ${time}</span>`;
        $('#ws-status').textContent = J.handedStatus;
        return;
      }
      const secs = Math.round((Date.now() - cur.started) / 1000);
      const who = clinicAuthor().name;
      let staleNote = '';
      if (!cur.v) cur.v = approveVersion(cur.record, who);
      else {
        const reason = window.prompt(J.amendReason.replace('{n}', String(cur.v.version + 1)), '');
        if (reason === null) return;
        try { cur.v = amendVersion(cur.v, cur.record, who, reason); }
        catch (e: any) { $('#ws-status').textContent = /^Nothing changed/.test(e.message) ? J.noChange : e.message; return; }
        const { stale } = propagationMap(cur.v, cur.docs);
        staleNote = stale.length ? J.staleDocs.replace('{list}', [...new Set(stale.map((d) => d.kind))].join(', ')) : J.noStale;
      }
      cur.approved = true; document.body.classList.add('ws-approved');
      $('#ws-state').innerHTML = `<span class="badge reviewed">✓ ${J.approved} ${J.version.replace('{n}', String(cur.v.version))}${cur.handed ? ` (${J.cosigned})` : ''} · ${time} · ${J.timer}: ${Math.floor(secs / 60)}:${String(secs % 60).padStart(2, '0')}</span>`;
      ($('#ws-amend') as HTMLElement).hidden = false;
      render();
      if (focusLost()) ($('#ws-amend') as HTMLElement).focus();
      if (staleNote) $('#ws-status').textContent = staleNote;
    }
    function trackDoc() {
      if (!cur.approved || !cur.v) return;
      const kind = dsel.value;
      const lang = docLang();
      if (!cur.docs.some((d) => d.kind === kind && d.lang === lang && d.from_version === cur.v!.version)) cur.docs.push(documentFrom(cur.v, kind, lang));
    }
    $('#ws-amend').addEventListener('click', () => {
      if (!cur.v) return;
      cur.approved = false; document.body.classList.remove('ws-approved');
      $('#ws-state').innerHTML = `<span class="badge draft">● ${J.amending.replace('{n}', String(cur.v.version + 1))}</span>`;
      ($('#ws-amend') as HTMLElement).hidden = true;
      render();
      if (focusLost()) focusNextFlag();
    });
    function copyOut() {
      const md = renderDoc(cur.approved);
      const txt = dsel.value === 'rev' ? md : md
        .replace(/^#+ (.*)$/gm, (_m, h) => h.toUpperCase()).replace(/^_|_$/gm, '').replace(/\*\*/g, '').replace(/\|/g, ' ').replace(/^ *-{3,}.*$/gm, '').replace(/\n{3,}/g, '\n\n');
      navigator.clipboard?.writeText(txt).then(() => { $('#ws-status').textContent = J.copied; }, () => { $('#ws-status').textContent = J.copyFail; });
    }
    function renderSoap() {
      const box = $('#ws-soap') as HTMLElement;
      box.hidden = !(cur.approved && cur.v);
      if (box.hidden) return;
      const fields = soapFields(cur.v!.record, cur.lang, cur.resolved);
      $('#ws-soap-fields').innerHTML = fields.map((f, i) => `<div class="ws-soap-f"><div class="ws-soap-h"><strong>${esc(f.label)}</strong> <button class="btn secondary sm" type="button" data-i="${i}">${esc(J.soapCopy)}</button></div><pre>${esc(f.text)}</pre></div>`).join('');
      $('#ws-soap-fields').querySelectorAll<HTMLButtonElement>('button[data-i]').forEach((b) => b.addEventListener('click', () => {
        const f = fields[Number(b.dataset.i)];
        navigator.clipboard?.writeText(f.text).then(() => { $('#ws-status').textContent = J.soapCopied.replace('{label}', f.label); }, () => { $('#ws-status').textContent = J.copyFail; });
      }));
    }
    $('#ws-json').addEventListener('click', () => {
      if (!cur.approved || !cur.v) return;
      const bundle = exportBundle(cur.v, cur.header, cur.lang, undefined, cur.resolved);
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([JSON.stringify(bundle, null, 2)], { type: 'application/json' }));
      a.download = `${String(cur.header.name || 'record').replace(/[^\p{L}\p{N}_-]+/gu, '-')}-v${cur.v.version}.json`;
      a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    });
    $('#ws-approve').addEventListener('click', approve);
    // Phone bar: a mirror of the status line and the real Approve button, so the rules are identical.
    // It is hidden from assistive tech, which reaches the same controls in the page.
    const mirror = () => {
      const real = $('#ws-approve') as HTMLButtonElement;
      $('#ws-mbar-status').textContent = $('#ws-status').textContent;
      ($('#ws-mbar-approve') as HTMLButtonElement).disabled = real.disabled || !seenEnd;
      $('#ws-mbar').classList.toggle('is-approved', cur.approved);
    };
    // Approving from the bar only after the end of the report has been on screen once: read first, then sign.
    let seenEnd = false;
    new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { seenEnd = true; mirror(); } }).observe($('#ws-flaglist'));
    new MutationObserver(mirror).observe($('#ws-status'), { childList: true, characterData: true, subtree: true });
    new MutationObserver(mirror).observe($('#ws-approve'), { attributes: true, attributeFilter: ['disabled'] });
    $('#ws-mbar-approve').addEventListener('click', () => { approve(); mirror(); });
    $('#ws-copy').addEventListener('click', copyOut);
    $('#ws-print').addEventListener('click', () => window.print());
    document.addEventListener('keydown', (e) => {
      if (e.ctrlKey && e.shiftKey && e.key === 'Enter') { e.preventDefault(); approve(); }
      if (e.ctrlKey && e.shiftKey && (e.key === 'C' || e.key === 'c')) { e.preventDefault(); copyOut(); }
    });

    const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
    const escRe = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    function table(block: string) {
      const rows = block.trim().split('\n').filter((r) => !/^\|\s*-/.test(r)).map((r) => r.slice(1, -1).split('|').map((c) => c.trim()));
      const [head, ...body] = rows;
      const isMeds = ['Drug', 'Wirkstoff', 'Farmaco'].includes(head[0]);
      if (!isMeds) return `<table><thead><tr>${head.map((h) => `<th>${h}</th>`).join('')}</tr></thead><tbody>${body.map((r) => `<tr>${r.map((c) => `<td>${c}</td>`).join('')}</tr>`).join('')}</tbody></table>`;
      // Some documents print a subset of the medications (discharge: to give at home; claim: given today), so each row
      // is matched to its record medication by the drug cell, in order; the tick then belongs to that medication.
      const used = new Set<number>();
      const recIdx = body.map((r, i) => {
        const j = cur.record.medications.findIndex((m: any, k: number) => !used.has(k) && !!(m.drug ?? m.class_as_written) && r[0].startsWith(m.drug ?? m.class_as_written));
        const k = j >= 0 ? j : i; used.add(k); return k;
      });
      const tick = (i: number) => `<td class="ws-tick"><label><input type="checkbox" class="ws-med-tick" data-i="${i}" ${cur.meds[i] ? 'checked' : ''} ${cur.approved ? 'disabled' : ''} aria-label="${J.medsTick}"> ${J.medsTick}</label></td>`;
      return `<table><thead><tr>${head.map((h) => h ? `<th>${h}</th>` : `<th><span class="sr-only">Status</span></th>`).join('')}<th>${J.medsTick}</th></tr></thead><tbody>${body.map((r, i) => `<tr>${r.map((c) => `<td>${c}</td>`).join('')}${tick(recIdx[i])}</tr>`).join('')}</tbody></table>`;
    }

    const fileInput = $('#ws-file') as HTMLInputElement;
    fileInput.addEventListener('change', () => {
      for (const f of Array.from(fileInput.files ?? [])) cur.files.push({ name: f.name, size: f.size, type: f.type });
      fileInput.value = ''; render();
    });
    load(J.first);
  </script>
