  <script type="application/json" id="ws-i18n" set:html={JSON.stringify({ ...j, pageLang: lang, abbrNone: t.abbrNone, abbrSave: t.abbrSave, handouts: t.handouts, handoutsNone: t.handoutsNone, timer: t.timer, identityOk: t.identityOk, identityFail: t.identityFail, refQuestionMissing: t.refQuestionMissing, refQuestionGo: t.refQuestionGo, handoutIndex, n })} />

  <script>
    import { ClinicalRecord, PatientHeader, type ClinicalRecord as Rec } from 'aiveterinary-app/src/schema.ts';
    import { normalizeNotes, findAbbreviations, DEFAULT_ABBREVIATIONS } from 'aiveterinary-app/src/normalize.ts';
    import { validateAll, requiredMissing, type Finding } from 'aiveterinary-app/src/validators.ts';
    import { renderConsultReport, renderOwnerSummary, renderReferralLetter, renderDischargeLetter, renderPrescription, renderVaccinationEntry, renderConsentForm, renderCostEstimate, renderDentalChart, renderOwnerSummaryBilingual, crossDocumentMedicationCheck } from 'aiveterinary-app/src/render.ts';
    import { countryMissing, VisitContext } from 'aiveterinary-app/src/country.ts';
    import { buildRevDraft, renderRevDraftText } from 'aiveterinary-app/src/rev.ts';
    import { buildClaimPack, renderClaimSummary, type ClaimOpts } from 'aiveterinary-app/src/claim.ts';
    import { buildBiteReport, renderBiteReport, type BiteReportOpts } from 'aiveterinary-app/src/bite-report.ts';
    import { buildRegistryEntry, renderRegistryEntry, type Registry, type RegistryEvent, type RegistryOpts } from 'aiveterinary-app/src/registry-export.ts';
    import { clinicMissing } from 'aiveterinary-app/src/clinic-required.ts';
    import { soapFields, exportBundle } from 'aiveterinary-app/src/export.ts';
    import { approve as approveVersion, amend as amendVersion, documentFrom, propagationMap, type ApprovedVersion, type GeneratedDocument } from 'aiveterinary-app/src/versions.ts';
    import c1 from 'aiveterinary-app/eval/cases/001-luna-vomiting.json';
    import c2 from 'aiveterinary-app/eval/cases/002-milo-otitis-de.json';
    import c3 from 'aiveterinary-app/eval/cases/003-gatto-inappetenza-it.json';
    import c4 from 'aiveterinary-app/eval/cases/004-adversarial-pregnant-owner.json';
    import c6 from 'aiveterinary-app/eval/cases/006-adversarial-dose-not-given.json';
    import c7 from 'aiveterinary-app/eval/cases/007-adversarial-de-decimal-comma.json';
    import c8 from 'aiveterinary-app/eval/cases/008-adversarial-it-performed-vs-planned.json';
    import c9 from 'aiveterinary-app/eval/cases/009-adversarial-other-pet.json';
    import c10 from 'aiveterinary-app/eval/cases/010-vaccination-visit.json';
    import c11 from 'aiveterinary-app/eval/cases/011-dental-de-triadan.json';
    import c173 from 'aiveterinary-app/eval/cases/173-gen-horse-colic-de.json';

    type Case = { id: string; language: 'en' | 'de' | 'it'; header: any; notes: string; fixture_record: any };
    const cases = [c1, c2, c3, c4, c6, c7, c8, c9, c10, c11, c173] as Case[];
    const J = JSON.parse(document.getElementById('ws-i18n')!.textContent!);
    const CLINIC_KEY = 'aiveterinary.clinic.v1';
    const loadClinic = (): Record<string, any> => { try { return JSON.parse(localStorage.getItem(CLINIC_KEY) ?? '{}'); } catch { return {}; } };
    const clinicAuthor = () => { const c = loadClinic(); return { name: c.vet || 'Dr. Demo', registration: c.reg || null }; };
    function renderLetterhead() {
      const c = loadClinic(); const el = $('#ws-letterhead') as HTMLElement;
      const lines = [c.name, [c.address, c.email].filter(Boolean).join(' · '), [c.vet, c.reg].filter(Boolean).join(' · ')].filter(Boolean);
      el.hidden = lines.length === 0; el.innerHTML = lines.map((l, i) => `<div class="${i === 0 ? 'lh-name' : ''}">${esc(l)}</div>`).join('');
    }
    for (const input of document.querySelectorAll<HTMLInputElement>('.ws-clinic [data-c]')) {
      input.value = loadClinic()[input.dataset.c!] ?? '';
      input.addEventListener('input', () => { const c = loadClinic(); c[input.dataset.c!] = input.value.trim(); try { localStorage.setItem(CLINIC_KEY, JSON.stringify(c)); } catch {} renderLetterhead(); if (cur) render(); });
    }
    // Clinic-required fields: stored with the letterhead. They only ever add a flag for an absent field.
    const clinicRequired = (): string[] => { const r = loadClinic().required; return Array.isArray(r) ? r.filter((x: unknown) => typeof x === 'string') : []; };
    for (const cb of document.querySelectorAll<HTMLInputElement>('.ws-clinic [data-req]')) {
      cb.checked = clinicRequired().includes(cb.dataset.req!);
      cb.addEventListener('change', () => {
        const c = loadClinic(); const set = new Set(clinicRequired());
        if (cb.checked) set.add(cb.dataset.req!); else set.delete(cb.dataset.req!);
        c.required = [...set]; try { localStorage.setItem(CLINIC_KEY, JSON.stringify(c)); } catch {}
        if (cur) render();
      });
    }
    const GLOSSARY_KEY = 'aiveterinary.glossary.v1';
    const loadGlossary = (): Record<string, string> => { try { return JSON.parse(localStorage.getItem(GLOSSARY_KEY) ?? '{}'); } catch { return {}; } };
    const saveGlossary = (g: Record<string, string>) => { try { localStorage.setItem(GLOSSARY_KEY, JSON.stringify(g)); } catch {} };
    function renderAttachments() {
      const ul = $('#ws-attach-list'); ul.innerHTML = '';
      for (const f of cur.files) { const li = document.createElement('li'); li.textContent = `${f.name} · ${Math.max(1, Math.round(f.size / 1024))} KB`; ul.appendChild(li); }
    }
    function renderHandouts() {
      const ul = $('#ws-handouts'); ul.innerHTML = '';
      const text = [cur.record.assessment.text ?? '', ...cur.record.assessment.differentials.map((d: any) => d.text), cur.record.presenting_complaint?.text ?? ''].join(' ').toLowerCase();
      const words = text.split(/[^a-zäöüßàèéìòù]+/).filter((w) => w.length > 4);
      const species = cur.header.species;
      const hits = (J.handoutIndex as { title: string; href: string; species: string; draft: boolean }[])
        .filter((h) => h.species === species || h.species === 'general')
        .map((h) => ({ h, score: words.filter((w) => h.title.toLowerCase().includes(w)).length }))
        .filter((x) => x.score > 0).sort((a, b) => b.score - a.score).slice(0, 3);
      if (!hits.length) { const li = document.createElement('li'); li.className = 'pp-hint'; li.textContent = J.handoutsNone; ul.appendChild(li); return; }
      for (const { h } of hits) { const li = document.createElement('li'); const a = document.createElement('a'); a.href = h.href; a.target = '_blank'; a.rel = 'noopener'; a.textContent = h.title; li.appendChild(a); if (h.draft) { const sp = document.createElement('span'); sp.className = 'pp-hint'; sp.textContent = ` · ${J.handoutDraft}`; li.appendChild(sp); } ul.appendChild(li); }
    }
    function renderAbbr() {
      const list = $('#ws-abbr-list'); list.innerHTML = '';
      const table = { ...DEFAULT_ABBREVIATIONS, ...loadGlossary() };
      const seen = new Map<string, { meaning: string; spans: [number, number][] }>();
      for (const x of findAbbreviations(cur.notes, table)) {
        const k = x.abbr.toLowerCase(); const e = seen.get(k) ?? { meaning: x.meaning, spans: [] }; e.spans.push([x.index, x.index + x.abbr.length]); seen.set(k, e);
      }
      if (!seen.size) { const li = document.createElement('li'); li.className = 'pp-hint'; li.textContent = J.abbrNone; list.appendChild(li); return; }
      for (const [k, e] of seen) {
        const li = document.createElement('li');
        const code = document.createElement('code'); code.textContent = k; li.appendChild(code);
        const input = document.createElement('input'); input.value = e.meaning; input.setAttribute('aria-label', k);
        const btn = document.createElement('button'); btn.type = 'button'; btn.textContent = J.abbrSave; btn.className = 'ws-abbr-save'; btn.hidden = true;
        input.addEventListener('input', () => { btn.hidden = input.value.trim() === e.meaning; });
