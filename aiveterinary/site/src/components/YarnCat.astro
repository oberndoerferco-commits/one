---
/** Loading indicator: the cat from the icon set batting a ball of yarn. SVG + CSS, respects reduced motion. */
import { ICONS } from '../lib/animal-icons';
interface Props { label?: string; size?: number; class?: string }
const { label = 'Loading…', size = 128, class: cls = '' } = Astro.props;
const scene = `
<ellipse cx="44" cy="70" rx="20" ry="14" fill="var(--ic-soft)"/>
<path d="M62 76c8 2 12-4 8-10"/>
<g transform="translate(22 24)">${ICONS.cat}</g>
<g class="yc-paw"><path d="M60 66c6 0 10-3 13-7"/><ellipse cx="74" cy="58" rx="3.2" ry="2.4" fill="var(--ic-soft)"/></g>
<g class="yc-ball"><circle cx="96" cy="70" r="12" fill="var(--coral-soft)"/><path d="M86 64c6 2 14 2 20 0M85 72c7 3 15 3 22 0M90 60c3 6 3 14 0 20M102 60c-3 6-3 14 0 20"/></g>
<path class="yc-strand" d="M108 70c8-2 14 2 16 8"/>
<path d="M10 86h110" stroke-width="1.6"/>
`;
---
<div class={`yarn-cat ${cls}`} role="status" aria-live="polite">
  <svg width={size} height={size * 0.75} viewBox="0 0 128 96" fill="none" stroke="var(--ink)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <Fragment set:html={scene} />
  </svg>
  <span class="yc-label">{label}</span>
</div>

<style is:global>
  .yarn-cat { display: inline-flex; flex-direction: column; align-items: center; gap: 6px; }
  .yc-label { font-size: .9rem; color: var(--ink-3); }
  .yc-ball { transform-origin: 96px 70px; animation: yc-roll 1.6s ease-in-out infinite; }
  .yc-paw { transform-origin: 60px 66px; animation: yc-bat 1.6s ease-in-out infinite; }
  .yc-strand { stroke-dasharray: 30; animation: yc-strand 1.6s ease-in-out infinite; }
  @keyframes yc-roll { 0%, 100% { transform: translateX(0) rotate(0deg); } 50% { transform: translateX(10px) rotate(40deg); } }
  @keyframes yc-bat { 0%, 70%, 100% { transform: rotate(0deg); } 80% { transform: rotate(-25deg); } 90% { transform: rotate(10deg); } }
  @keyframes yc-strand { 0%, 100% { stroke-dashoffset: 0; } 50% { stroke-dashoffset: 8; } }
  @media (prefers-reduced-motion: reduce) { .yc-ball, .yc-paw, .yc-strand { animation: none; } }
</style>
