---
import { getCollection } from 'astro:content';
import { ANIMALS, slugOf, type Lang } from '../lib/animals-i18n';
import AnimalIcon from './AnimalIcon.astro';
import HeroScene from './HeroScene.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ANIMALS[lang];
const all = (await getCollection('animals')).filter((e) => e.data.lang === lang).sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());
const count = (f: (d: any) => boolean) => all.filter((e) => f(e.data)).length;
---
<section class="wrap hero hero-split">
  <div>
    <h1>{t.title}</h1>
    <p class="lead">{t.lead}</p>
    <div id="site-search" class="site-search" data-lang={lang}></div>
    <p><a class="btn secondary" href={t.visitBrief}>{t.prepare}</a></p>
  </div>
  <div class="hero-side"><HeroScene /></div>
</section>
<section class="wrap"><div class="notice danger"><p set:html={t.emergency} /></div></section>

<section class="wrap">
  <h2>{t.byAnimal}</h2>
  <div class="animal-buttons">
    {Object.entries(t.species).map(([key, label]) => (
      <a class="animal-btn" href={`${t.base}/${key}`}>
        <AnimalIcon kind={key as any} size={64} />
        <span class="t">{label}</span>
        <span class="d">{count((x) => x.species === key)} {t.articles}</span>
      </a>
    ))}
  </div>
  <h2>{t.byTopic}</h2>
  <div class="grid3">
    {Object.entries(t.categories).map(([key, [label, d]]) => (
      <a class="tile" href={`${t.base}/${key}`}>
        <div class="t">{label}</div>
        <div class="d">{d}</div>
        <div class="d" style="margin-top:6px">{count((x) => x.category === key)} {t.articles}</div>
      </a>
    ))}
  </div>
  <h2>{t.latest}</h2>
  <div class="cards3">
    {all.slice(0, 6).map((e) => (
      <a class="card2" href={`${t.base}/${slugOf(e.id)}`}>
        <span class="card2-species"><AnimalIcon kind={e.data.species} size={28} /> {(t.species as any)[e.data.species]}</span>
        <span class="card2-t">{e.data.title}</span>
        <span class="card2-d">{e.data.description}</span>
        <span class={`badge ${e.data.draft ? 'draft' : 'reviewed'}`}>{e.data.draft ? t.draft : `${t.reviewedBy} ${e.data.reviewedBy}`}</span>
      </a>
    ))}
  </div>
</section>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline type="application/json" id="search-i18n" set:html={JSON.stringify(t.search)} />
<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    const el = document.getElementById('site-search'); const i18n = JSON.parse(document.getElementById('search-i18n').textContent);
    if (!el || !window.PagefindUI) return;
    new window.PagefindUI({ element: '#site-search', showSubResults: true, showImages: false, resetStyles: false,
      translations: { placeholder: i18n.placeholder, zero_results: i18n.zero, many_results: i18n.results, one_result: '[COUNT] · [SEARCH_TERM]', searching: i18n.loading, clear_search: '×' } });
  });
</script>
