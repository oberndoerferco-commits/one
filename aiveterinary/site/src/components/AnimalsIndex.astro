---
/**
 * Animals A–Z (/animals, /it/animals, /de/animals): the lexicon index (letter bar, A–Z list, by-group
 * view) and the health hubs, one card per species with articles. The find-an-animal filter narrows
 * both. Then site search and the topic lists. Lexicon entries: src/content/lexicon; hub data:
 * src/data/species.ts; shared lookups: src/lib/animal-data.ts.
 */
import { ANIMALS, nArticles, type Lang } from '../lib/animals-i18n';
import AnimalIcon from './AnimalIcon.astro';
import { TOPIC } from '../lib/topic-icons';
import { PROFILES, GUIDE, ALIASES, SPECIES, referencedSlugs, type Cited, type Item } from '../data/species';
import { GROUPS, GROUP_LABEL, LEX, letterOf } from '../lib/lexicon';
import { articlesIn, lexiconIn, speciesTopics, keyOf, iconOf, tintOf, isSpecies } from '../lib/animal-data';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ANIMALS[lang];
const G = GUIDE[lang];
const all = await articlesIn(lang);
const bySlug = new Map(all.map((e) => [keyOf(e), e]));
// Build-time assertion: every article the guide links to must exist in this language.
const missing = referencedSlugs(lang).filter((s) => !bySlug.has(s));
if (missing.length) throw new Error(`Animal guide (${lang}): missing articles ${missing.join(', ')}`);
const count = (f: (d: (typeof all)[number]['data']) => boolean) => all.filter((e) => f(e.data)).length;

// Health hubs: a full card for every species with at least one topic in this language, "coming soon" otherwise.
const pick = (items: Item[]) => items.map((i) => i[lang]).filter((c): c is Cited => !!c);
const hubs = await Promise.all(SPECIES.map(async (k) => {
  const p = PROFILES[k];
  const topics = await speciesTopics(lang, k);
  // "Start with": the curated picks that exist here, topped up with the most urgent topics.
  const start = [...new Set([...p.mostRead[lang].filter((s) => bySlug.has(s)), ...topics.map(keyOf)])].slice(0, 3);
  const parts = [pick(p.goNow).length && G.cardParts.goNow, G.cardParts.topics, pick(p.facts).length && G.cardParts.facts, pick(p.care).length && G.cardParts.care].filter(Boolean).join(' · ');
  return { k, name: p.name[lang], topics, start, sub: parts.charAt(0).toUpperCase() + parts.slice(1) };
}));
const live = hubs.filter((h) => h.topics.length);
const soon = hubs.filter((h) => !h.topics.length);

// Lexicon: every entry in this language, by localized name. Breeds (entries with a `parent`) get their own
// "Dog breeds / Cat breeds" blocks below the A–Z and group views, so the animal list stays one entry per animal.
const allLex = (await lexiconIn(lang)).map((e) => {
  const key = keyOf(e);
  const d = e.data;
  return { key, d, letter: letterOf(d.name), icon: iconOf(key, d.group, d.species), tint: tintOf(key, d.group, d.species),
    names: [d.name, d.plural, d.scientific ?? '', key.replace(/-/g, ' '), isSpecies(key) ? ALIASES[key] : ''].join(' ') };
});
const lex = allLex.filter((x) => !x.d.parent);
const L = LEX[lang];
const breedGroups = lex.map((p) => ({ p, items: allLex.filter((x) => x.d.parent === p.key) })).filter((x) => x.items.length)
  .map(({ p, items }) => ({ p, h: L.breedsOf(p.key, p.d.name), items: items.map((x) => ({ ...x, names: `${x.names} ${p.names}` })) }));
const LETTERS = [...'ABCDEFGHIJKLMNOPQRSTUVWXYZ', '#'];
const sections = LETTERS.map((l) => ({ l, id: `az-${l === '#' ? 'other' : l.toLowerCase()}`, items: lex.filter((x) => x.letter === l) }));
// Letter bar: every letter, linked only where entries exist ('#' only when some name starts with a non-letter).
const bar = sections.filter((s) => s.l !== '#' || s.items.length).map((s) => ({ l: s.l, href: s.items.length ? '#' + s.id : '' }));
const groups = GROUPS.map((g) => ({ g, items: lex.filter((x) => x.d.group === g) })).filter((x) => x.items.length);
// The filter counts animals once, whether they match in the A–Z list, a health-hub card or both.
const total = new Set([...allLex.map((x) => x.key), ...SPECIES]).size;
// Template expressions cannot hold TS generics (<…> reads as a tag), so these lookups live up here.
const emergencyCta = ({ en: 'Is it an emergency? Check the signs', it: "È un'emergenza? Controlla i segni", de: 'Ist es ein Notfall? Zeichen prüfen' } as Record<Lang, string>)[lang];
const speciesKey = ({ en: 'animals', it: 'animali', de: 'Tiere' } as Record<Lang, string>)[lang];
const stripIc = ['M16 5l12 21H4z M16 13v6 M16 23v.5', 'M6 5h20v22H6z M10 11h12 M10 16h12 M10 21h7', 'M6 8h20 M6 16h20 M6 24h14', 'M16 27s-10-6-10-13a5.5 5.5 0 0 1 10-3 5.5 5.5 0 0 1 10 3c0 7-10 13-10 13z', 'M8 4h14l4 4v20H8z M13 13h8 M17 9v8'];
---
<section class="wrap ag-hero">
  <h1>{G.title}</h1>
  <p class="lead">{G.intro}</p>
  <div class="ag-find" id="ag-find" hidden>
    <label for="ag-find-input">{G.find}</label>
    <input id="ag-find-input" type="search" autocomplete="off" placeholder={G.findPh} aria-describedby="ag-find-status" />
  </div>
  <p id="ag-find-status" class="sr-only" role="status" aria-live="polite"></p>
</section>

{lex.length > 0 && (
  <section class="wrap lx" aria-labelledby="lx-h" id="lx" data-total={lex.length}>
    <div class="lx-head">
      <h2 id="lx-h" class="section-h">{G.lexH} <span class="lx-n">{G.lexCount(lex.length)}</span></h2>
      <div class="lx-views" id="lx-views" role="group" aria-label={G.view} hidden>
        <button type="button" class="lx-view-btn" data-view="lx-az" aria-pressed="true">{G.viewAz}</button>
        <button type="button" class="lx-view-btn" data-view="lx-groups" aria-pressed="false">{G.viewGroups}</button>
      </div>
    </div>
    <div class="lx-view" id="lx-az">
      <nav class="lx-letters" id="lx-letters" aria-label={G.letters}>
        <ul>
          {bar.map((s) => (s.href ? <li><a href={s.href}>{s.l}</a></li> : <li aria-hidden="true"><span>{s.l}</span></li>))}
        </ul>
      </nav>
      <div class="lx-blocks">
      {sections.filter((s) => s.items.length).map((s) => (
        <div class="lx-block" id={s.id}>
          <h3 class="lx-block-h">{s.l}</h3>
          <ul class="lx-list">
            {s.items.map((x) => (
              <li data-names={x.names} data-key={x.key}><a class={`lx-item tint-${x.tint}`} href={`${t.base}/${x.key}`}>
                <span class="lx-ic" aria-hidden="true"><AnimalIcon kind={x.icon} size={34} /></span>
                <span class="lx-txt"><span class="lx-name">{x.d.name}</span>{x.d.scientific && <i class="lx-sci" lang="la">{x.d.scientific}</i>}</span>
              </a></li>
            ))}
          </ul>
        </div>
      ))}
      </div>
    </div>
    <div class="lx-view lx-blocks" id="lx-groups">
      {groups.map(({ g, items }) => (
        <div class="lx-block">
          <h3 class="lx-block-h lx-group-h">{GROUP_LABEL[lang][g]} <span class="lx-n">({items.length})</span></h3>
          <ul class="lx-list">
            {items.map((x) => (
              <li data-names={x.names}><a class={`lx-item tint-${x.tint}`} href={`${t.base}/${x.key}`}>
                <span class="lx-ic" aria-hidden="true"><AnimalIcon kind={x.icon} size={34} /></span>
                <span class="lx-txt"><span class="lx-name">{x.d.name}</span>{x.d.scientific && <i class="lx-sci" lang="la">{x.d.scientific}</i>}</span>
              </a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    {breedGroups.length > 0 && (
      <div class="lx-breeds" id="lx-breeds">
        <div class="lx-blocks lx-breed-blocks">
          {breedGroups.map(({ p, h, items }) => (
            <div class="lx-block" id={`lx-breeds-${p.key}`}>
              <h3 class="lx-block-h lx-group-h"><a href={`${t.base}/${p.key}`}>{h}</a> <span class="lx-n">({L.nBreeds(items.length)})</span></h3>
              <ul class="lx-list">
                {items.map((x) => (
                  <li data-names={x.names} data-key={x.key}><a class={`lx-item tint-${x.tint}`} href={`${t.base}/${x.key}`}>
                    <span class="lx-ic" aria-hidden="true"><AnimalIcon kind={x.icon} size={34} /></span>
                    <span class="lx-txt"><span class="lx-name">{x.d.name}</span><span class="lx-sci">{p.d.name}</span></span>
                  </a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    )}
  </section>
)}

<section class="wrap ag-grid-wrap" aria-labelledby="ag-grid-h">
  <h2 id="ag-grid-h" class="section-h">{G.hubsH}</h2>
  <p class="ag-hubs-lead">{G.hubsLead}</p>
  <ul class="ag-grid" id="ag-grid">
    {live.map((h) => (
      <li class={`ag-card tint-${h.k}`} data-names={`${h.name} ${ALIASES[h.k]}`} data-key={h.k}>
        <a class="ag-card-main" href={`${t.base}/${h.k}`}>
          <span class="ag-art" aria-hidden="true"><AnimalIcon kind={h.k} size={88} /></span>
          <span class="ag-card-body">
            <span class="ag-name">{h.name}</span>
            <span class="ag-sub">{h.sub}</span>
            <span class="ag-n">{nArticles(lang, h.topics.length)}</span>
          </span>
        </a>
        <div class="ag-most">
          <p class="ag-most-h">{G.startWith}:</p>
          <ul>
            {h.start.map((s) => <li><a href={`${t.base}/${s}`}>{bySlug.get(s)!.data.title}</a></li>)}
          </ul>
        </div>
      </li>
    ))}
    {soon.map((h) => (
      <li class="ag-card ag-card-sm ag-soon" data-names={`${h.name} ${ALIASES[h.k]}`} data-key={h.k}>
        <div class="ag-card-main">
          <span class="ag-art" aria-hidden="true"><AnimalIcon kind={h.k} size={56} /></span>
          <span class="ag-card-body">
            <span class="ag-name">{h.name}</span>
            <span class="ag-soon-l">{G.soon}</span>
          </span>
        </div>
      </li>
    ))}
  </ul>
  <p class="ag-none" id="ag-none" hidden data-none={G.none} data-shown={G.shown} data-total={total}></p>
</section>

<section class="wrap"><div class="notice danger"><p set:html={t.emergency} /><p><a class="btn secondary" href={G.emergencyHref}>{emergencyCta} →</a></p></div></section>

<section class="wrap section ag-search" aria-labelledby="ag-search-h">
  <div class="section-row"><h2 id="ag-search-h" class="section-h">{G.searchH}</h2><a class="more ag-az" href={`${t.base}/all`}>{G.az} →</a></div>
  <div id="site-search" class="site-search" data-lang={lang}></div>
  <p id="site-search-status" class="sr-only" role="status"></p>
</section>

<section class="wrap section" aria-labelledby="ag-strip-h">
  <h2 id="ag-strip-h" class="section-h">{G.stripH}</h2>
  <ul class="ag-strip">
    {G.strip.map(([h, d], i) => (
      <li>
        <span class="ag-strip-ic" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d={stripIc[i]} /></svg></span>
        <span class="ag-strip-h">{h}</span>
        <span class="ag-strip-d">{d}</span>
      </li>
    ))}
  </ul>
</section>

<section class="wrap section">
  <h2 class="section-h">{t.byTopic}</h2>
  <ul class="topics">
    {Object.entries(t.categories).map(([key, [label, d]]) => (
      <li><a href={`${t.base}/${key}`}>
        <span class={`topic-ic ti-${key}`} aria-hidden="true"><svg width="28" height="28" viewBox="0 0 32 32" fill="none" stroke="var(--art-ink)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" set:html={TOPIC[key] ?? ''} /></span>
        <span class="topic-t">{label}<span class="topic-d">{d}</span></span>
        <span class="topic-n">{count((x) => x.category === key)}</span>
      </a></li>
    ))}
  </ul>
  <p class="steps3-cta"><a class="btn secondary" href={`${t.base}/all`}>{G.az} →</a> <a class="btn secondary" href={t.visitBrief}>{t.prepare}</a></p>
</section>

<style>
  .ag-hero { padding-top: 48px; }
  .ag-hero .lead { font-size: 1.15rem; color: var(--ink-2); max-width: 36em; }
  .ag-find { margin: 22px 0 6px; max-width: 420px; display: flex; flex-direction: column; gap: 6px; }
  .ag-find label { font-weight: 700; }
  .ag-find input { min-height: 48px; padding: 10px 16px; border: 1.5px solid var(--line); border-radius: 999px; background: var(--surface); color: var(--ink); font: inherit; width: 100%; box-sizing: border-box; }
  .ag-find input::placeholder { color: var(--ink-3); opacity: 1; }
  .ag-find input:focus { border-color: var(--accent); }

  /* Lexicon: A–Z and by group */
  .lx { margin-top: 26px; }
  .lx-head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px 20px; margin-bottom: 10px; }
  .lx-head .section-h { margin: 0; }
  .lx-n { font-family: var(--font); font-size: .95rem; font-weight: 600; color: var(--ink-3); letter-spacing: 0; }
  .lx-views { display: inline-flex; padding: 4px; gap: 4px; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); }
  .lx-view-btn { min-height: 40px; padding: 0 16px; border-radius: 999px; border: 0; background: transparent; color: var(--ink-2); font: inherit; font-weight: 700; cursor: var(--cursor-click); }
  .lx-view-btn[aria-pressed="true"] { background: var(--accent); color: var(--accent-ink); }
  .lx-view-btn:hover:not([aria-pressed="true"]) { color: var(--accent); }
  .lx-letters ul { list-style: none; margin: 0 0 6px; padding: 0; display: flex; flex-wrap: wrap; gap: 4px; }
  .lx-letters a, .lx-letters span { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 40px; border-radius: 10px; font-weight: 700; }
  .lx-letters a { color: var(--accent); background: var(--surface); border: 1px solid var(--line); text-decoration: none; }
  .lx-letters a:hover { border-color: var(--accent); text-decoration: underline; }
  .lx-letters span { color: var(--ink-3); opacity: .55; }
  /* Letter (and group) blocks flow down then across, like a dictionary column. */
  .lx-blocks { columns: 3 250px; column-gap: 32px; margin-top: 14px; }
  .lx-block { break-inside: avoid; padding-bottom: 16px; scroll-margin-top: 84px; }
  .lx-block-h { margin: 0 0 6px; font-family: var(--font-display); font-size: 1.35rem; font-weight: 600; border-bottom: 1px solid var(--line); padding-bottom: 4px; }
  .lx-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .lx-item { display: flex; align-items: center; gap: 12px; min-height: 52px; padding: 6px 10px 6px 6px; border-radius: 14px; color: var(--ink); text-decoration: none; }
  .lx-item:hover { background: var(--surface); }
  .lx-item:hover .lx-name { color: var(--accent); text-decoration: underline; }
  .lx-ic { width: 46px; height: 46px; flex: none; border-radius: 50%; display: grid; place-items: center; background: var(--tint, var(--accent-soft)); }
  .lx-txt { display: flex; flex-direction: column; min-width: 0; }
  .lx-name { font-weight: 700; overflow-wrap: anywhere; }
  .lx-sci { color: var(--ink-3); font-size: .88rem; overflow-wrap: anywhere; }
  .lx-breeds { margin-top: 10px; padding-top: 18px; border-top: 1px solid var(--line); }
  .lx-breed-blocks { margin-top: 0; }
  .lx-group-h a { color: inherit; text-decoration: none; }
  .lx-group-h a:hover { color: var(--accent); text-decoration: underline; }

  /* Health hubs */
  .ag-grid-wrap { margin-top: 40px; }
  .ag-grid-wrap .section-h { margin-bottom: 6px; }
  .ag-hubs-lead { color: var(--ink-2); max-width: 46em; margin: 0 0 16px; }
  .ag-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 16px; }
  .ag-card { display: flex; flex-direction: column; background: var(--surface); border-radius: 22px; overflow: hidden; box-shadow: 0 1px 0 var(--line); border: 1px solid var(--line); min-width: 0; }
  .ag-card-main { display: flex; flex-direction: column; text-decoration: none; color: var(--ink); flex: 1; }
  a.ag-card-main:hover .ag-name { color: var(--accent); text-decoration: underline; }
  .ag-art { display: flex; align-items: center; justify-content: center; height: 128px; background: var(--tint, var(--accent-soft)); }
  .ag-card-body { display: flex; flex-direction: column; gap: 6px; padding: 16px 20px 14px; }
  .ag-name { font-family: var(--font-display); font-size: 1.45rem; font-weight: 600; line-height: 1.15; }
  .ag-sub { color: var(--ink-2); font-size: .95rem; overflow-wrap: anywhere; }
  .ag-n { color: var(--ink-3); font-size: .88rem; font-weight: 600; }
  .ag-most { padding: 0 20px 16px; border-top: 1px solid var(--line); }
  .ag-most-h { margin: 12px 0 4px; font-size: .85rem; font-weight: 700; color: var(--ink-3); text-transform: uppercase; letter-spacing: .06em; }
  .ag-most ul { list-style: none; margin: 0; padding: 0; }
  .ag-most a { display: flex; align-items: center; min-height: 44px; color: var(--accent); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; overflow-wrap: anywhere; }
  .ag-card-sm .ag-card-main { flex-direction: row; align-items: center; }
  .ag-card-sm .ag-art { height: auto; align-self: stretch; width: 96px; flex: none; }
  .ag-card-sm .ag-card-body { padding: 16px; min-height: 64px; justify-content: center; }
  .ag-card-sm .ag-name { font-size: 1.2rem; }
  .ag-soon { background: transparent; border-style: dashed; box-shadow: none; }
  .ag-soon .ag-art { background: var(--bg); opacity: .75; }
  .ag-soon .ag-name { color: var(--ink-2); }
  .ag-soon-l { display: inline-block; align-self: flex-start; padding: 2px 10px; border-radius: 999px; border: 1px solid var(--line); color: var(--ink-3); font-size: .82rem; font-weight: 700; }
  .ag-none { margin: 16px 0 0; color: var(--ink-2); }
  .ag-search .site-search { max-width: 640px; }
  .ag-az { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; color: var(--accent); }
  .ag-strip { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 190px), 1fr)); gap: 14px; }
  .ag-strip li { display: flex; flex-direction: column; gap: 6px; padding: 18px; border-radius: 18px; background: var(--accent-soft); }
  .ag-strip-ic { color: var(--accent); }
  .ag-strip-h { font-weight: 700; }
  .ag-strip-d { color: var(--ink-2); font-size: .94rem; }
  .steps3-cta { display: flex; flex-wrap: wrap; gap: 10px; }
  .steps3-cta .btn { min-height: 44px; box-sizing: border-box; display: inline-flex; align-items: center; }
  /* Phones: the card art sits beside the name instead of above it, so eight cards stay scannable. */
  @media (max-width: 560px) {
    .ag-card:not(.ag-card-sm) .ag-card-main { flex-direction: row; align-items: stretch; }
    .ag-card:not(.ag-card-sm) .ag-art { width: 96px; height: auto; flex: none; }
    .ag-card:not(.ag-card-sm) .ag-art :global(svg) { width: 64px; height: 64px; }
    .ag-card:not(.ag-card-sm) .ag-card-body { padding: 14px 16px; }
    .ag-name { font-size: 1.3rem; }
  }
  @media (max-width: 420px) {
    .ag-card-sm .ag-art, .ag-card:not(.ag-card-sm) .ag-art { width: 72px; } .ag-card-body { padding-left: 16px; padding-right: 16px; } .ag-most { padding: 0 16px 14px; }
    .ag-card:not(.ag-card-sm) .ag-art :global(svg) { width: 56px; height: 56px; }
    .lx-letters a, .lx-letters span { width: 34px; }
  }
</style>

<script>
  // Find an animal: narrows the A–Z list, the group view and the health-hub cards. A–Z / By group switch.
  const wrap = document.getElementById('ag-find');
  const input = document.getElementById('ag-find-input') as HTMLInputElement | null;
  const grid = document.getElementById('ag-grid');
  const none = document.getElementById('ag-none');
  const status = document.getElementById('ag-find-status');
  const lx = document.getElementById('lx');
  const views = document.getElementById('lx-views');
  if (lx && views) {
    views.hidden = false;
    const btns = [...views.querySelectorAll<HTMLButtonElement>('button[data-view]')];
    const show = (id: string) => btns.forEach((b) => { const on = b.dataset.view === id; b.setAttribute('aria-pressed', String(on)); document.getElementById(b.dataset.view!)!.hidden = !on; });
    btns.forEach((b) => b.addEventListener('click', () => show(b.dataset.view!)));
    show('lx-az');
  }
  if (wrap && input && grid && none && status) {
    wrap.hidden = false;
    const cards = [...grid.querySelectorAll<HTMLElement>(':scope > li')];
    const items = lx ? [...lx.querySelectorAll<HTMLElement>('li[data-names]')] : [];
    const blocks = lx ? [...lx.querySelectorAll<HTMLElement>('.lx-block')] : [];
    const letters = document.getElementById('lx-letters');
    const fold = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
    let timer: number | undefined;
    const run = () => {
      const q = fold(input.value.trim());
      const hit = (el: HTMLElement) => !q || fold(el.dataset.names ?? '').includes(q);
      // Each animal counts once (A–Z items and hub cards carry data-key; the group view repeats the A–Z items).
      const keys = new Set<string>();
      for (const el of [...cards, ...items]) { const h = hit(el); el.hidden = !h; if (h && el.dataset.key) keys.add(el.dataset.key); }
      for (const b of blocks) b.hidden = !b.querySelector('li[data-names]:not([hidden])');
      const breeds = document.getElementById('lx-breeds');
      if (breeds) breeds.hidden = !breeds.querySelector('.lx-block:not([hidden])');
      if (letters) letters.hidden = !!q;
      const n = keys.size;
      const nothing = !n;
      none.hidden = !nothing;
      none.textContent = nothing ? (none.dataset.none ?? '').replace('{q}', input.value.trim()) : '';
      clearTimeout(timer);
      timer = window.setTimeout(() => { status.textContent = q ? (nothing ? none.textContent : (none.dataset.shown ?? '').replace('{n}', String(n)).replace('{t}', none.dataset.total ?? '')) : ''; }, 400);
    };
    input.addEventListener('input', run);
  }
</script>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline type="application/json" id="search-i18n" set:html={JSON.stringify({ ...t.search, species: t.species, speciesKey })} />
<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    const el = document.getElementById('site-search'); const i18n = JSON.parse(document.getElementById('search-i18n').textContent);
    if (!el || !window.PagefindUI) return;
    const ui = new window.PagefindUI({ element: '#site-search', showSubResults: true, showImages: false, resetStyles: false,
      // The species tag comes from data-pagefind-meta as a raw key ("species: dog"); show it in the page language.
      processResult: (r) => { const sp = r.meta && r.meta.species; if (sp) { delete r.meta.species; r.meta[i18n.speciesKey] = i18n.species[sp] || sp; } return r; },
      translations: { placeholder: i18n.placeholder, zero_results: i18n.zero, many_results: i18n.results, one_result: '[COUNT] · [SEARCH_TERM]', searching: i18n.loading, clear_search: '×' } });
    // Pagefind's input has only a placeholder; give it an accessible name.
    const clear = { en: 'Clear search', it: 'Cancella la ricerca', de: 'Suche löschen' }[el.dataset.lang] || 'Clear search';
    const name = () => { document.querySelector('#site-search input')?.setAttribute('aria-label', i18n.placeholder); document.querySelector('#site-search .pagefind-ui__search-clear')?.setAttribute('aria-label', clear); };
    name(); setTimeout(name, 0);
    // Pagefind's result count is not a live region: mirror it into one once results settle.
    const status = document.getElementById('site-search-status'); let t;
    new MutationObserver(() => { clearTimeout(t); t = setTimeout(() => { const m = el.querySelector('.pagefind-ui__message'); const v = el.querySelector('input')?.value.trim() ? m?.textContent.trim() ?? '' : ''; if (status.textContent !== v) status.textContent = v; }, 600); }).observe(el, { childList: true, subtree: true, characterData: true });
    const q = new URLSearchParams(location.search).get('q'); if (q) { ui.triggerSearch(q); el.scrollIntoView(); }
  });
</script>
