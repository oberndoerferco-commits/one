---
import { getCollection } from 'astro:content';
import { ANIMALS, slugOf, type Lang } from '../lib/animals-i18n';
import AnimalIcon from './AnimalIcon.astro';
import { TOPIC } from '../lib/topic-icons';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ANIMALS[lang];
const all = (await getCollection('animals')).filter((e) => e.data.lang === lang).sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());
const count = (f: (d: any) => boolean) => all.filter((e) => f(e.data)).length;
---
<section class="wrap idx-hero">
  <h1>{t.title}</h1>
  <p class="lead">{t.lead}</p>
  <div id="site-search" class="site-search" data-lang={lang}></div>
  <ul class="pets pets-lg" aria-label={t.byAnimal}>
    {Object.entries(t.species).map(([key, label]) => {
      const n = count((x) => x.species === key);
      return <li><a class={`pet pet-${key}`} href={`${t.base}/${key}`}><span class="pet-c"><AnimalIcon kind={key as any} size={52} /></span><span class="pet-t">{label}</span>{n > 0 && <span class="pet-n">{n}</span>}</a></li>;
    })}
  </ul>
</section>
<section class="wrap"><div class="notice danger"><p set:html={t.emergency} /><p><a class="btn secondary" href={({ en: "/emergency", it: "/it/emergency", de: "/de/emergency" } as any)[lang]}>{({ en: "Is it an emergency? Check the signs", it: "È un'emergenza? Controlla i segni", de: "Ist es ein Notfall? Zeichen prüfen" } as any)[lang]} →</a></p></div></section>

<section class="wrap section">
  <h2 class="section-h">{t.byTopic}</h2>
  <ul class="topics">
    {Object.entries(t.categories).map(([key, [label, d]]) => (
      <li><a href={`${t.base}/${key}`}>
        <span class={`topic-ic ti-${key}`} aria-hidden="true"><svg width="28" height="28" viewBox="0 0 32 32" fill="none" stroke="var(--art-ink)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" set:html={TOPIC[key] ?? ''} /></span>
        <span class="topic-t">{label}<span class="topic-d">{d}</span></span>
        <span class="topic-n">{count((x) => x.category === key)}</span>
      </a></li>
    ))}
  </ul>
</section>

<section class="wrap section">
  <div class="section-row"><h2 class="section-h">{t.latest}</h2><a class="more" href={`${t.base}/all`}>{t.allTitle} →</a></div>
  <div class="cards3">
    {all.slice(0, 6).map((e) => (
      <a class={`card3 tint-${e.data.species}`} href={`${t.base}/${slugOf(e.id)}`}>
        <span class="card3-art">{e.data.species === 'general' ? <><AnimalIcon kind="dog" size={72} /><AnimalIcon kind="cat" size={72} /></> : <AnimalIcon kind={e.data.species} size={84} />}</span>
        <span class="card3-body">
          <span class="card3-t">{e.data.title}</span>
          <span class="card3-d">{e.data.description}</span>
          <span class={`badge ${e.data.draft ? 'draft' : 'reviewed'}`}>{e.data.draft ? t.draft : `${t.reviewedBy} ${e.data.reviewedBy}`}</span>
        </span>
      </a>
    ))}
  </div>
  <p class="steps3-cta"><a class="btn secondary" href={t.visitBrief}>{t.prepare}</a></p>
</section>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline type="application/json" id="search-i18n" set:html={JSON.stringify(t.search)} />
<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    const el = document.getElementById('site-search'); const i18n = JSON.parse(document.getElementById('search-i18n').textContent);
    if (!el || !window.PagefindUI) return;
    const ui = new window.PagefindUI({ element: '#site-search', showSubResults: true, showImages: false, resetStyles: false,
      translations: { placeholder: i18n.placeholder, zero_results: i18n.zero, many_results: i18n.results, one_result: '[COUNT] · [SEARCH_TERM]', searching: i18n.loading, clear_search: '×' } });
    // Pagefind's input has only a placeholder; give it an accessible name.
    const name = () => document.querySelector('#site-search input')?.setAttribute('aria-label', i18n.placeholder);
    name(); setTimeout(name, 0);
    const q = new URLSearchParams(location.search).get('q'); if (q) ui.triggerSearch(q);
  });
</script>
