---
/**
 * /animals/<filter>: for dog, cat and rabbit an animal profile (go-now signs, key facts, health
 * topics, care basics, booklet) built from src/data/species.ts; for other species and for
 * categories the article listing as before.
 */
import { getCollection } from 'astro:content';
import { ANIMALS, slugOf, type Lang } from '../lib/animals-i18n';
import AnimalIcon from './AnimalIcon.astro';
import { TOPIC } from '../lib/topic-icons';
import { PROFILES, GUIDE, type Cited, type Item, type ProfileKey } from '../data/species';
interface Props { lang: Lang; filter: string }
const { lang, filter } = Astro.props;
const t = ANIMALS[lang];
const G = GUIDE[lang];
const isSpecies = filter in t.species;
const profile = (PROFILES as Record<string, (typeof PROFILES)[ProfileKey]>)[filter];
const label = profile?.name[lang] ?? (t.species as any)[filter] ?? (t.categories as any)[filter]?.[0] ?? filter;
const sub = isSpecies ? null : (t.categories as any)[filter]?.[1] ?? null;
const langEntries = (await getCollection('animals')).filter((e) => e.data.lang === lang);
const bySlug = new Map(langEntries.map((e) => [slugOf(e.id), e]));
const entries = langEntries
  .filter((e) => e.data.species === filter || e.data.category === filter)
  .sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());
const countLabel = `${entries.length} ${t.articles}`;

// Profile data for this language; build-time assertion that every cited article exists.
const pick = (items: Item[]) => items.map((i) => i[lang]).filter((c): c is Cited => !!c);
const goNow = profile ? pick(profile.goNow) : [];
const facts = profile ? pick(profile.facts) : [];
const care = profile ? pick(profile.care) : [];
for (const c of [...goNow, ...facts, ...care]) {
  if (!bySlug.has(c.slug)) throw new Error(`Animal profile ${filter} (${lang}): cited article "${c.slug}" does not exist`);
}
const ORDER = { emergency: 0, today: 1, 'this-week': 2, routine: 3 } as const;
const topics = [...entries].sort((a, b) => (ORDER[a.data.urgency ?? 'routine'] - ORDER[b.data.urgency ?? 'routine']) || a.data.title.localeCompare(b.data.title, t.locale));
const href = (slug: string) => `${t.base}/${slug}`;
const titleOf = (slug: string) => bySlug.get(slug)!.data.title;
const others = (['dog', 'cat', 'rabbit'] as ProfileKey[]).filter((k) => k !== filter);
---
{profile ? (
  <>
    <section class={`filter-hero tint-${filter}`}>
      <div class="wrap filter-hero-in">
        <div>
          <p class="eyebrow"><a href={t.base}>{G.guide}</a></p>
          <h1>{label}</h1>
          <p class="lead">{profile.intro[lang]}</p>
          <p class="filter-count">{countLabel}</p>
        </div>
        <div class="filter-art" aria-hidden="true"><AnimalIcon kind={filter as any} size={150} /></div>
      </div>
    </section>

    {goNow.length > 0 && (
      <section class="wrap ap-sec" aria-labelledby="ap-go-h">
        <div class="ap-go">
          <h2 id="ap-go-h" class="ap-go-h"><svg width="26" height="26" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 5l12 21H4z M16 13v6 M16 23v.5" /></svg>{G.goNowH}</h2>
          <p class="ap-go-lead">{G.goNowLead}</p>
          <ul class="ap-go-list">
            {goNow.map((c) => (
              <li>
                <p class="ap-text">{c.text}</p>
                <p class="ap-src">{G.source}: {c.sources.join(', ')} · <a href={href(c.slug)}>{G.read}: {titleOf(c.slug)}</a></p>
              </li>
            ))}
          </ul>
          <p class="ap-go-more"><a class="ap-go-btn" href={G.emergencyHref}>{G.emergencyLink} →</a></p>
        </div>
      </section>
    )}

    {facts.length > 0 && (
      <section class="wrap ap-sec" aria-labelledby="ap-facts-h">
        <h2 id="ap-facts-h" class="section-h">{G.factsH}</h2>
        <ul class="ap-facts">
          {facts.map((c) => (
            <li class="ap-fact">
              <p class="ap-text">{c.text}</p>
              <p class="ap-src">{G.source}: {c.sources.join(', ')}<br /><a href={href(c.slug)}>{G.read}: {titleOf(c.slug)}</a></p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="wrap ap-sec" aria-labelledby="ap-topics-h">
      <h2 id="ap-topics-h" class="section-h">{G.topicsH}</h2>
      <p class="ap-muted">{G.topicsLead.replace('{n}', String(topics.length))}</p>
      <ul class="ap-topics">
        {topics.map((e) => {
          const u = e.data.urgency ?? 'routine';
          return (
            <li><a href={href(slugOf(e.id))}>
              <span class={`ap-u ap-u-${u}`}>{G.urgency[u]}</span>
              <span class="ap-topic-t">{e.data.title}</span>
              <span class="ap-topic-d">{e.data.description}</span>
            </a></li>
          );
        })}
      </ul>
    </section>

    {care.length > 0 && (
      <section class="wrap ap-sec" aria-labelledby="ap-care-h">
        <h2 id="ap-care-h" class="section-h">{G.careH}</h2>
        <ul class="ap-care">
          {care.map((c) => (
            <li>
              <p class="ap-text">{c.text}</p>
              <p class="ap-src">{G.source}: {c.sources.join(', ')} · <a href={href(c.slug)}>{G.read}: {titleOf(c.slug)}</a></p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="wrap ap-sec">
      <div class="ap-booklet">
        <div>
          <h2 class="ap-booklet-h">{G.bookletH}</h2>
          <p>{G.bookletP}</p>
        </div>
        <a class="btn lg" href={G.booklet}>{G.bookletCta}</a>
      </div>
    </section>

    <section class="wrap ap-sec" aria-labelledby="ap-other-h">
      <h2 id="ap-other-h" class="section-h">{G.otherH}</h2>
      <ul class="ap-other">
        {others.map((k) => <li><a class={`tint-${k}`} href={href(k)}><span class="ap-other-c" aria-hidden="true"><AnimalIcon kind={k} size={40} /></span>{PROFILES[k].name[lang]}</a></li>)}
        <li><a href={t.base}><span class="ap-other-c" aria-hidden="true"><AnimalIcon kind="paw" size={40} /></span>{G.guide}</a></li>
      </ul>
    </section>
  </>
) : (
  <>
    <section class={`filter-hero ${isSpecies ? `tint-${filter}` : `ti-${filter}`}`}>
      <div class="wrap filter-hero-in">
        <div>
          <p class="eyebrow"><a href={t.base}>{G.guide}</a></p>
          <h1>{label}</h1>
          {sub && <p class="lead">{sub}</p>}
          <p class="filter-count">{countLabel}</p>
        </div>
        <div class="filter-art" aria-hidden="true">
          {isSpecies
            ? (filter === 'general' ? <><AnimalIcon kind="dog" size={120} /><AnimalIcon kind="cat" size={110} /></> : <AnimalIcon kind={filter as any} size={150} />)
            : <svg width="120" height="120" viewBox="0 0 32 32" fill="none" stroke="var(--art-ink)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={TOPIC[filter] ?? ''} />}
        </div>
      </div>
    </section>
    <section class="wrap section">
      {entries.length === 0 && <p class="lead" set:html={t.nothing} />}
      <div class="cards3">
        {entries.map((e) => (
          <a class={`card3 tint-${e.data.species}`} href={`${t.base}/${slugOf(e.id)}`}>
            {!isSpecies && <span class="card3-art card3-art-sm">{e.data.species === 'general' ? <><AnimalIcon kind="dog" size={56} /><AnimalIcon kind="cat" size={56} /></> : <AnimalIcon kind={e.data.species} size={64} />}</span>}
            <span class="card3-body">
              <span class="card3-t">{e.data.title}</span>
              <span class="card3-d">{e.data.description}</span>
              {e.data.draft ? <span class="badge draft">{t.draft}</span> : <span class="badge reviewed">{t.reviewedBy} {e.data.reviewedBy}</span>}
            </span>
          </a>
        ))}
      </div>
    </section>
  </>
)}

<style>
  .ap-sec { margin-top: 40px; }
  .eyebrow a { display: inline-flex; align-items: center; min-height: 44px; }
  .ap-sec .section-h { margin-bottom: 14px; }
  .ap-text { margin: 0 0 8px; overflow-wrap: anywhere; }
  .ap-src { margin: 0; font-size: .88rem; color: var(--ink-3); overflow-wrap: anywhere; }
  .ap-src a { display: inline-flex; align-items: center; min-height: 44px; color: var(--accent); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .ap-muted { color: var(--ink-2); margin: -4px 0 14px; }

  .ap-go { border: 2px solid var(--danger); background: var(--danger-soft); border-radius: 20px; padding: 22px 24px; }
  .ap-go-h { display: flex; align-items: center; gap: 10px; margin: 0 0 6px; color: var(--danger); }
  .ap-go-lead { margin: 0 0 12px; font-weight: 600; }
  .ap-go-list { margin: 0; padding: 0; list-style: none; }
  .ap-go-list li { padding: 12px 0 4px; border-top: 1px solid color-mix(in srgb, var(--danger) 30%, transparent); }
  .ap-go-list .ap-text { font-weight: 600; }
  .ap-go-list .ap-src, .ap-go-list .ap-src a { color: var(--ink-2); }
  .ap-go-list .ap-src a { color: var(--danger); }
  .ap-go-more { margin: 10px 0 0; }
  .ap-go-btn { display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border-radius: 999px; background: var(--danger); color: var(--surface); font-weight: 700; text-decoration: none; }
  .ap-go-btn:hover { text-decoration: underline; }

  .ap-facts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 14px; }
  .ap-fact { display: flex; flex-direction: column; justify-content: space-between; padding: 18px 20px 10px; border-radius: 18px; background: var(--surface); border: 1px solid var(--line); border-top: 4px solid var(--accent); min-width: 0; }
  .ap-fact .ap-text { font-size: 1.02rem; }

  .ap-topics { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 0 28px; }
  .ap-topics a { display: flex; flex-direction: column; gap: 4px; padding: 14px 4px; min-height: 44px; border-bottom: 1px solid var(--line); text-decoration: none; color: var(--ink); }
  .ap-topics a:hover .ap-topic-t { color: var(--accent); text-decoration: underline; }
  .ap-topic-t { font-weight: 700; overflow-wrap: anywhere; }
  .ap-topic-d { color: var(--ink-3); font-size: .9rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .ap-u { align-self: flex-start; padding: 2px 10px; border-radius: 999px; font-size: .78rem; font-weight: 700; border: 1px solid currentColor; }
  .ap-u-emergency { background: var(--danger); color: var(--surface); border-color: var(--danger); }
  .ap-u-today { color: var(--danger); background: var(--danger-soft); }
  .ap-u-this-week { color: color-mix(in srgb, var(--warn) 80%, var(--ink)); background: var(--warn-soft); }
  .ap-u-routine { color: var(--ok); background: var(--ok-soft); }

  .ap-care { margin: 0; padding: 0; list-style: none; display: grid; gap: 10px; }
  .ap-care .ap-src { color: var(--ink-2); }
  .ap-care li { padding: 14px 18px 4px 18px; border-left: 4px solid var(--ok); background: var(--ok-soft); border-radius: 8px; }

  .ap-booklet { display: flex; align-items: center; justify-content: space-between; gap: 18px 28px; flex-wrap: wrap; padding: 24px; border-radius: 20px; background: var(--accent-soft); }
  .ap-booklet-h { margin: 0 0 6px; font-size: clamp(1.3rem, 2.6vw, 1.7rem); }
  .ap-booklet p { margin: 0; color: var(--ink-2); max-width: 34em; }
  .ap-booklet .btn { min-height: 44px; box-sizing: border-box; }

  .ap-other { list-style: none; margin: 0 0 24px; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .ap-other a { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 6px 16px 6px 6px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); font-weight: 600; text-decoration: none; }
  .ap-other a:hover { border-color: var(--accent); color: var(--accent); }
  .ap-other-c { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: var(--tint, var(--accent-soft)); }
  @media (max-width: 480px) { .ap-go { padding: 18px 16px; } .ap-booklet { padding: 20px 16px; } .ap-fact { padding: 16px 16px 8px; } }
</style>
