---
/**
 * /animals/<filter> as an article listing: topics (symptoms, care, …), "All animals" (general), and a
 * species that has no health topic or lexicon entry in this language yet. Animal pages (species hubs
 * and lexicon entries) are AnimalPage.astro; src/lib/animal-data.ts decides which one a key gets.
 */
import { ANIMALS, nArticles, slugOf, type Lang } from '../lib/animals-i18n';
import AnimalIcon from './AnimalIcon.astro';
import type { IconKind } from '../lib/animal-icons';
import { TOPIC } from '../lib/topic-icons';
import { GUIDE } from '../data/species';
import { articlesIn } from '../lib/animal-data';
import { UI as HEALTH, healthPath, termsIn } from '../data/health-terms';
interface Props { lang: Lang; filter: string }
const { lang, filter } = Astro.props;
const t = ANIMALS[lang];
const G = GUIDE[lang];
const isSpecies = filter in t.species;
const label = (t.species as Record<string, string>)[filter] ?? (t.categories as Record<string, readonly string[]>)[filter]?.[0] ?? filter;
const sub = isSpecies ? null : (t.categories as Record<string, readonly string[]>)[filter]?.[1] ?? null;
// Symptoms and conditions listings point to the Health A–Z, where every term our articles cover is explained.
const HZ = { en: (n: number) => `Looking up a word? The Health A–Z explains ${n} symptoms and conditions in a sentence or two, with the articles for each.`, it: (n: number) => `Cerchi una parola? La Salute dalla A alla Z spiega ${n} sintomi e malattie in una o due frasi, con gli articoli di ciascuno.`, de: (n: number) => `Sie suchen einen Begriff? Gesundheit von A bis Z erklärt ${n} Symptome und Erkrankungen in ein, zwei Sätzen, mit den Artikeln dazu.` }[lang];
const healthLink = filter === 'symptoms' || filter === 'conditions';
const entries = (await articlesIn(lang))
  .filter((e) => e.data.species === filter || e.data.category === filter)
  .sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());
---
<section class={`filter-hero ${isSpecies ? `tint-${filter}` : `ti-${filter}`}`}>
  <div class="wrap filter-hero-in">
    <div>
      <p class="eyebrow"><a href={t.base}>{G.guide}</a></p>
      <h1>{label}</h1>
      {sub && <p class="lead">{sub}</p>}
      <p class="filter-count">{nArticles(lang, entries.length)}</p>
    </div>
    <div class="filter-art" aria-hidden="true">
      {isSpecies
        ? (filter === 'general' ? <><AnimalIcon kind="dog" size={120} /><AnimalIcon kind="cat" size={110} /></> : <AnimalIcon kind={filter as IconKind} size={150} />)
        : <svg width="120" height="120" viewBox="0 0 32 32" fill="none" stroke="var(--art-ink)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={TOPIC[filter] ?? ''} />}
    </div>
  </div>
</section>
{healthLink && (
  <section class="wrap"><div class="notice health-az"><p>{HZ(termsIn(lang).length)}</p><p><a class="btn secondary" href={healthPath(lang)}>{HEALTH[lang].h1} →</a></p></div></section>
)}
<section class="wrap section">
  {entries.length === 0 && <p class="lead" set:html={t.nothing} />}
  <div class="cards3">
    {entries.map((e) => (
      <a class={`card3 tint-${e.data.species}`} href={`${t.base}/${slugOf(e.id)}`}>
        {!isSpecies && <span class="card3-art card3-art-sm">{e.data.species === 'general' ? <><AnimalIcon kind="dog" size={56} /><AnimalIcon kind="cat" size={56} /></> : <AnimalIcon kind={e.data.species} size={64} />}</span>}
        <span class="card3-body">
          <span class="card3-t">{e.data.title}</span>
          <span class="card3-d">{e.data.description}</span>
          {e.data.draft ? <span class="badge draft">{t.draft}</span> : <span class="badge reviewed">{t.reviewedBy} {e.data.reviewedBy}</span>}
        </span>
      </a>
    ))}
  </div>
</section>

<style>
  .eyebrow a { display: inline-flex; align-items: center; min-height: 44px; }
  .health-az .btn { min-height: 44px; display: inline-flex; align-items: center; }
</style>
