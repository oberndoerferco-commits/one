---
/**
 * Cute single-stroke outline animals. Drawn by hand as SVG paths, 48×48 grid,
 * stroke 2.2, round caps. Colour follows `currentColor`.
 */
interface Props { kind: 'dog' | 'cat' | 'rabbit' | 'horse' | 'bird' | 'general' | 'paw' | 'ferret'; size?: number; class?: string; title?: string }
const { kind, size = 40, class: cls = '', title } = Astro.props;
const paths: Record<string, string> = {
  // round head, floppy ears, nose, happy mouth
  dog: `<path d="M14 18c-5-1-8 2-8 7 0 4 3 6 6 5"/><path d="M34 18c5-1 8 2 8 7 0 4-3 6-6 5"/><path d="M14 18c0-7 5-10 10-10s10 3 10 10v8c0 7-4 12-10 12S14 33 14 26v-8z"/><circle cx="20" cy="24" r="1.3" fill="currentColor" stroke="none"/><circle cx="28" cy="24" r="1.3" fill="currentColor" stroke="none"/><path d="M22 29.5h4l-2 2z" fill="currentColor"/><path d="M20 33c1.5 1.5 6.5 1.5 8 0"/>`,
  // pointy ears, whiskers, little smile
  cat: `<path d="M14 20l-2-10 8 5"/><path d="M34 20l2-10-8 5"/><path d="M14 20c0-4 4-6 10-6s10 2 10 6v8c0 7-4 11-10 11S14 35 14 28v-8z"/><circle cx="20" cy="25" r="1.3" fill="currentColor" stroke="none"/><circle cx="28" cy="25" r="1.3" fill="currentColor" stroke="none"/><path d="M23 30h2l-1 1.5z" fill="currentColor"/><path d="M21.5 33c1 1 4 1 5 0"/><path d="M6 27h8M6 31l8-1"/><path d="M34 27h8M34 31l8-1"/>`,
  // tall ears, round face, buck teeth
  rabbit: `<path d="M18 20c-4-9-3-15 0-15s4 8 4 15"/><path d="M30 20c4-9 3-15 0-15s-4 8-4 15"/><path d="M14 27c0-5 4-8 10-8s10 3 10 8v5c0 6-4 9-10 9s-10-3-10-9v-5z"/><circle cx="20" cy="28" r="1.3" fill="currentColor" stroke="none"/><circle cx="28" cy="28" r="1.3" fill="currentColor" stroke="none"/><path d="M23 32h2l-1 1.5z" fill="currentColor"/><path d="M22 34v3h2v-3M24 34v3h2v-3"/>`,
  // side profile head with mane
  horse: `<path d="M12 40V26c0-8 6-14 14-14l6-6 2 6 6 2-2 4-4 2c0 3-2 5-4 6l-2 10"/><path d="M26 12c-4 0-8 2-10 5"/><path d="M18 14l-4-6"/><circle cx="30" cy="18" r="1.3" fill="currentColor" stroke="none"/><path d="M36 22c-1 2-3 3-5 3"/>`,
  // round little bird on a line
  bird: `<path d="M16 30c0-7 4-12 10-12s9 4 9 10c0 3-1 5-3 6l-2 4"/><path d="M26 18l4-8 3 6"/><circle cx="29" cy="23" r="1.2" fill="currentColor" stroke="none"/><path d="M35 25l5 1-5 2"/><path d="M8 40h32"/><path d="M26 34v6M30 34v6"/><path d="M19 29c2-3 7-4 10-2"/>`,
  // paw: pad + 4 toes
  paw: `<ellipse cx="24" cy="31" rx="7" ry="6"/><circle cx="14" cy="22" r="3"/><circle cx="20.5" cy="16" r="3"/><circle cx="27.5" cy="16" r="3"/><circle cx="34" cy="22" r="3"/>`,
  general: `<ellipse cx="24" cy="31" rx="7" ry="6"/><circle cx="14" cy="22" r="3"/><circle cx="20.5" cy="16" r="3"/><circle cx="27.5" cy="16" r="3"/><circle cx="34" cy="22" r="3"/>`,
  ferret: `<path d="M8 32c0-6 4-10 10-10h12c6 0 10 4 10 10s-4 8-10 8H18c-6 0-10-2-10-8z"/><path d="M30 22l6-8 3 5"/><circle cx="33" cy="26" r="1.2" fill="currentColor" stroke="none"/><path d="M8 32c-3 0-5 3-4 6"/>`,
};
---
<svg class={`ai-icon ${cls}`} width={size} height={size} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden={title ? undefined : 'true'} role={title ? 'img' : undefined}>
  {title && <title>{title}</title>}
  <Fragment set:html={paths[kind] ?? paths.paw} />
</svg>
