      Bird: [['droppings', 'Feci: colore, consistenza, quantità?', ''], ['fluffed', 'Sta gonfio, sul fondo della gabbia, muove la coda respirando?', ''], ['diet', 'Dieta: semi, pellet, cibo fresco?', '']],
    },
    species_opts: { Dog: 'Cane', Cat: 'Gatto', Rabbit: 'Coniglio', 'Guinea pig': 'Porcellino d\'India', Horse: 'Cavallo', Bird: 'Uccello', Other: 'Altro' },
    sex_opts: { Female: 'Femmina', Male: 'Maschio', 'Female, spayed': 'Femmina sterilizzata', 'Male, neutered': 'Maschio castrato' },
