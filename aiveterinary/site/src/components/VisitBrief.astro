---
import YarnCat from './YarnCat.astro';
interface Props { lang?: 'en' | 'it' | 'de' }
const { lang = 'en' } = Astro.props;
const T = {
  en: {
    eyebrow: 'For animal owners', h1: 'Prepare for the vet visit',
    lead: 'Vets ask the same questions at every visit: since when, how often, what changed, what does the animal eat, which medications. Answer them calmly at home and bring a one-page brief. The visit goes faster and nothing is forgotten.',
