    make: 'Crea il riepilogo', clear: 'Cancella', copy: 'Copia', print: 'Stampa / salva come PDF', email: 'Invia alla clinica via email', diary: 'Dal diario dei sintomi (ultime voci)', briefTitle: 'Riepilogo per la visita veterinaria', footer: 'Preparato dal proprietario con aiveterinary.org. È il racconto del proprietario, non una cartella clinica. Questa pagina ordina le tue risposte con un software; non contiene contenuti medici generati da IA né diagnosi.',
    speciesTitle: 'Domande che il veterinario fa su questo animale',
    speciesQ: {
      Dog: [['stool', 'Feci: normali, molli, con sangue, assenti?', ''], ['exercise', 'Si stanca prima durante le passeggiate?', 'sì / no / non so'], ['scavenge', 'Può aver mangiato qualcosa (spazzatura, ossa, cioccolato, uva, piante)?', '']],
      Cat: [['litter', 'Lettiera: urina normalmente, si sforza, fa fuori dalla lettiera?', ''], ['water', 'Beve più del solito?', 'sì / no / non so'], ['hiding', 'Si nasconde, si pulisce meno o miagola di più?', ''], ['outdoor', 'Vive solo in casa o esce?', '']],
      Rabbit: [['droppings', 'Feci nelle ultime 12 ore: normali, più piccole, meno, assenti?', ''], ['hay', 'Mangia ancora il fieno?', 'sì / meno / no'], ['teeth', 'Saliva, mento bagnato, fa cadere il cibo?', ''], ['lastate', 'Quando ha mangiato l\'ultima volta?', 'es. stamattina']],
      'Guinea pig': [['droppings', 'Feci nelle ultime 12 ore: normali, più piccole, meno, assenti?', ''], ['hay', 'Mangia ancora il fieno?', 'sì / meno / no'], ['teeth', 'Saliva, mento bagnato, fa cadere il cibo?', ''], ['lastate', 'Quando ha mangiato l\'ultima volta?', 'es. stamattina']],
