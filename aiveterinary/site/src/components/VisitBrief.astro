const t = T[lang];
const J = {
  en: { unnamed: 'Unnamed', animal: 'Animal', notDescribed: 'not described', main: 'Main concern', since: 'Since', freq: 'How often / how bad', trend: 'Trend', trigger: 'Possible trigger', signs: 'Other signs noticed', none: 'None ticked', food: 'Food, medication, history', diet: 'Diet', meds: 'Medications', hist: 'Known conditions', vacc: 'Vaccinations up to date', par: 'Last parasite treatment', life: 'Lifestyle', others: 'Other animals', q: 'Questions for the vet', media: 'Photos / videos to show', title: 'Veterinary visit brief', copied: 'Copied.', months: 'months', years: 'years', since2: 'since', spayed: 'spayed', neutered: 'neutered', locale: 'en-GB' },
  it: { unnamed: 'Senza nome', animal: 'Animale', notDescribed: 'non descritto', main: 'Problema principale', since: 'Da quando', freq: 'Quanto spesso / quanto grave', trend: 'Andamento', trigger: 'Possibile causa scatenante', signs: 'Altri segni notati', none: 'Nessuno', food: 'Alimentazione, farmaci, storia', diet: 'Alimentazione', meds: 'Farmaci', hist: 'Malattie note', vacc: 'Vaccinazioni in regola', par: 'Ultimo antiparassitario', life: 'Stile di vita', others: 'Altri animali', q: 'Domande per il veterinario', media: 'Foto / video da mostrare', title: 'Riepilogo per la visita veterinaria', copied: 'Copiato.', months: 'mesi', years: 'anni', since2: 'dal', spayed: 'sterilizzata', neutered: 'castrato', locale: 'it-IT' },
  de: { unnamed: 'Ohne Namen', animal: 'Tier', notDescribed: 'nicht beschrieben', main: 'Hauptproblem', since: 'Seit wann', freq: 'Wie oft / wie schlimm', trend: 'Verlauf', trigger: 'Möglicher Auslöser', signs: 'Weitere Anzeichen', none: 'Keine angekreuzt', food: 'Futter, Medikamente, Vorgeschichte', diet: 'Fütterung', meds: 'Medikamente', hist: 'Bekannte Erkrankungen', vacc: 'Impfungen aktuell', par: 'Letzte Parasitenbehandlung', life: 'Haltung', others: 'Andere Tiere', q: 'Fragen an die Praxis', media: 'Fotos / Videos zum Zeigen', title: 'Übersicht für den Tierarztbesuch', copied: 'Kopiert.', months: 'Monate', years: 'Jahre', since2: 'seit', spayed: 'kastriert', neutered: 'kastriert', locale: 'de-DE' },
}[lang];
---
<section class="wrap hero">
  <p class="eyebrow">{t.eyebrow}</p>
  <h1>{t.h1}</h1>
  <p class="lead">{t.lead}</p>
  <div class="notice"><p set:html={t.notDiag} /></div>
  <div class="notice danger"><p set:html={t.goNow} /></div>
</section>

<section class="wrap" id="vb-app">
  <form id="vb-form" class="card" autocomplete="off">
    <h2>{t.about}</h2>
    <p class="pp-hint" set:html={t.passportHint} />
    <div class="pp-fields">
      <label>{t.fromPassport}<select id="vb-passport"><option value="">—</option></select></label>
      <label>{t.name}<input name="name" /></label>
      <label>{t.species}<select name="species"><option value="">—</option>{Object.entries(t.species_opts).map(([v, l]) => <option value={v}>{l}</option>)}</select></label>
      <label>{t.breed}<input name="breed" /></label>
      <label>{t.age}<input name="age" placeholder={t.agePh} /></label>
      <label>{t.sex}<select name="sex"><option value="">—</option>{Object.entries(t.sex_opts).map(([v, l]) => <option value={v}>{l}</option>)}</select></label>
      <label>{t.weight}<input name="weight" type="number" step="0.1" min="0" /></label>
    </div>

    <h2>{t.going}</h2>
    <div class="pp-fields">
      <label class="wide">{t.concern}<textarea name="concern" rows="3" placeholder={t.concernPh}></textarea></label>
      <label>{t.since}<input name="since" placeholder={t.sincePh} /></label>
      <label>{t.freq}<input name="frequency" placeholder={t.freqPh} /></label>
      <label>{t.trend}<select name="trend"><option value="">—</option>{t.trendOpts.map((o) => <option>{o}</option>)}</select></label>
      <label>{t.trigger}<input name="trigger" placeholder={t.triggerPh} /></label>
      <label class="wide">{t.diary}<textarea name="diary" rows="3"></textarea></label>
    </div>

    <div id="vb-species" hidden>
      <h2>{t.speciesTitle}</h2>
      <div class="pp-fields" id="vb-species-fields"></div>
    </div>

    <h2>{t.noticed}</h2>
    <div class="vb-checks">
      {t.signs.map((s) => (<label><input type="checkbox" name="signs" value={s} /> {s}</label>))}
    </div>
    <div class="pp-fields" style="margin-top:12px">
      <label class="wide">{t.other}<input name="other" /></label>
    </div>

    <h2>{t.food}</h2>
    <div class="pp-fields">
      <label class="wide">{t.diet}<input name="diet" /></label>
      <label class="wide">{t.meds}<textarea name="meds" rows="2" placeholder={t.medsPh}></textarea></label>
      <label class="wide">{t.history}<input name="history" /></label>
      <label>{t.vacc}<select name="vacc"><option value="">—</option>{t.vaccOpts.map((o) => <option>{o}</option>)}</select></label>
      <label>{t.parasite}<input name="parasite" placeholder={t.parasitePh} /></label>
      <label>{t.lifestyle}<input name="lifestyle" /></label>
      <label>{t.others}<input name="others" /></label>
    </div>

    <h2>{t.forVet}</h2>
    <div class="pp-fields">
      <label class="wide">{t.questions}<textarea name="questions" rows="2"></textarea></label>
      <label class="wide">{t.media}<input name="media" placeholder={t.mediaPh} /></label>
    </div>

    <div class="ws-actions" style="margin-top:20px">
      <button class="btn" type="button" id="vb-make">{t.make}</button>
      <button class="btn secondary" type="button" id="vb-clear">{t.clear}</button>
    </div>
    <p class="pp-status" id="vb-status" role="status"></p>
    <div id="vb-loading" hidden style="margin-top:12px"><YarnCat label={({ en: 'Putting your brief together…', it: 'Sto preparando il riepilogo…', de: 'Übersicht wird erstellt…' } as any)[lang]} /></div>
  </form>

  <article id="vb-out" class="card vb-out" hidden>
    <div class="ws-actions" style="float:right">
      <button class="btn secondary" type="button" id="vb-copy">{t.copy}</button>
      <button class="btn secondary" type="button" id="vb-print">{t.print}</button>
      <a class="btn secondary" id="vb-email" href="#">{t.email}</a>
    </div>
    <h2 style="margin-top:0" id="vb-out-h" tabindex="-1">{t.briefTitle}</h2>
    <div id="vb-content" class="prose"></div>
    <p class="pp-hint" style="margin-top:16px">{t.footer}</p>
  </article>
</section>

<style is:global>
  #vb-form { counter-reset: vbstep; padding: 28px; }
  #vb-form h2 { font-size: 1.25rem; margin: 34px 0 10px; padding-top: 26px; border-top: 1px solid var(--line); display: flex; align-items: center; gap: 12px; }
  #vb-form h2::before { counter-increment: vbstep; content: counter(vbstep); flex: none; width: 32px; height: 32px; border-radius: 50%; background: var(--accent); color: var(--accent-ink); font-family: var(--font); font-size: .95rem; font-weight: 700; display: grid; place-items: center; }
  #vb-form h2:first-child { margin-top: 0; padding-top: 0; border-top: 0; }
  .pp-fields label.wide { grid-column: 1 / -1; }
  .vb-checks { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 6px 14px; }
  .vb-checks label { display: flex; gap: 8px; align-items: center; font-size: .95rem; }
  .vb-out { margin-top: 24px; }
  .vb-out dl { display: grid; grid-template-columns: max-content 1fr; gap: 6px 16px; margin: 0; }
  .vb-out dt { color: var(--ink-3); font-weight: 600; }
  .vb-out dd { margin: 0; }
  .vb-out h3 { margin: 18px 0 6px; font-size: 1rem; }
  @media print { .site-header, .site-footer, .hero, #vb-form, .vb-out .ws-actions, .pp-hint { display: none !important; } .vb-out { border: 0; } }
</style>

<script type="application/json" id="vb-i18n" set:html={JSON.stringify({ ...J, species_opts: t.species_opts, sex_opts: t.sex_opts, speciesQ: t.speciesQ, speciesTitle: t.speciesTitle, diary: t.diary })} />
<script>
  const J = JSON.parse(document.getElementById('vb-i18n')!.textContent!);
  const $ = (s: string) => document.querySelector(s) as HTMLElement;
  const form = $('#vb-form') as HTMLFormElement;
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

  // passport on this device → prefill
  try {
    const raw = localStorage.getItem('aiveterinary.passport.v1');
    const store = raw ? JSON.parse(raw) : null;
    const sel = $('#vb-passport') as HTMLSelectElement;
    if (store?.animals?.length) {
      for (const a of store.animals) { const o = document.createElement('option'); o.value = a.id; o.textContent = a.name || J.unnamed; sel.appendChild(o); }
      sel.addEventListener('change', () => {
        const a = store.animals.find((x: any) => x.id === sel.value); if (!a) return;
        const set = (n: string, v: string) => { const el = form.elements.namedItem(n) as HTMLInputElement | null; if (el && v) el.value = v; };
        set('name', a.name); set('species', a.species); set('breed', a.breed); set('weight', a.weight);
        (form.querySelector('[name="species"]') as HTMLSelectElement).dispatchEvent(new Event('change'));
        set('sex', a.sex && a.neutered === 'Yes' ? `${a.sex}, ${a.sex === 'Female' ? 'spayed' : 'neutered'}` : a.sex);
        if (a.dob) { const y = (Date.now() - new Date(a.dob).getTime()) / 31557600000; set('age', y < 1 ? `${Math.round(y * 12)} ${J.months}` : `${Math.floor(y)} ${J.years}`); }
        set('diary', (a.diary ?? []).filter((d: any) => d.date || d.note).slice(-8).map((d: any) => [d.date, d.note].filter(Boolean).join(': ')).join('\n'));
        set('meds', (a.medications ?? []).map((m: any) => [m.name, m.dose, m.started && `${J.since2} ${m.started}`].filter(Boolean).join(', ')).join('\n'));
        set('history', (a.conditions ?? []).map((c: any) => [c.type, c.description].filter(Boolean).join(': ')).join('; '));
        const lastVac = (a.vaccinations ?? []).map((v: any) => v.validUntil).filter(Boolean).sort().pop();
        if (lastVac) { const el = form.elements.namedItem('vacc') as HTMLSelectElement; el.selectedIndex = new Date(lastVac) > new Date() ? 1 : 2; }
        const lastPar = (a.treatments ?? []).map((t: any) => `${t.product ?? ''} ${t.date ?? ''}`.trim()).filter(Boolean).pop();
        if (lastPar) set('parasite', lastPar);
      });
    } else { (sel.closest('label') as HTMLElement).hidden = true; }
  } catch {}

  $('#vb-make').addEventListener('click', () => {
    const loading = $('#vb-loading') as HTMLElement; loading.hidden = false; ($('#vb-out') as HTMLElement).hidden = true;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    setTimeout(() => { loading.hidden = true; makeBrief(); }, reduce ? 0 : 900);
  });
  const speciesSel = form.querySelector('[name="species"]') as HTMLSelectElement;
  function renderSpeciesQ() {
    const qs = (J.speciesQ ?? {})[speciesSel.value] ?? [];
    const box = $('#vb-species') as HTMLElement; const fields = $('#vb-species-fields') as HTMLElement;
    const keep: Record<string, string> = {}; fields.querySelectorAll('input').forEach((i) => { keep[i.name] = i.value; });
    fields.innerHTML = qs.map(([k, label, ph]: string[]) => `<label class="wide">${esc(label)}<input name="sq_${k}" data-label="${esc(label)}" placeholder="${esc(ph)}" value="${esc(keep['sq_' + k] ?? '')}"></label>`).join('');
    box.hidden = qs.length === 0;
  }
  speciesSel.addEventListener('change', renderSpeciesQ);
  form.addEventListener('reset', () => setTimeout(renderSpeciesQ, 0));
  renderSpeciesQ();
  function makeBrief() {
    const d = new FormData(form);
    const g = (n: string) => String(d.get(n) ?? '').trim();
    const signs = d.getAll('signs').map(String);
    const row = (k: string, v: string) => (v ? `<dt>${esc(k)}</dt><dd>${esc(v).replace(/\n/g, '<br>')}</dd>` : '');
    const animal = [g('name'), J.species_opts[g('species')] ?? g('species'), g('breed'), J.sex_opts[g('sex')] ?? g('sex'), g('age'), g('weight') && `${g('weight')} kg`].filter(Boolean).join(' · ');
    const html = `
      <p><strong>${esc(animal || J.animal)}</strong> — ${new Date().toLocaleDateString(J.locale)}</p>
      <h3>${J.main}</h3>
      <p>${esc(g('concern')) || `<em>${J.notDescribed}</em>`}</p>
      <dl>${row(J.since, g('since'))}${row(J.freq, g('frequency'))}${row(J.trend, g('trend'))}${row(J.trigger, g('trigger'))}</dl>
      ${g('diary') ? `<h3>${esc(J.diary)}</h3><p>${esc(g('diary')).replace(/\n/g, '<br>')}</p>` : ''}
      ${(() => { const rows = Array.from(form.querySelectorAll<HTMLInputElement>('#vb-species-fields input')).filter((i) => i.value.trim()).map((i) => row(i.dataset.label ?? i.name, i.value)).join(''); return rows ? `<h3>${esc(J.speciesTitle)}</h3><dl>${rows}</dl>` : ''; })()}
      <h3>${J.signs}</h3>
      <p>${signs.length ? esc(signs.join(', ')) : J.none}${g('other') ? '. ' + esc(g('other')) : ''}</p>
      <h3>${J.food}</h3>
      <dl>${row(J.diet, g('diet'))}${row(J.meds, g('meds'))}${row(J.hist, g('history'))}${row(J.vacc, g('vacc'))}${row(J.par, g('parasite'))}${row(J.life, g('lifestyle'))}${row(J.others, g('others'))}</dl>
      ${g('questions') ? `<h3>${J.q}</h3><p>${esc(g('questions')).replace(/\n/g, '<br>')}</p>` : ''}
      ${g('media') ? `<h3>${J.media}</h3><p>${esc(g('media'))}</p>` : ''}`;
    $('#vb-content').innerHTML = html;
    {
      // mailto bodies are limited by mail clients; keep well under 2000 characters, the print covers the rest
      const text = J.title + '\n\n' + ($('#vb-content') as HTMLElement).innerText;
      const body = text.length > 1800 ? text.slice(0, 1750) + '\n…' : text;
      ($('#vb-email') as HTMLAnchorElement).href = `mailto:?subject=${encodeURIComponent(J.title + (g('name') ? ' – ' + g('name') : ''))}&body=${encodeURIComponent(body)}`;
    }
    ($('#vb-out') as HTMLElement).hidden = false;
    $('#vb-out').scrollIntoView({ behavior: 'smooth', block: 'start' });
    ($('#vb-out-h') as HTMLElement).focus({ preventScroll: true });
  }
  $('#vb-clear').addEventListener('click', () => { form.reset(); ($('#vb-out') as HTMLElement).hidden = true; });
  $('#vb-print').addEventListener('click', () => window.print());
  $('#vb-copy').addEventListener('click', () => {
    const t = ($('#vb-content') as HTMLElement).innerText;
    navigator.clipboard?.writeText(J.title + '\n\n' + t).then(() => { $('#vb-status').textContent = J.copied; });
  });
</script>
