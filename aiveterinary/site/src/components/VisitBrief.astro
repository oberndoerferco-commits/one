    trend: 'Besser, schlimmer oder gleich?', trendOpts: ['Besser', 'Gleich', 'Schlimmer', 'Kommt und geht'], trigger: 'Ist vorher etwas passiert?', triggerPh: 'neues Futter, Waldspaziergang, Besuch, etwas gefressen…',
    noticed: 'Was Ihnen sonst aufgefallen ist',
    signs: ['Frisst weniger', 'Frisst gar nicht', 'Trinkt mehr', 'Trinkt weniger', 'Erbrechen', 'Durchfall', 'Verstopfung', 'Pressen beim Urinieren', 'Uriniert häufiger', 'Husten', 'Niesen', 'Atmet anders', 'Lahmt', 'Kratzt sich / Juckreiz', 'Matt, schläft mehr', 'Unruhig, läuft umher', 'Versteckt sich', 'Aggressives oder ungewohntes Verhalten', 'Gewichtsverlust', 'Gewichtszunahme', 'Knoten oder Schwellung', 'Übler Geruch (Maul, Ohren, Haut)'],
    other: 'Sonstiges', food: 'Futter, Medikamente, Vorgeschichte', diet: 'Was frisst Ihr Tier (Marke, Art, Leckerlis, Reste)?', meds: 'Aktuelle Medikamente oder Ergänzungsmittel, genau wie auf dem Etikett', medsPh: 'Name, Stärke, wie oft, seit wann',
    history: 'Bekannte Erkrankungen, Allergien, frühere Operationen', vacc: 'Impfungen aktuell?', vaccOpts: ['Ja', 'Nein', 'Nicht sicher'], parasite: 'Letzte Parasitenbehandlung (Floh/Zecke/Wurm)', parasitePh: 'z. B. vor 3 Wochen, Präparatname',
    lifestyle: 'Wohnung / Freigang / kürzlich gereist?', others: 'Andere Tiere im Haushalt, geht es ihnen gut?', forVet: 'Für die Praxis', questions: 'Fragen, die Sie stellen möchten', media: 'Fotos oder Videos, die Sie zeigen (was und wann)', mediaPh: 'z. B. Video vom Lahmen heute Morgen auf dem Handy',
    make: 'Übersicht erstellen', clear: 'Leeren', copy: 'Kopieren', print: 'Drucken / als PDF speichern', email: 'Per E-Mail an die Praxis', diary: 'Aus dem Symptomtagebuch (letzte Einträge)', briefTitle: 'Übersicht für den Tierarztbesuch', footer: 'Vom Halter mit aiveterinary.org vorbereitet. Dies ist die Schilderung des Halters, keine klinische Akte. Diese Seite ordnet Ihre Antworten per Software; sie enthält keine KI-generierten medizinischen Inhalte und keine Diagnose.',
    speciesTitle: 'Fragen, die die Praxis zu diesem Tier stellt',
    speciesQ: {
      Dog: [['stool', 'Kot: normal, weich, blutig, keiner?', ''], ['exercise', 'Beim Spaziergang schneller müde?', 'ja / nein / unsicher'], ['scavenge', 'Könnte es etwas gefressen haben (Müll, Knochen, Schokolade, Trauben, Pflanzen)?', '']],
      Cat: [['litter', 'Katzenklo: normaler Urinabsatz, Pressen, unsauber?', ''], ['water', 'Trinkt mehr als sonst?', 'ja / nein / unsicher'], ['hiding', 'Versteckt sich, putzt sich weniger, miaut mehr?', ''], ['outdoor', 'Nur Wohnung oder Freigang?', '']],
      Rabbit: [['droppings', 'Köttel in den letzten 12 Stunden: normal, kleiner, weniger, keine?', ''], ['hay', 'Frisst noch Heu?', 'ja / weniger / nein'], ['teeth', 'Speicheln, nasses Kinn, lässt Futter fallen?', ''], ['lastate', 'Wann zuletzt gefressen?', 'z. B. heute Morgen']],
      'Guinea pig': [['droppings', 'Köttel in den letzten 12 Stunden: normal, kleiner, weniger, keine?', ''], ['hay', 'Frisst noch Heu?', 'ja / weniger / nein'], ['teeth', 'Speicheln, nasses Kinn, lässt Futter fallen?', ''], ['lastate', 'Wann zuletzt gefressen?', 'z. B. heute Morgen']],
      Horse: [['manure', 'Kot: Menge und Konsistenz normal?', ''], ['colic', 'Scharren, zur Flanke schauen, Hinlegen und Aufstehen?', ''], ['feed', 'Änderung bei Futter, Weide oder Wasser?', '']],
      Bird: [['droppings', 'Kot: Farbe, Konsistenz, Menge?', ''], ['fluffed', 'Aufgeplustert, am Käfigboden, Schwanzwippen beim Atmen?', ''], ['diet', 'Futter: Körner, Pellets, Frischfutter?', '']],
