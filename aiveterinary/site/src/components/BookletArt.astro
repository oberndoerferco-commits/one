---
/**
 * Health booklet illustration: the sketch cat sitting against an upright booklet with a paw on
 * the cover and a ribbon bookmark. Same pen and palette as the animal drawings
 * (docs/32-illustration-style.md). Decorative.
 */
import './art.css';
import { place } from './animal-art';
interface Props { size?: number; class?: string }
const { size = 360, class: cls = '' } = Astro.props;
const SW = 2.8;
const W = 'transform="translate(2 2.6)" stroke="none"';
const cover = 'x="72" y="76" width="104" height="154" rx="10"';
const art = `
<path d="M36 150C28 86 84 36 160 38c76 2 124 54 118 118-6 58-56 82-116 80H96c-38-2-54-40-60-86z" fill="var(--sk-paper)" stroke="none"/>
<path d="M62 238h188" stroke="var(--sk-shadow)" stroke-width="6"/>
<g transform="rotate(-6 124 154)">
  <rect x="80" y="80" width="102" height="152" rx="9" fill="var(--hs-cream)"/>
  <rect ${cover} fill="var(--accent)" ${W}/><rect ${cover}/>
  <path d="M88 79v148" stroke-width="2"/>
  <rect x="102" y="100" width="58" height="15" rx="7.5" fill="var(--surface)" stroke="none"/>
  <g fill="var(--surface)" stroke="none"><path d="M131 160c9 0 17 7 17 15 0 6-5 9-10 8-3 0-5-2-7-2s-4 2-7 2c-5 1-10-2-10-8 0-8 8-15 17-15z"/><ellipse cx="111" cy="152" rx="5.6" ry="7" transform="rotate(-22 111 152)"/><ellipse cx="124" cy="141" rx="5.6" ry="7.4"/><ellipse cx="139" cy="141" rx="5.6" ry="7.4"/><ellipse cx="151" cy="152" rx="5.6" ry="7" transform="rotate(22 151 152)"/></g>
  <path d="M148 229v15l5-4 5 4v-15" fill="var(--sk-accent)"/>
</g>
${place('cat', 296, 89, -3.3, SW)}
<path d="M56 88c-10-7-14-13-10-18 3-4 8-3 10 1 2-4 7-5 10-1 4 5 0 11-10 18z" fill="var(--sk-accent)" stroke-width="2.2"/>
<circle cx="252" cy="58" r="3.4" fill="var(--hs-dog-2)" stroke="none"/><circle cx="38" cy="124" r="2.6" fill="var(--hs-dog-2)" stroke="none"/>
`;
---
<svg class={`booklet-art sk ${cls}`} width={size} height={Math.round(size * 0.88)} viewBox="0 0 300 264" fill="none" stroke="var(--sk-line)" stroke-width={SW} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <Fragment set:html={art} />
</svg>
