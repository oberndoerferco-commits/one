const sc = SCAN[lang];
const PROF = { en: { y: 'years', y1: 'year', m: 'months', chip: 'Chip', next: 'Next', unnamed: 'New animal' }, it: { y: 'anni', y1: 'anno', m: 'mesi', chip: 'Chip', next: 'Prossima scadenza', unnamed: 'Nuovo animale' }, de: { y: 'Jahre', y1: 'Jahr', m: 'Monate', chip: 'Chip', next: 'Als Nächstes', unnamed: 'Neues Tier' } }[lang];
---
  <section class="wrap hero hero-split" id="pp-intro">
    <div>
    <p class="eyebrow">{t.eyebrow}</p>
    <h1>{t.h1}</h1>
    <p class="lead">{t.lead}</p>
    <ul class="ticks ticks-plain">{t.privTicks.map((x: string) => <li>{x}</li>)}</ul>
    </div>
    <div class="hero-side"><BookletArt /></div>
  </section>

  <section class="wrap" id="pp-account" hidden>
    <div class="card pp-acct">
      <div id="pp-acct-out">
        <div>
          <strong>{t.acctTitle}</strong>
          <p class="pp-hint" style="margin:4px 0 0">Optional. Log in with a link sent to your email and your passports follow you to every device. <a href="/privacy">{t.acctPrivacy}</a> · <a href="/terms">{t.acctTerms}</a></p>
        </div>
        <form id="pp-login" class="form-row">
          <label class="sr" for="pp-login-email">{t.acctEmail}</label>
          <input id="pp-login-email" type="email" placeholder={t.phEmail} required autocomplete="email" />
          <button class="btn" type="submit">{t.acctSend}</button>
        </form>
      </div>
      <div id="pp-acct-in" hidden>
        <div><strong>{t.acctIn}</strong> {t.as} <span id="pp-acct-email"></span> · <span id="pp-sync-state">{t.synced}</span></div>
        <div class="pp-acct-actions">
          <button class="btn secondary" id="pp-acct-export" type="button">{t.acctExport}</button>
          <button class="btn secondary" id="pp-acct-logout" type="button">{t.acctLogout}</button>
          <button class="btn secondary pp-danger" id="pp-acct-delete" type="button">{t.acctDelete}</button>
        </div>
      </div>
      <p class="pp-status" id="pp-acct-status" aria-live="polite"></p>
    </div>
  </section>

  <section class="wrap" id="pp-app">
    <div class="pp-toolbar">
      <label class="sr" for="pp-select">{t.selAria}</label>
      <select id="pp-select" aria-label={t.selChoose}></select>
      <button class="btn secondary" id="pp-new" type="button">{t.newAnimal}</button>
      <span class="pp-spacer"></span>
      <button class="btn secondary" id="pp-export" type="button">{t.backup}</button>
      <label class="btn secondary" for="pp-import">{t.restore}<input id="pp-import" type="file" accept="application/json,.json" class="sr" /></label>
      <button class="btn secondary" id="pp-print" type="button">{t.print}</button>
      <label class="btn secondary" for="pp-scan-file">{sc.btn}</label>
      <details class="pp-more">
        <summary class="btn secondary">{({ en: 'More', it: 'Altro', de: 'Mehr' } as any)[lang]}</summary>
        <div class="pp-more-menu">
      <button class="btn secondary" id="pp-card" type="button" hidden>{t.card}</button>
      <button class="btn secondary" id="pp-poster" type="button" hidden>{t.poster}</button>
      <button class="btn secondary" id="pp-claim" type="button" hidden>{t.claim}</button>
      <label class="pp-print-lang" hidden><span class="sr">{t.printLang}</span><select id="pp-print-lang" aria-label={t.printLang}><option value="">{t.printLang}: {t.printLangNone}</option>{(['en', 'it', 'de'] as const).filter((l) => l !== lang).map((l) => <option value={l}>{t.printLang}: {({ en: 'English', it: 'Italiano', de: 'Deutsch' })[l]}</option>)}</select></label>
      <button class="btn secondary pp-danger" id="pp-delete" type="button">{t.delete}</button>
        </div>
      </details>
    </div>

    <div id="pp-loading" hidden style="margin:12px 0"><YarnCat label={({ en: 'Restoring…', it: 'Ripristino in corso…', de: 'Wird wiederhergestellt…' } as any)[lang]} /></div>
    <input id="pp-scan-file" type="file" accept="image/*" capture="environment" class="sr" />
    <dialog id="pp-scan" class="pp-scan" aria-labelledby="pp-scan-h">
      <h2 id="pp-scan-h">{sc.title}</h2>
      <p class="pp-hint">{sc.intro}</p>
      <div id="pp-scan-busy" hidden><YarnCat label={sc.reading} /></div>
      <p id="pp-scan-msg" class="pp-status" aria-live="polite"></p>
      <p id="pp-scan-check" class="pp-hint" hidden>{sc.check}</p>
      <ul id="pp-scan-list" class="pp-scan-list"></ul>
      <p class="pp-scan-actions"><button class="btn" id="pp-scan-add" type="button" hidden>{sc.add}</button> <button class="btn secondary" id="pp-scan-cancel" type="button">{sc.cancel}</button></p>
    </dialog>
    <div id="pp-empty" class="pp-empty" hidden>
      <h2>{t.emptyTitle}</h2>
      <p>{t.emptyText}</p>
      <p class="pp-empty-actions"><button class="btn lg" id="pp-empty-new" type="button">{t.emptyBtn}</button> <label class="pp-empty-restore" for="pp-import">{t.restore}</label> <label class="pp-empty-restore" for="pp-scan-file">{sc.btn}</label></p>
    </div>

    <div id="pp-form" hidden>
      <div class="pp-profile" id="pp-profile" aria-live="polite">
        <div class="pp-avatar" id="pp-avatar"></div>
        <div class="pp-prof-text"><div class="pp-prof-name" id="pp-prof-name"></div><div class="pp-prof-sub" id="pp-prof-sub"></div><div class="pp-prof-next" id="pp-prof-next"></div></div>
      </div>
      <nav class="pp-jump" aria-label={t.selAria}>{([['pp-sec-identity', t.identity], ['pp-upcoming', t.upcoming], ['pp-sec-vaccinations', t.vaccinations], ['pp-sec-treatments', t.treatments], ['pp-sec-medications', t.medications], ['pp-sec-conditions', t.conditions], ['pp-sec-visits', t.visits], ['pp-sec-diary', t.diary], ['pp-sec-weights', t.weights]] as [string, string][]).map(([id, l]) => <a href={`#${id}`}>{l}</a>)}</nav>
      <div class="pp-grid">
        <section class="card" id="pp-sec-identity">
          <h2>{t.identity}</h2>
          <div class="pp-photo-row">
            <img id="pp-photo" alt="" hidden />
            <div>
              <label class="btn secondary" for="pp-photo-input">{t.addPhoto}<input id="pp-photo-input" type="file" accept="image/*" class="sr" /></label>
              <button class="btn secondary" id="pp-photo-remove" type="button" hidden>{t.removePhoto}</button>
            </div>
          </div>
          <div class="pp-fields">
            <label>{t.name}<input data-f="name" required /></label>
            <label>{t.species}<select data-f="species"><option value="">—</option>{speciesOpts.map((o) => <option value={o}>{opt[o]}</option>)}</select></label>
            <label>{t.breed}<input data-f="breed" /></label>
            <label>{t.sex}<select data-f="sex"><option value="">—</option><option value="Female">{opt.Female}</option><option value="Male">{opt.Male}</option></select></label>
            <label>{t.neutered}<select data-f="neutered"><option value="">—</option><option value="Yes">{opt.Yes}</option><option value="No">{opt.No}</option></select></label>
            <label>{t.dob}<input data-f="dob" type="date" /></label>
            <label>{t.colour}<input data-f="colour" /></label>
            <label>{t.weight}<input data-f="weight" type="number" step="0.1" min="0" /></label>
            <label>{t.microchip}<input data-f="microchip" inputmode="numeric" placeholder={t.phChip} /><span class="pp-hint pp-chip-hint" hidden>{({ en: "A microchip number has 15 digits (ISO 11784/11785). Check the number on the implant certificate or the registry.", it: "Il numero del microchip ha 15 cifre (ISO 11784/11785). Controlla il numero sul certificato di impianto o nell'anagrafe.", de: "Eine Chipnummer hat 15 Ziffern (ISO 11784/11785). Prüfen Sie die Nummer auf dem Implantationsnachweis oder im Register." } as any)[lang]}</span></label>
            <label>{t.microchipDate}<input data-f="microchipDate" type="date" /></label>
            <label>{t.microchipRegistry}<input data-f="microchipRegistry" placeholder={t.phRegistry} /></label>
            <label>{t.passportNo}<input data-f="passportNo" placeholder={t.phPassport} /></label>
          </div>
        </section>

        <section class="card">
          <h2>{t.ownerVet}</h2>
          <div class="pp-fields">
            <label>{t.ownerName}<input data-f="ownerName" /></label>
            <label>{t.ownerPhone}<input data-f="ownerPhone" type="tel" /></label>
            <label>{t.ownerEmail}<input data-f="ownerEmail" type="email" /></label>
            <label>{t.ownerAddress}<input data-f="ownerAddress" /></label>
            <label>{t.vetClinic}<input data-f="vetClinic" /></label>
            <label>{t.vetPhone}<input data-f="vetPhone" type="tel" /></label>
            <label>{t.emergencyClinic}<input data-f="emergencyClinic" /></label>
            <label>{t.emergencyPhone}<input data-f="emergencyPhone" type="tel" /></label>
            <label>{t.insurance}<input data-f="insurance" placeholder={t.phInsurance} /></label>
          </div>
        </section>
      </div>

