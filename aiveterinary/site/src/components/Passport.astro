    // ---- Import from photo: on-device OCR, every suggestion ticked by the owner before it is added ----
    const SC = JSON.parse(document.getElementById('pp-scan-i18n')!.textContent!);
    const scanDlg = $<HTMLDialogElement>('#pp-scan');
    const esc = (v: string) => v.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' } as any)[c]);
    let ocrWorker: any = null;
    async function ocr(file: File): Promise<string> {
      if (!ocrWorker) {
        const src = '/ocr/tesseract.esm.min.js'; const mod: any = await import(/* @vite-ignore */ src); const T: any = mod.default ?? mod;
        ocrWorker = await T.createWorker(SC.lang, 1, { workerPath: '/ocr/worker.min.js', corePath: '/ocr/', langPath: '/ocr/lang', gzip: true, workerBlobURL: false });
      }
      const { data } = await ocrWorker.recognize(file);
      return data.text as string;
    }
    $<HTMLInputElement>('#pp-scan-file').addEventListener('change', async (e) => {
      const input = e.target as HTMLInputElement; const file = input.files?.[0]; input.value = '';
      if (!file) return;
      const list = $('#pp-scan-list'), msg = $('#pp-scan-msg'), busy = $<HTMLElement>('#pp-scan-busy'), add = $<HTMLElement>('#pp-scan-add'), check = $<HTMLElement>('#pp-scan-check');
      list.innerHTML = ''; msg.textContent = ''; add.hidden = true; check.hidden = true;
      scanDlg.showModal();
      if (file.type === 'application/pdf') { msg.textContent = SC.pdf; return; }
      busy.hidden = false;
      try {
        const r = parseScan(await ocr(file));
        busy.hidden = true;
        const items: string[] = [];
        r.microchip.forEach((c) => items.push(`<li><label><input type="checkbox" data-k="chip"> ${SC.chip} <input class="pp-scan-v" data-v="chip" value="${esc(c)}" inputmode="numeric"></label></li>`));
        r.vaccinations.forEach((v, i) => items.push(`<li><label><input type="checkbox" data-k="vacc" data-i="${i}"> ${SC.vacc}</label>
          <input class="pp-scan-v" data-i="${i}" data-v="vaccine" value="${esc(SC.names[v.vaccine] ?? v.vaccine)}">
          <span>${SC.date}</span> <input class="pp-scan-v" type="date" data-i="${i}" data-v="date" value="${v.date ?? ''}">
          <span>${SC.valid}</span> <input class="pp-scan-v" type="date" data-i="${i}" data-v="validUntil" value="${v.validUntil ?? ''}">
          <span>${SC.batch}</span> <input class="pp-scan-v" data-i="${i}" data-v="batch" value="${esc(v.batch ?? '')}">
          <small class="pp-hint">“${esc(v.line.slice(0, 80))}”</small></li>`));
        list.innerHTML = items.join('');
        if (!items.length) msg.textContent = SC.none; else { check.hidden = false; add.hidden = false; }
      } catch (err) { console.error('ocr', err); busy.hidden = true; msg.textContent = SC.fail; }
    });
    $('#pp-scan-cancel').addEventListener('click', () => scanDlg.close());
    $('#pp-scan-add').addEventListener('click', () => {
      let a = current();
      if (!a) { a = blank(); store.animals.push(a); store.current = a.id; }
      const val = (sel: string) => ($<HTMLInputElement>(sel, scanDlg)?.value ?? '').trim();
      let note = SC.added;
      for (const cb of $$<HTMLInputElement>('input[type=checkbox]:checked', scanDlg)) {
