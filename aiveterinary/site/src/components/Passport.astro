      const esc = (v: any) => String(v ?? '').replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' } as any)[c]);
      q('name').textContent = a.name || J.unnamed; q('animal').textContent = [a.species, a.breed, a.sex, a.dob && `${J.cols?.['Date'] ?? ''} ${a.dob}`.trim()].filter(Boolean).join(' · ');
      q('microchip').textContent = a.microchip || '—'; q('owner').textContent = [a.ownerName, a.ownerAddress].filter(Boolean).join(', ') || '—'; q('insurance').textContent = a.insurance || '—';
      q('visits').innerHTML = (a.visits ?? []).filter((v: any) => v.date || v.reason).map((v: any) => `<tr><td>${esc(v.date)}</td><td>${esc(v.reason)}</td><td>${esc(v.outcome)}</td><td>${esc(v.clinic)}</td></tr>`).join('') || '<tr><td colspan="4">—</td></tr>';
      q('meds').innerHTML = (a.medications ?? []).filter((m: any) => m.name).map((m: any) => `<li>${esc(m.name)} ${esc(m.dose)}${m.started ? ` (${esc(m.started)})` : ''}</li>`).join('') || '<li>—</li>';
      q('conds').innerHTML = (a.conditions ?? []).filter((c: any) => c.description || c.type).map((c: any) => `<li>${esc([c.type, c.description].filter(Boolean).join(': '))}${c.date ? ` (${esc(c.date)})` : ''}</li>`).join('') || '<li>—</li>';
      const view = $('#pp-claim-view') as HTMLElement; view.hidden = false; view.setAttribute('aria-hidden', 'false');
      document.body.classList.add('pp-print-claim');
