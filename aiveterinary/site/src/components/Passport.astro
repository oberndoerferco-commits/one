        $('#pp-acct-delete')!.addEventListener('click', async () => {
          if (!confirm(J.confirmAcctDelete)) return;
          const { error } = await this.client.rpc('delete_my_account');
          if (error) { this.st(J.deleteFail + error.message); return; }
          await this.client.auth.signOut(); this.setUser(null); this.st(J.acctDeleted);
        });
        this.client.auth.onAuthStateChange((_evt: string, session: any) => { this.setUser(session?.user ?? null); if (session?.user) this.pull(); });
        const { data } = await this.client.auth.getSession();
        this.setUser(data.session?.user ?? null); if (this.user) this.pull();
      },
      setUser(u: any) {
        this.user = u ? { id: u.id, email: u.email } : null;
        ($('#pp-acct-out') as HTMLElement).hidden = !!this.user;
        ($('#pp-acct-in') as HTMLElement).hidden = !this.user;
        if (this.user) $('#pp-acct-email')!.textContent = this.user.email ?? '';
      },
      async pull() {
        const { data, error } = await this.client.from('passports').select('id, animal, updated_at');
        if (error) { this.st(J.loadFail + error.message); return; }
        const remote: Animal[] = (data ?? []).map((r: any) => ({ ...blank(), ...r.animal, id: r.id, _updated: r.updated_at }));
        if (remote.length === 0 && store.animals.length > 0) {
          if (confirm(J.confirmUpload.replace('{n}', String(store.animals.length)))) { store.animals.forEach((a) => this.dirty.add(a.id)); this.push(true); }
          return;
        }
        for (const r of remote) {
          const i = store.animals.findIndex((x) => x.id === r.id);
          if (i >= 0) { if (!store.animals[i]._updated || store.animals[i]._updated <= r._updated) store.animals[i] = r; }
          else store.animals.push(r);
        }
        // local-only animals (created while offline) go up
        for (const a of store.animals) if (!remote.find((r) => r.id === a.id)) this.dirty.add(a.id);
        store.current = store.current && store.animals.find((a) => a.id === store.current) ? store.current : store.animals[0]?.id ?? null;
        render(); localStorage.setItem(KEY, JSON.stringify(store)); this.push(true); this.st(J.loaded);
      },
      push(now = false) {
        if (!this.user) return;
        const a = current(); if (a && !now) this.dirty.add(a.id);
        clearTimeout(this.pushTimer);
        this.pushTimer = window.setTimeout(async () => {
          const rows = store.animals.filter((x) => this.dirty.has(x.id)).map((x) => { const { _updated, ...animal } = x; return { id: x.id, user_id: this.user!.id, animal }; });
          if (!rows.length) return;
          $('#pp-sync-state')!.textContent = J.saving;
          const { error } = await this.client.from('passports').upsert(rows);
          $('#pp-sync-state')!.textContent = error ? J.notSaved + error.message : J.synced;
          if (!error) this.dirty.clear();
        }, now ? 0 : 800);
      },
      async remove(id: string) { if (this.user) await this.client.from('passports').delete().eq('id', id); },
    };

    render();
    acct.init();
  </script>

<script>
  // Microchip numbers are 15 digits under ISO 11784/11785; anything else is almost always a typo.
  document.addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement;
    if (!el.matches('[data-f="microchip"]')) return;
    const digits = el.value.replace(/[\s-]/g, '');
    const bad = digits.length > 0 && !/^\d{15}$/.test(digits);
    el.setCustomValidity(bad ? 'invalid' : '');
    el.classList.toggle('pp-invalid', bad);
    const hint = el.parentElement?.querySelector('.pp-chip-hint') as HTMLElement | null;
    if (hint) hint.hidden = !bad;
  });
</script>
