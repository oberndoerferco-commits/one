const OPT = {"en": {"Dog": "Dog", "Cat": "Cat", "Ferret": "Ferret", "Rabbit": "Rabbit", "Guinea pig": "Guinea pig", "Hamster": "Hamster", "Horse": "Horse", "Bird": "Bird", "Reptile": "Reptile", "Other": "Other", "Female": "Female", "Male": "Male", "Yes": "Yes", "No": "No"}, "it": {"Dog": "Cane", "Cat": "Gatto", "Ferret": "Furetto", "Rabbit": "Coniglio", "Guinea pig": "Porcellino d'India", "Hamster": "Criceto", "Horse": "Cavallo", "Bird": "Uccello", "Reptile": "Rettile", "Other": "Altro", "Female": "Femmina", "Male": "Maschio", "Yes": "Sì", "No": "No"}, "de": {"Dog": "Hund", "Cat": "Katze", "Ferret": "Frettchen", "Rabbit": "Kaninchen", "Guinea pig": "Meerschweinchen", "Hamster": "Hamster", "Horse": "Pferd", "Bird": "Vogel", "Reptile": "Reptil", "Other": "Sonstiges", "Female": "Weiblich", "Male": "Männlich", "Yes": "Ja", "No": "Nein"}} as const;
