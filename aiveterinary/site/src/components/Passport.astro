  <script type="application/json" id="pp-l2" set:html={JSON.stringify(Object.fromEntries((["en", "it", "de"] as const).map((l) => [l, { ...Object.fromEntries(Object.entries(T[l]).filter(([, v]) => typeof v === "string")), cols: (JS[l] as any).cols }])))} />
  <script type="application/json" id="pp-prof-i18n" set:html={JSON.stringify(PROF)} />
  <script type="application/json" id="pp-scan-i18n" set:html={JSON.stringify({ ...sc, lang: ({ en: "eng", it: "ita", de: "deu" } as any)[lang] })} />
  <script type="application/json" id="pp-i18n" set:html={JSON.stringify({ ...j, posterWhere: t.posterWhere, locale: ({ en: 'en-GB', it: 'it-IT', de: 'de-DE' } as any)[lang], upcoming: { overdue: t.overdue, dueIn: t.dueIn, dueToday: t.dueToday, none: t.noUpcoming, vacc: t.vaccinations, treat: t.treatments, plan: ({ en: 'planned, confirm with your vet', it: 'in programma, da confermare con il veterinario', de: 'geplant, mit der Praxis abstimmen' } as any)[lang] } })} />

  <script>
    import { parseScan } from 'aiveterinary-app/src/scan.ts';
    import { ICONS } from '../lib/animal-icons';
    // Digital pet passport. Local-first: all data lives in localStorage under one key.
    // Shape: { version: 1, animals: [ { id, name, ..., vaccinations: [], treatments: [], medications: [], conditions: [], visits: [], notes, photo } ], current }
    type Row = Record<string, string>;
    type Animal = Record<string, any> & { id: string; vaccinations: Row[]; treatments: Row[]; medications: Row[]; conditions: Row[]; visits: Row[]; weights: Row[]; diary: Row[] };
    type Store = { version: number; animals: Animal[]; current: string | null };

    const KEY = 'aiveterinary.passport.v1';
    const J = JSON.parse(document.getElementById('pp-i18n')!.textContent!);
    const LISTS: Record<string, { cols: { key: string; label: string; type?: string; options?: string[] }[] }> = {
      vaccinations: { cols: [
        { key: 'vaccine', label: J.cols["Vaccine"] }, { key: 'date', label: J.cols["Date given"], type: 'date' }, { key: 'validUntil', label: J.cols["Valid until"], type: 'date' },
        { key: 'clinic', label: J.cols["Clinic / vet"] }, { key: 'batch', label: J.cols["Batch"] } ] },
      treatments: { cols: [
        { key: 'product', label: J.cols["Product"] }, { key: 'date', label: J.cols['Date'], type: 'date' }, { key: 'nextDue', label: J.cols["Next due"], type: 'date' }, { key: 'givenBy', label: J.cols["Given by"] } ] },
      medications: { cols: [
        { key: 'name', label: J.cols["Medication"] }, { key: 'dose', label: J.cols["Dose & how often"] }, { key: 'started', label: J.cols["Started"], type: 'date' }, { key: 'prescribedBy', label: J.cols["Prescribed by"] } ] },
      conditions: { cols: [
        { key: 'type', label: J.cols["Type"], type: 'select', options: J.condTypes }, { key: 'description', label: J.cols["Description"] }, { key: 'date', label: J.cols["Since / date"], type: 'date' } ] },
      diary: { cols: [ { key: 'date', label: J.cols['Date'], type: 'date' }, { key: 'note', label: J.cols['Observation'] } ] },
      weights: { cols: [
        { key: 'date', label: J.cols['Date'], type: 'date' }, { key: 'kg', label: J.cols['Weight (kg)'], type: 'number' }, { key: 'bcs', label: J.cols['Body condition (1–9)'], type: 'number' }, { key: 'note', label: J.cols['Note'] } ] },
      visits: { cols: [
        { key: 'date', label: J.cols['Date'], type: 'date' }, { key: 'reason', label: J.cols["Reason"] }, { key: 'outcome', label: J.cols["Outcome / notes"] }, { key: 'clinic', label: J.cols["Clinic"] } ] },
    };

    const $ = <T extends Element>(s: string, root: ParentNode = document) => root.querySelector(s) as T;
    const $$ = <T extends Element>(s: string, root: ParentNode = document) => Array.from(root.querySelectorAll(s)) as T[];
    const uid = () => Math.random().toString(36).slice(2, 10) + Date.now().toString(36);

    function load(): Store {
      try {
        const raw = localStorage.getItem(KEY);
        if (raw) { const s = JSON.parse(raw); if (s && Array.isArray(s.animals)) return s; }
      } catch {}
      return { version: 1, animals: [], current: null };
    }
    let store: Store = load();
    let saveTimer: number | undefined;
    function save(msg = J.saved) {
      try { localStorage.setItem(KEY, JSON.stringify(store)); status(acct.user ? J.savedAcct : msg); }
      catch { status(J.saveFail); }
      acct.push();
    }
    function scheduleSave() { clearTimeout(saveTimer); saveTimer = window.setTimeout(() => save(), 400); }
    // Flush a pending debounced save when the page is hidden or closed, so a quick tab close never loses the last edit.
    window.addEventListener('pagehide', () => { if (saveTimer) { clearTimeout(saveTimer); saveTimer = 0; try { localStorage.setItem(KEY, JSON.stringify(store)); } catch {} } });
    function status(t: string) { const el = $('#pp-status'); if (el) el.textContent = t; }

    const blank = (): Animal => ({ id: uid(), name: '', vaccinations: [], treatments: [], medications: [], conditions: [], visits: [], weights: [], diary: [], notes: '' });
    const current = () => store.animals.find((a) => a.id === store.current) ?? null;

    function renderSelect() {
      const sel = $<HTMLSelectElement>('#pp-select');
      sel.innerHTML = '';
      for (const a of store.animals) {
        const o = document.createElement('option');
        o.value = a.id; o.textContent = a.name || J.unnamed; sel.appendChild(o);
      }
      sel.value = store.current ?? '';
      sel.hidden = store.animals.length === 0;
    }

    function renderList(name: string, a: Animal) {
      const sec = $(`[data-list="${name}"]`);
      const tbody = $('tbody', sec)!;
      tbody.innerHTML = '';
      const { cols } = LISTS[name];
      a[name].forEach((row: Row, i: number) => {
        const tr = document.createElement('tr');
        for (const c of cols) {
          const td = document.createElement('td'); td.dataset.label = c.label;
          let input: HTMLInputElement | HTMLSelectElement;
          if (c.type === 'select') {
            input = document.createElement('select');
            for (const opt of ['', ...(c.options ?? [])]) { const o = document.createElement('option'); o.value = opt; o.textContent = opt || '—'; input.appendChild(o); }
          } else { input = document.createElement('input'); input.type = c.type ?? 'text'; }
          input.value = row[c.key] ?? '';
          input.setAttribute('aria-label', c.label);
          input.addEventListener('input', () => { row[c.key] = input.value; scheduleSave(); if (name === 'vaccinations' || name === 'treatments') { renderUpcoming(a); renderProfile(a); } if (name === 'weights') renderChart(a); });
          td.appendChild(input); tr.appendChild(td);
        }
        const td = document.createElement('td');
        const rm = document.createElement('button'); rm.type = 'button'; rm.className = 'pp-rm'; rm.textContent = '×'; rm.setAttribute('aria-label', J.removeRow);
        rm.addEventListener('click', () => { a[name].splice(i, 1); renderList(name, a); renderUpcoming(a); renderChart(a); save(J.rowRemoved); });
        td.appendChild(rm); tr.appendChild(td); tbody.appendChild(tr);
      });
    }

    function renderForm() {
      const a = current();
      const form = $('#pp-form') as HTMLElement, empty = $('#pp-empty') as HTMLElement;
      form.hidden = !a; empty.hidden = !!a; ($('.pp-toolbar') as HTMLElement).hidden = !a;
      $('#pp-delete')!.toggleAttribute('hidden', !a);
      $('#pp-print')!.toggleAttribute('hidden', !a);
      $('#pp-card')!.toggleAttribute('hidden', !a);
      $('#pp-poster')!.toggleAttribute('hidden', !a);
      $('#pp-claim')!.toggleAttribute('hidden', !a);
      $('.pp-print-lang')!.toggleAttribute('hidden', !a);
      $('h1')!.setAttribute('data-animal', a?.name ?? '');
      if (!a) return;
      for (const el of $$<HTMLInputElement>('[data-f]', form)) el.value = a[el.dataset.f!] ?? '';
      const img = $<HTMLImageElement>('#pp-photo');
      img.hidden = !a.photo; if (a.photo) img.src = a.photo;
      $('#pp-photo-remove')!.toggleAttribute('hidden', !a.photo);
      for (const name of Object.keys(LISTS)) { a[name] ??= []; renderList(name, a); }
      renderUpcoming(a);
      renderChart(a);
      renderProfile(a);
    }

    const PR = JSON.parse(document.getElementById('pp-prof-i18n')!.textContent!);
    const ICON_OF: Record<string, string> = { Dog: 'dog', Cat: 'cat', Rabbit: 'rabbit', 'Guinea pig': 'rabbit', Hamster: 'rabbit', Horse: 'horse', Bird: 'bird' };
    function renderProfile(a: Animal) {
      const av = $('#pp-avatar');
      av.innerHTML = a.photo ? `<img src="${a.photo}" alt="">` : `<svg viewBox="0 0 48 48" width="64" height="64" fill="none" stroke="var(--art-ink)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[ICON_OF[a.species] ?? 'paw']}</svg>`;
      av.className = `pp-avatar pet-${ICON_OF[a.species] ?? 'general'}`;
      $('#pp-prof-name').textContent = a.name || PR.unnamed;
      let age = '';
      if (a.dob) { const ms = Date.now() - Date.parse(a.dob); const mo = Math.floor(ms / (30.44 * 864e5)); age = mo < 12 ? `${Math.max(mo, 0)} ${PR.m}` : `${Math.floor(mo / 12)} ${Math.floor(mo / 12) === 1 ? PR.y1 : PR.y}`; }
      const optLabel = (f: string) => { const sel = $<HTMLSelectElement>(`#pp-form [data-f="${f}"]`); return sel?.selectedOptions?.[0]?.value ? sel.selectedOptions[0].textContent : ''; };
      $('#pp-prof-sub').textContent = [optLabel('species'), a.breed, age, a.microchip ? `${PR.chip} ${a.microchip}` : ''].filter(Boolean).join(' · ');
      const next = dueItems(a).sort((x, y) => x.date.localeCompare(y.date)).find((x) => x.date >= new Date().toISOString().slice(0, 10)) ?? null;
      $('#pp-prof-next').textContent = next ? `${PR.next}: ${next.label} · ${new Date(next.date).toLocaleDateString(J.locale)}` : '';
    }


    function dueItems(a: Animal) {
      const items: { label: string; date: string; kind: string }[] = [];
      for (const r of a.vaccinations) if (r.validUntil) items.push({ label: r.vaccine || J.upcoming.vacc, date: r.validUntil, kind: J.upcoming.vacc });
      for (const r of a.treatments) if (r.nextDue) items.push({ label: r.product || J.upcoming.treat, date: r.nextDue, kind: J.upcoming.treat });
      // Dates suggested by the vaccine planner: shown as planned until the vet records the vaccination; past ones drop off.
      const todayIso = new Date().toISOString().slice(0, 10);
      for (const r of (a.plans ?? []) as Row[]) if (r.date && r.date >= todayIso) items.push({ label: r.label, date: r.date, kind: J.upcoming.plan });
      return items.filter((x) => !isNaN(Date.parse(x.date))).sort((x, y) => x.date.localeCompare(y.date));
    }
    function renderUpcoming(a: Animal) {
      const ul = $('#pp-upcoming-list') as HTMLElement; ul.innerHTML = '';
      const items = dueItems(a);
      ($('#pp-ics') as HTMLElement).hidden = items.length === 0;
      if (!items.length) { const li = document.createElement('li'); li.className = 'pp-hint'; li.textContent = J.upcoming.none; ul.appendChild(li); return; }
      const today = new Date(); today.setHours(0, 0, 0, 0);
      for (const it of items) {
        const d = new Date(it.date); const days = Math.round((d.getTime() - today.getTime()) / 86400000);
        const when = days < 0 ? J.upcoming.overdue : days === 0 ? J.upcoming.dueToday : J.upcoming.dueIn.replace('{n}', String(days));
        const li = document.createElement('li'); li.className = days < 0 ? 'overdue' : days <= 30 ? 'soon' : '';
        li.innerHTML = `<span class="pp-due-date">${d.toLocaleDateString(J.locale ?? undefined)}</span> <strong>${it.label.replace(/</g, '&lt;')}</strong> <span class="pp-hint">${it.kind} · ${when}</span>`;
        ul.appendChild(li);
      }
    }
    $('#pp-ics')?.addEventListener('click', () => {
      const a = current(); if (!a) return;
      const fmt = (iso: string) => iso.slice(0, 10).replace(/-/g, '');
      const esc = (x: string) => x.replace(/[\\;,]/g, (m) => '\\' + m).replace(/\n/g, '\\n');
      const stamp = new Date().toISOString().replace(/[-:]/g, '').slice(0, 15) + 'Z';
      const events = dueItems(a).map((it, i) => ['BEGIN:VEVENT', `UID:${a.id}-${i}-${fmt(it.date)}@aiveterinary.org`, `DTSTAMP:${stamp}`, `DTSTART;VALUE=DATE:${fmt(it.date)}`, `SUMMARY:${esc((a.name || J.unnamed) + ': ' + it.label)}`, `DESCRIPTION:${esc(it.kind)}`, 'BEGIN:VALARM', 'TRIGGER:-P7D', 'ACTION:DISPLAY', `DESCRIPTION:${esc(it.label)}`, 'END:VALARM', 'END:VEVENT'].join('\r\n'));
      const ics = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//aiveterinary.org//health booklet//EN', ...events, 'END:VCALENDAR'].join('\r\n') + '\r\n';
      const blob = new Blob([ics], { type: 'text/calendar' }); const url = URL.createObjectURL(blob);
      const link = document.createElement('a'); link.href = url; link.download = `${(a.name || 'animal').replace(/[^\w-]+/g, '_')}-reminders.ics`; link.click(); setTimeout(() => URL.revokeObjectURL(url), 1000);
    });
    function renderChart(a: Animal) {
      const svg = $('#pp-weight-chart') as unknown as SVGSVGElement; if (!svg) return;
      const pts = (a.weights ?? []).filter((r: Row) => r.date && !isNaN(parseFloat(r.kg))).map((r: Row) => ({ t: Date.parse(r.date), kg: parseFloat(r.kg) })).filter((p: any) => !isNaN(p.t)).sort((x: any, y: any) => x.t - y.t);
      svg.toggleAttribute('hidden', pts.length < 2); if (pts.length < 2) return;
      const W = 600, H = 180, L = 44, R = 12, T = 14, B = 28;
      const t0 = pts[0].t, t1 = pts[pts.length - 1].t || t0 + 1;
      let min = Math.min(...pts.map((p: any) => p.kg)), max = Math.max(...pts.map((p: any) => p.kg));
      const pad = Math.max((max - min) * 0.15, 0.2); min -= pad; max += pad;
      const x = (t: number) => L + ((t - t0) / Math.max(t1 - t0, 1)) * (W - L - R);
      const y = (kg: number) => T + (1 - (kg - min) / (max - min)) * (H - T - B);
      const ticks = [min, (min + max) / 2, max].map((v) => `<text x="${L - 6}" y="${y(v) + 4}" text-anchor="end" font-size="11" fill="var(--ink-3)">${v.toFixed(1)}</text><line x1="${L}" x2="${W - R}" y1="${y(v)}" y2="${y(v)}" stroke="var(--line)" stroke-dasharray="3 4"/>`).join('');
      const fmt = (t: number) => new Date(t).toLocaleDateString(J.locale, { month: 'short', year: '2-digit' });
      const labels = `<text x="${L}" y="${H - 8}" font-size="11" fill="var(--ink-3)">${fmt(t0)}</text><text x="${W - R}" y="${H - 8}" text-anchor="end" font-size="11" fill="var(--ink-3)">${fmt(t1)}</text>`;
      const path = pts.map((p: any, i: number) => `${i ? 'L' : 'M'}${x(p.t).toFixed(1)} ${y(p.kg).toFixed(1)}`).join(' ');
      const dots = pts.map((p: any) => `<circle cx="${x(p.t).toFixed(1)}" cy="${y(p.kg).toFixed(1)}" r="4" fill="var(--surface)" stroke="var(--accent)" stroke-width="2"><title>${fmt(p.t)}: ${p.kg} kg</title></circle>`).join('');
      svg.innerHTML = `${ticks}${labels}<path d="${path}" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/>${dots}`;
    }
    const L2 = JSON.parse(document.getElementById('pp-l2')!.textContent!);
    const PRINT_LANG_KEY = 'aiveterinary.passport.printlang';
    const plSel = $('#pp-print-lang') as HTMLSelectElement | null;
    function applyPrintLang() {
      const l = plSel?.value ?? ''; const tbl = l ? L2[l] : null;
      document.querySelectorAll('.pp-l2').forEach((e) => e.remove());
      if (!tbl) return;
      for (const input of $$<HTMLElement>('#pp-form [data-f]')) {
        const key = input.dataset.f!; const label = input.closest('label'); const l2 = tbl[key];
        if (label && l2 && l2 !== label.firstChild?.textContent) { const sp = document.createElement('span'); sp.className = 'pp-l2'; sp.textContent = ` / ${l2}`; label.insertBefore(sp, input); }
      }
      for (const sec of $$<HTMLElement>('.pp-list')) {
        const name = sec.dataset.list!; const cols = LISTS[name]?.cols ?? [];
        const ths = sec.querySelectorAll('th');
        cols.forEach((c: any, i: number) => { const en = Object.entries(J.cols).find(([, v]) => v === c.label)?.[0]; const l2 = en && tbl.cols?.[en]; if (ths[i] && l2 && l2 !== c.label) { const sp = document.createElement('span'); sp.className = 'pp-l2'; sp.textContent = ` / ${l2}`; ths[i].appendChild(sp); } });
        const h2 = sec.querySelector('h2'); const l2h = tbl[name]; if (h2 && l2h && l2h !== h2.firstChild?.textContent) { const sp = document.createElement('span'); sp.className = 'pp-l2'; sp.textContent = ` / ${l2h}`; h2.appendChild(sp); }
      }
    }
    plSel?.addEventListener('change', () => { try { localStorage.setItem(PRINT_LANG_KEY, plSel.value); } catch {} applyPrintLang(); });
    try { if (plSel) plSel.value = localStorage.getItem(PRINT_LANG_KEY) ?? ''; } catch {}
    function render() { renderSelect(); renderForm(); applyPrintLang(); }

