    // ---------- Optional account sync (Supabase). Dormant unless PUBLIC_SUPABASE_URL is set. ----------
    const SB_URL = import.meta.env.PUBLIC_SUPABASE_URL as string | undefined;
    const SB_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string | undefined;
    const acct = {
      client: null as any,
      user: null as null | { id: string; email?: string },
      dirty: new Set<string>(),
      pushTimer: undefined as number | undefined,
      st(t: string) { const el = $('#pp-acct-status'); if (el) el.textContent = t; },
      async init() {
        if (!SB_URL || !SB_KEY) return;
        const { createClient } = await import('@supabase/supabase-js');
        this.client = createClient(SB_URL, SB_KEY);
        ($('#pp-account') as HTMLElement).hidden = false;
        $('#pp-login')!.addEventListener('submit', async (e) => {
