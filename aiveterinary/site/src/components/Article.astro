---
import { render, getCollection } from 'astro:content';
import { ANIMALS, type Lang } from '../lib/animals-i18n';
import AnimalIcon from './AnimalIcon.astro';
interface Props { lang: Lang; entry: any }
const { lang, entry } = Astro.props;
const t = ANIMALS[lang];
const { Content, headings } = await render(entry);
const toc = headings.filter((h: any) => h.depth === 2);
const L = ({ en: { toc: 'In this article' }, it: { toc: 'In questo articolo' }, de: { toc: 'In diesem Artikel' } } as any)[lang];
const d = entry.data;
// Feedback goes out as an email the reader sends themselves: nothing is stored or tracked on this site.
const F = ({
  en: { q: 'Is anything wrong or unclear on this page?', opts: ['A fact looks wrong', 'It is unclear', 'It seems out of date', 'Something is missing', 'Other'], note: 'What should we check? (optional, please no personal or health details of people)', how: 'This opens an email to hello@aiveterinary.org from your own mail app. Nothing is saved on this site. Corrections are checked against the sources and by the reviewing vet.', send: 'Write the email', subject: 'Page feedback' },
  it: { q: 'In questa pagina c\u2019è qualcosa di sbagliato o poco chiaro?', opts: ['Un dato sembra errato', 'Non è chiaro', 'Sembra superato', 'Manca qualcosa', 'Altro'], note: 'Cosa dovremmo controllare? (facoltativo, per favore senza dati personali o sanitari di persone)', how: 'Si apre un\u2019email a hello@aiveterinary.org dalla tua app di posta. Su questo sito non viene salvato nulla. Le correzioni vengono verificate sulle fonti e dal veterinario revisore.', send: 'Scrivi l\u2019email', subject: 'Segnalazione pagina' },
  de: { q: 'Ist auf dieser Seite etwas falsch oder unklar?', opts: ['Eine Angabe scheint falsch', 'Es ist unklar', 'Es wirkt veraltet', 'Es fehlt etwas', 'Anderes'], note: 'Was sollen wir prüfen? (freiwillig, bitte keine persönlichen oder Gesundheitsdaten von Menschen)', how: 'Damit öffnet sich eine E-Mail an hello@aiveterinary.org in Ihrem eigenen Mailprogramm. Auf dieser Seite wird nichts gespeichert. Korrekturen werden anhand der Quellen und von der prüfenden Tierärztin oder dem prüfenden Tierarzt kontrolliert.', send: 'E-Mail schreiben', subject: 'Rückmeldung zur Seite' },
} as any)[lang];
// Tool links shown beside the article, kept out of the body so signed reviews are not invalidated.
const slug = String(entry.id).split('/').pop();
const CHOC = new Set(['dog-toxic-foods', 'cane-ha-mangiato-cioccolato', 'alimenti-tossici-cane', 'hund-schokolade-gefressen', 'giftige-lebensmittel-hund']);
// One next step matched to the article's urgency, at the end of every article.
const NEXT = ({
  en: { emergency: ['Call your vet or an emergency clinic now. Unsure? Check the signs', '/emergency'], today: ['Seeing the vet today? Prepare a one-page brief', '/visit-brief'], 'this-week': ['Keep notes until the visit in the symptom diary', '/passport'], routine: ['Keep dates and notes in the health booklet', '/passport'], h: 'Next step' },
  it: { emergency: ['Chiama ora il veterinario o un pronto soccorso veterinario. Hai dubbi? Controlla i segnali', '/it/emergency'], today: ['Vai dal veterinario oggi? Prepara una scheda di una pagina', '/it/visit-brief'], 'this-week': ['Fino alla visita, annota tutto nel diario dei sintomi', '/it/passport'], routine: ['Tieni date e note nel libretto sanitario', '/it/passport'], h: 'Il prossimo passo' },
  de: { emergency: ['Rufen Sie jetzt Ihre Praxis oder eine Notdienstklinik an. Unsicher? Zeichen prüfen', '/de/emergency'], today: ['Heute zur Praxis? Einseitige Übersicht vorbereiten', '/de/visit-brief'], 'this-week': ['Bis zum Termin im Symptomtagebuch notieren', '/de/passport'], routine: ['Termine und Notizen im Gesundheitspass festhalten', '/de/passport'], h: 'Nächster Schritt' },
} as any)[lang];
const next = d.urgency ? NEXT[d.urgency] : null;
// Related reading: same animal and topic first, then same topic, then same animal; newest first on ties.
const others = (await getCollection('animals')).filter((e) => e.data.lang === lang && e.id !== entry.id);
const score = (e: any) => (e.data.species === d.species ? 2 : e.data.species === 'general' || d.species === 'general' ? 1 : 0) + (e.data.category === d.category ? 2 : 0);
const related = others.map((e) => ({ e, s: score(e) })).filter((x) => x.s >= 2).sort((x, y) => y.s - x.s || y.e.data.updated.valueOf() - x.e.data.updated.valueOf()).slice(0, 3).map((x) => x.e);
// Provenance in plain words: how the article was made, who checked it, and how to correct it.
const nRefs = d.references?.length ?? 0;
const PV = ({
  en: { h: 'About this article', made: `Drafted with AI assistance from the ${nRefs} sources listed below.`, draft: 'Not yet reviewed by a veterinarian.', rev: (who: string, when: string) => `Checked and approved by ${who}${when ? ` on ${when}` : ''}; no AI changes after sign-off.`, upd: 'Last updated', policy: 'How we write and review', href: '/editorial' },
  it: { h: 'Su questo articolo', made: `Redatto con l'assistenza dell'IA a partire dalle ${nRefs} fonti elencate qui sotto.`, draft: 'Non ancora rivisto da un veterinario.', rev: (who: string, when: string) => `Controllato e approvato da ${who}${when ? ` il ${when}` : ''}; nessuna modifica dell'IA dopo la firma.`, upd: 'Ultimo aggiornamento', policy: 'Come scriviamo e rivediamo', href: '/it/editorial' },
  de: { h: 'Über diesen Artikel', made: `Mit KI-Unterstützung aus den ${nRefs} unten genannten Quellen entworfen.`, draft: 'Noch nicht tierärztlich geprüft.', rev: (who: string, when: string) => `Geprüft und freigegeben von ${who}${when ? ` am ${when}` : ''}; keine KI-Änderungen nach der Freigabe.`, upd: 'Zuletzt aktualisiert', policy: 'So schreiben und prüfen wir', href: '/de/editorial' },
} as any)[lang];
const RL = ({ en: 'Related articles', it: 'Articoli correlati', de: 'Verwandte Artikel' } as any)[lang];
const VACC = new Set(['puppy-kitten-first-year', 'vaccinations-dogs-cats', 'primo-anno-cucciolo-gattino', 'vaccini-cane-obbligatori-italia', 'erstes-jahr-welpe-kitten', 'hund-impfung-kosten', 'leptospirose-hund']);
const vaccLink = ({ en: ['Plan the first-year vaccination dates', '/vaccine-planner'], it: ['Pianifica le date dei vaccini del primo anno', '/it/vaccine-planner'], de: ['Impftermine im ersten Jahr planen', '/de/vaccine-planner'] } as any)[lang];
const toolLink = CHOC.has(slug!) ? ({ en: ['Ate chocolate? Work out the dose for your dog', '/chocolate'], it: ['Ha mangiato cioccolato? Calcola la dose per il tuo cane', '/it/chocolate'], de: ['Schokolade gefressen? Dosis für Ihren Hund berechnen', '/de/chocolate'] } as any)[lang] : VACC.has(slug!) ? vaccLink : null;
const minutes = Math.max(1, Math.round(((entry.body ?? '').split(/\s+/).length) / 200));
const minLabel = ({ en: 'min read', it: 'min di lettura', de: 'Min. Lesezeit' } as any)[lang];
const fmt = (x: Date) => x.toLocaleDateString(t.locale, { day: 'numeric', month: 'long', year: 'numeric' });
const cls: Record<string, string> = { emergency: 'danger', today: 'warn', 'this-week': '', routine: 'ok' };
// Structured data mirrors only what the page shows: same dates, a reviewer only when one is named on the page.
const iso = (x: Date) => x.toISOString().slice(0, 10);
const url = new URL(Astro.url.pathname.replace(/\.html$/, ''), Astro.site).href;
const catLabel = (t.categories as any)[d.category]?.[0] ?? d.category;
const ld = [
  {
    '@context': 'https://schema.org', '@type': 'MedicalWebPage', '@id': url, url,
    headline: d.title, name: d.title, description: d.description, inLanguage: lang,
    dateModified: iso(d.updated),
    ...(d.reviewedBy && d.reviewedOn ? { lastReviewed: iso(d.reviewedOn), reviewedBy: { '@type': 'Person', name: d.reviewedBy, ...(d.reviewerRegistration ? { description: d.reviewerRegistration } : {}) } } : {}),
    ...(d.author ? { author: { '@type': 'Person', name: d.author } } : { author: { '@type': 'Organization', name: 'AI Veterinary', url: 'https://aiveterinary.org' } }),
    publisher: { '@type': 'Organization', name: 'AI Veterinary', url: 'https://aiveterinary.org' },
    ...(d.references?.length ? { citation: d.references.filter((r: any) => r.url).map((r: any) => ({ '@type': 'CreativeWork', name: r.title, url: r.url })) } : {}),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.title, item: new URL(t.base, Astro.site).href },
      { '@type': 'ListItem', position: 2, name: catLabel, item: new URL(`${t.base}/${d.category}`, Astro.site).href },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
---
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
<div data-pagefind-body data-pagefind-meta={`species:${d.species}`}>
<header class={`art-head tint-${d.species}`}>
  <div class="wrap narrow art-head-in">
  <div>
  <p class="eyebrow article-eyebrow"><a href={t.base}>{t.title}</a> · <a href={`${t.base}/${d.category}`}>{(t.categories as any)[d.category]?.[0] ?? d.category}</a> · <a href={`${t.base}/${d.species}`}>{(t.species as any)[d.species] ?? d.species}</a></p>
  <h1>{d.title}</h1>
  <p class="lead">{d.description}</p>
  <div class="article-meta">
    {d.draft
      ? <span class="badge draft">{t.draftLong}</span>
      : <span class="badge reviewed">{t.reviewedBy} {d.reviewedBy}{d.reviewerRegistration && ` (${d.reviewerRegistration})`}{d.reviewedOn && `, ${fmt(d.reviewedOn)}`}</span>}
    {d.author && <span>{t.author} {d.author}</span>}
    {!d.draft && <span>{({ en: 'Drafted with AI assistance from the cited sources, checked and approved by the reviewer', it: "Redatto con l'assistenza dell'IA dalle fonti citate, controllato e approvato dal revisore", de: 'Mit KI-Unterstützung aus den genannten Quellen entworfen, von der prüfenden Person kontrolliert und freigegeben' } as any)[lang]}</span>}
    <span>{t.updated} {fmt(d.updated)}</span>
    <span>{minutes} {minLabel}</span>
    {d.nextReview && <span>{t.nextReview} {fmt(d.nextReview)}</span>}
  </div>
  </div>
  <div class="art-head-art" aria-hidden="true">{d.species === 'general' ? <><AnimalIcon kind="dog" size={84} /><AnimalIcon kind="cat" size={78} /></> : <AnimalIcon kind={d.species} size={110} />}</div>
  </div>
</header>
<article class="wrap narrow art-body">
  {d.urgency && <div class={`notice ${cls[d.urgency]}`}><p><strong>{t.whenToSee}</strong> {(t.urgency as any)[d.urgency]}</p></div>}
  {toc.length >= 3 && (
    <nav class="toc" aria-label={L.toc}><div class="toc-h">{L.toc}</div><ol>{toc.map((h: any) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav>
  )}
  {toolLink && <p class="tool-link" data-pagefind-ignore><a class="btn" href={toolLink[1]}>{toolLink[0]}</a></p>}
  <div class="prose"><Content /></div>
  {next && <div class={`next-step ns-${d.urgency}`} data-pagefind-ignore><span class="ns-h">{NEXT.h}</span> <a href={next[1]}>{next[0]} →</a></div>}
  <aside class="provenance" aria-labelledby="pv-h" data-pagefind-ignore>
    <h2 id="pv-h">{PV.h}</h2>
    <p>{nRefs > 0 && PV.made} {d.draft ? <strong>{PV.draft}</strong> : PV.rev(`${d.reviewedBy}${d.reviewerRegistration ? ` (${d.reviewerRegistration})` : ''}`, d.reviewedOn ? fmt(d.reviewedOn) : '')} {PV.upd}: {fmt(d.updated)}. <a href={PV.href}>{PV.policy} →</a></p>
  </aside>
  {d.references?.length && (
    <section class="article-refs"><h2>{t.references}</h2><ol>{d.references.map((r: any) => <li>{r.url ? <a href={r.url} rel="noopener">{r.title}</a> : r.title}</li>)}</ol></section>
  )}
  {related.length > 0 && (
    <nav class="related" aria-label={RL} data-pagefind-ignore>
      <h2>{RL}</h2>
      <ul>{related.map((r) => <li><a href={`${t.base}/${String(r.id).split('/').pop()}`} class={`related-a tint-${r.data.species}`}><span class="related-ic" aria-hidden="true"><AnimalIcon kind={r.data.species === 'general' ? 'dog' : r.data.species} size={40} /></span><span><span class="related-t">{r.data.title}</span><span class="related-d">{(t.categories as any)[r.data.category]?.[0] ?? r.data.category}</span></span></a></li>)}</ul>
    </nav>
  )}
  <p class="article-actions" data-pagefind-ignore><a class="btn secondary" href={`mailto:?subject=${encodeURIComponent(d.title)}&body=${encodeURIComponent(Astro.url.href)}`}>{t.share}</a></p>
  <form class="fb" data-pagefind-ignore data-title={d.title} data-url={url} data-subject={F.subject}>
    <fieldset><legend>{F.q}</legend>
      <div class="fb-opts">{F.opts.map((o: string, i: number) => <label><input type="radio" name="fb" value={o} required={i === 0} /> {o}</label>)}</div>
      <label class="fb-note">{F.note}<textarea name="note" rows="3"></textarea></label>
      <p class="pp-hint">{F.how}</p>
      <button class="btn secondary" type="submit">{F.send}</button>
    </fieldset>
  </form>
  <div class="notice" style="margin-top:24px" data-pagefind-ignore><p>{t.footer}</p></div>
</article>
</div>
<script>
  document.querySelectorAll<HTMLFormElement>('form.fb').forEach((f) => f.addEventListener('submit', (e) => {
    e.preventDefault();
    const kind = (f.querySelector('input[name=fb]:checked') as HTMLInputElement)?.value ?? '';
    const note = (f.elements.namedItem('note') as HTMLTextAreaElement).value.trim();
    const body = `${f.dataset.url}\n\n${kind}${note ? `\n\n${note}` : ''}\n`;
    location.href = `mailto:hello@aiveterinary.org?subject=${encodeURIComponent(`${f.dataset.subject}: ${f.dataset.title}`)}&body=${encodeURIComponent(body)}`;
  }));
</script>
<style is:global>
  .provenance { margin: 28px 0 0; padding: 14px 18px; border-left: 4px solid var(--accent); background: var(--accent-soft); border-radius: 0 14px 14px 0; }
  .provenance h2 { font-size: .8rem; text-transform: uppercase; letter-spacing: .08em; margin: 0 0 4px; color: var(--ink-2); font-family: var(--font); }
  .provenance p { margin: 0; }
  .related { margin: 32px 0 8px; }
  .related h2 { font-size: 1.2rem; margin: 0 0 12px; }
  .related ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .related-a { display: flex; gap: 14px; align-items: center; padding: 12px 16px; border-radius: 16px; background: var(--surface); box-shadow: 0 1px 0 var(--line); text-decoration: none; color: var(--ink); }
  .related-a:hover { box-shadow: 0 1px 0 var(--line), 0 8px 20px rgba(18, 48, 74, .08); }
  .related-ic { flex: none; width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; background: var(--tint, var(--accent-soft)); }
  .related-t { display: block; font-weight: 600; line-height: 1.3; }
  .related-d { display: block; font-size: .85rem; color: var(--ink-2); margin-top: 2px; }
  .next-step { margin: 28px 0 8px; padding: 16px 20px; border-radius: 18px; background: var(--accent-soft); font-weight: 600; }
  .next-step.ns-emergency { background: var(--danger-soft); }
  .next-step.ns-today { background: var(--warn-soft); }
  .next-step .ns-h { display: block; font-size: .78rem; text-transform: uppercase; letter-spacing: .08em; color: var(--ink-2); margin-bottom: 4px; }
  .fb { margin-top: 28px; }
  .fb fieldset { border: 0; margin: 0; padding: 18px 20px; border-radius: 20px; background: var(--surface); box-shadow: 0 1px 0 var(--line); display: grid; gap: 12px; }
  .fb legend { font-family: var(--font-display); font-weight: 600; font-size: 1.15rem; padding: 0 6px; }
  .fb-opts { display: flex; flex-wrap: wrap; gap: 8px 16px; }
  .fb-opts label { display: inline-flex; gap: 6px; align-items: center; }
  .fb-note { display: grid; gap: 6px; font-weight: 600; }
  .fb textarea { font: inherit; padding: 10px 12px; border: 1px solid var(--line); border-radius: 12px; background: var(--bg); color: var(--ink); max-width: 100%; }
  .fb .btn { justify-self: start; }
</style>
