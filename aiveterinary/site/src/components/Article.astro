---
import { render } from 'astro:content';
import { ANIMALS, type Lang } from '../lib/animals-i18n';
import AnimalIcon from './AnimalIcon.astro';
interface Props { lang: Lang; entry: any }
const { lang, entry } = Astro.props;
const t = ANIMALS[lang];
const { Content, headings } = await render(entry);
const toc = headings.filter((h: any) => h.depth === 2);
const L = ({ en: { toc: 'In this article', report: 'Found an error? Tell us' }, it: { toc: 'In questo articolo', report: 'Hai trovato un errore? Scrivici' }, de: { toc: 'In diesem Artikel', report: 'Fehler gefunden? Sagen Sie es uns' } } as any)[lang];
const d = entry.data;
const minutes = Math.max(1, Math.round(((entry.body ?? '').split(/\s+/).length) / 200));
const minLabel = ({ en: 'min read', it: 'min di lettura', de: 'Min. Lesezeit' } as any)[lang];
const fmt = (x: Date) => x.toLocaleDateString(t.locale, { day: 'numeric', month: 'long', year: 'numeric' });
const cls: Record<string, string> = { emergency: 'danger', today: 'warn', 'this-week': '', routine: 'ok' };
// Structured data mirrors only what the page shows: same dates, a reviewer only when one is named on the page.
const iso = (x: Date) => x.toISOString().slice(0, 10);
const url = new URL(Astro.url.pathname.replace(/\.html$/, ''), Astro.site).href;
const catLabel = (t.categories as any)[d.category]?.[0] ?? d.category;
const ld = [
  {
    '@context': 'https://schema.org', '@type': 'MedicalWebPage', '@id': url, url,
    headline: d.title, name: d.title, description: d.description, inLanguage: lang,
    dateModified: iso(d.updated),
    ...(d.reviewedBy && d.reviewedOn ? { lastReviewed: iso(d.reviewedOn), reviewedBy: { '@type': 'Person', name: d.reviewedBy, ...(d.reviewerRegistration ? { description: d.reviewerRegistration } : {}) } } : {}),
    ...(d.author ? { author: { '@type': 'Person', name: d.author } } : { author: { '@type': 'Organization', name: 'AI Veterinary', url: 'https://aiveterinary.org' } }),
    publisher: { '@type': 'Organization', name: 'AI Veterinary', url: 'https://aiveterinary.org' },
    ...(d.references?.length ? { citation: d.references.filter((r: any) => r.url).map((r: any) => ({ '@type': 'CreativeWork', name: r.title, url: r.url })) } : {}),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.title, item: new URL(t.base, Astro.site).href },
      { '@type': 'ListItem', position: 2, name: catLabel, item: new URL(`${t.base}/${d.category}`, Astro.site).href },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
---
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
<div data-pagefind-body data-pagefind-meta={`species:${d.species}`}>
<header class={`art-head tint-${d.species}`}>
  <div class="wrap narrow art-head-in">
  <div>
  <p class="eyebrow article-eyebrow"><a href={t.base}>{t.title}</a> · <a href={`${t.base}/${d.category}`}>{(t.categories as any)[d.category]?.[0] ?? d.category}</a> · <a href={`${t.base}/${d.species}`}>{(t.species as any)[d.species] ?? d.species}</a></p>
  <h1>{d.title}</h1>
  <p class="lead">{d.description}</p>
  <div class="article-meta">
    {d.draft
      ? <span class="badge draft">{t.draftLong}</span>
      : <span class="badge reviewed">{t.reviewedBy} {d.reviewedBy}{d.reviewerRegistration && ` (${d.reviewerRegistration})`}{d.reviewedOn && `, ${fmt(d.reviewedOn)}`}</span>}
    {d.author && <span>{t.author} {d.author}</span>}
    {!d.draft && <span>{({ en: 'Drafted with AI assistance from the cited sources, checked and approved by the reviewer', it: "Redatto con l'assistenza dell'IA dalle fonti citate, controllato e approvato dal revisore", de: 'Mit KI-Unterstützung aus den genannten Quellen entworfen, von der prüfenden Person kontrolliert und freigegeben' } as any)[lang]}</span>}
    <span>{t.updated} {fmt(d.updated)}</span>
    <span>{minutes} {minLabel}</span>
    {d.nextReview && <span>{t.nextReview} {fmt(d.nextReview)}</span>}
  </div>
  </div>
  <div class="art-head-art" aria-hidden="true">{d.species === 'general' ? <><AnimalIcon kind="dog" size={84} /><AnimalIcon kind="cat" size={78} /></> : <AnimalIcon kind={d.species} size={110} />}</div>
  </div>
</header>
<article class="wrap narrow art-body">
  {d.urgency && <div class={`notice ${cls[d.urgency]}`}><p><strong>{t.whenToSee}</strong> {(t.urgency as any)[d.urgency]}</p></div>}
  {toc.length >= 3 && (
    <nav class="toc" aria-label={L.toc}><div class="toc-h">{L.toc}</div><ol>{toc.map((h: any) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav>
  )}
  <div class="prose"><Content /></div>
  {d.references?.length && (
    <section class="article-refs"><h2>{t.references}</h2><ol>{d.references.map((r: any) => <li>{r.url ? <a href={r.url} rel="noopener">{r.title}</a> : r.title}</li>)}</ol></section>
  )}
  <p class="article-actions" data-pagefind-ignore><a class="btn secondary" href={`mailto:?subject=${encodeURIComponent(d.title)}&body=${encodeURIComponent(Astro.url.href)}`}>{t.share}</a> <a class="more" href={`mailto:hello@aiveterinary.org?subject=${encodeURIComponent('Correction: ' + d.title)}&body=${encodeURIComponent(Astro.url.href)}`}>{L.report}</a></p>
  <div class="notice" style="margin-top:24px" data-pagefind-ignore><p>{t.footer}</p></div>
</article>
</div>
