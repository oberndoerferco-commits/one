---
import { pageSeo, ORG, LANGS, WEBSITE_ID } from '../lib/seo';
import AnimalIcon from '../components/AnimalIcon.astro';
import Logo from '../components/Logo.astro';
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/plus-jakarta-sans/index.css';
import '../styles.css';
interface Props {
  title: string;
  description: string;
  lang?: string;
  /** Keep the page out of search results (404, empty listings): no canonical, no hreflang. */
  noindex?: boolean;
  /** Translations of this page as [lang, path], for routes that know them exactly (otherwise derived in src/lib/seo.ts). */
  alternates?: [string, string][];
}
const { title, description, lang = 'en' } = Astro.props;
// Cookie-free analytics (Cloudflare Web Analytics) is loaded only when a token is configured at build time.
const cfToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN as string | undefined;
const path = Astro.url.pathname.replace(/\.html$/, '');

type Lang = 'en' | 'it' | 'de';
const L: Lang = lang === 'it' || lang === 'de' ? lang : 'en';
const canonical = new URL(path === '/' ? '/' : path, Astro.site).href;
// Search snippets cut off around 160 characters: shorten the meta description at a word boundary
// (the page itself keeps the full text), and drop the brand suffix when the title is already long.
const metaDescription = description.length <= 158 ? description : description.slice(0, 157).replace(/[\s,;:.–-]+\S*$/, '') + '…';
const homeTitle = ({ en: 'AI Veterinary: pet health in plain language', it: 'AI Veterinary: salute degli animali in parole semplici', de: 'AI Veterinary: Tiergesundheit verständlich erklärt' } as const)[L];
const fullTitle = title === 'AI Veterinary' ? homeTitle : title.length > 52 ? title : `${title} · AI Veterinary`;
const ogLocale = ({ en: 'en_GB', it: 'it_IT', de: 'de_DE' } as const)[L];

const strings = {
  en: {
    home: '/',
    menu: {
      urgent: { href: '/emergency', label: 'Is it urgent?', short: 'Emergency', desc: 'Signs that mean a vet now, and what to do first' },
      symptoms: { href: '/animals/symptoms', label: 'Symptoms', desc: 'What a sign can mean and when to call a vet' },
      guide: { href: '/animals', label: 'Animals A–Z', desc: 'Every animal from A to Z: facts, signs and health topics' },
      checks: { label: 'Quick checks', desc: 'Short tools for common questions', items: [
        { href: '/emergency', label: 'Is it an emergency?' },
        { href: '/chocolate', label: 'Dog ate chocolate?' },
        { href: '/can-eat', label: 'Can my pet eat that?' },
        { href: '/vaccine-planner', label: 'Puppy and kitten vaccine planner' },
        { href: '/travel', label: 'Travelling with a pet in Europe' },
        { href: '/registry', label: 'Pet registries by country' },
      ] },
      booklet: { href: '/passport', label: 'My booklet', desc: 'Vaccines, treatments and vet contacts in one place' },
      vets: { href: '/vets', label: 'For vets' },
      about: { href: '/about', label: 'About' },
      privacy: { href: '/privacy', label: 'Privacy' },
      open: 'Menu', openAria: 'Open menu', close: 'Close menu', lang: 'Language', more: 'More',
    },
    tagline: 'Less paperwork. More animal care.',
    disclaimer: 'Information on this site is general and reviewed by veterinarians where marked. It does not replace an examination by a vet. In an emergency, contact a veterinary clinic immediately.',
    footer1: [
      { href: '/animals', label: 'Animal information' },
      { href: '/passport', label: 'Digital health booklet' },
      { href: '/vets', label: 'For veterinary teams' },
      { href: '/vets/research', label: 'Research' },
      { href: '/registry', label: 'Pet registries by country' },
      { href: '/emergency', label: 'Is it an emergency?' },
      { href: '/chocolate', label: 'Dog ate chocolate? Check the amount' },
      { href: '/can-eat', label: 'Can my pet eat that?' },
      { href: '/vaccine-planner', label: 'Puppy and kitten vaccine planner' },
      { href: '/travel', label: 'Travelling with a pet in Europe' },
      { href: '/end-of-life', label: 'When the time comes' },
    ],
    footer2: [
      { href: '/about', label: 'About' },
      { href: '/editorial', label: 'Editorial policy' },
      { href: '/newsletter', label: 'Newsletter' },
      { href: '/privacy', label: 'Privacy' },
      { href: '/terms', label: 'Terms' },
      { href: '/impressum', label: 'Legal notice' },
    ],
    brandAria: 'AI Veterinary home',
    navAria: 'Main',
    langAria: 'Language',
  },
  it: {
    home: '/it',
    menu: {
      urgent: { href: '/it/emergency', label: 'È urgente?', short: 'Urgente', desc: 'I segni che richiedono subito il veterinario e cosa fare prima' },
      symptoms: { href: '/it/animals/symptoms', label: 'Sintomi', desc: 'Cosa può significare un segno e quando chiamare il veterinario' },
      guide: { href: '/it/animals', label: 'Animali dalla A alla Z', desc: 'Tutti gli animali dalla A alla Z: schede, segnali e salute' },
      checks: { label: 'Verifiche rapide', desc: 'Strumenti brevi per le domande più comuni', items: [
        { href: '/it/emergency', label: "È un'emergenza?" },
        { href: '/it/chocolate', label: 'Il cane ha mangiato cioccolato?' },
        { href: '/it/can-eat', label: 'Il mio animale può mangiarlo?' },
        { href: '/it/vaccine-planner', label: 'Calendario vaccini cuccioli e gattini' },
        { href: '/it/travel', label: 'Viaggiare con un animale in Europa' },
        { href: '/it/registry', label: 'Anagrafi e registri per Paese' },
      ] },
      booklet: { href: '/it/passport', label: 'Il mio libretto', desc: 'Vaccini, trattamenti e contatti del veterinario in un unico posto' },
      vets: { href: '/it/vets', label: 'Per i veterinari' },
      about: { href: '/it/about', label: 'Chi siamo' },
      privacy: { href: '/privacy', label: 'Privacy' },
      open: 'Menu', openAria: 'Apri il menu', close: 'Chiudi il menu', lang: 'Lingua', more: 'Altro',
    },
    tagline: 'Meno burocrazia. Più cura degli animali.',
    disclaimer: 'Le informazioni su questo sito sono di carattere generale e, dove indicato, sono state riviste da veterinari. Non sostituiscono la visita di un veterinario. In caso di emergenza, contatta subito una clinica veterinaria.',
    footer1: [
      { href: '/it/animals', label: 'Informazioni sugli animali' },
      { href: '/it/passport', label: 'Libretto sanitario digitale' },
      { href: '/it/vets', label: 'Per i team veterinari' },
      { href: '/it/vets/research', label: 'Ricerca' },
      { href: '/it/registry', label: 'Anagrafi e registri per Paese' },
      { href: '/it/emergency', label: "È un'emergenza?" },
      { href: '/it/chocolate', label: 'Il cane ha mangiato cioccolato?' },
      { href: '/it/can-eat', label: 'Il mio animale può mangiarlo?' },
      { href: '/it/vaccine-planner', label: 'Calendario vaccini cuccioli e gattini' },
      { href: '/it/travel', label: 'Viaggiare con un animale in Europa' },
      { href: '/it/end-of-life', label: 'Quando arriva il momento' },
    ],
    footer2: [
      { href: '/it/about', label: 'Chi siamo' },
      { href: '/it/editorial', label: 'Politica editoriale' },
      { href: '/it/newsletter', label: 'Newsletter' },
      { href: '/privacy', label: 'Privacy' },
      { href: '/terms', label: 'Termini' },
      { href: '/it/impressum', label: 'Note legali' },
    ],
    brandAria: 'AI Veterinary, pagina iniziale',
    navAria: 'Principale',
    langAria: 'Lingua',
  },
  de: {
    home: '/de',
    menu: {
      urgent: { href: '/de/emergency', label: 'Ist es dringend?', short: 'Notfall', desc: 'Anzeichen, die sofort zum Tierarzt gehören, und was zuerst zu tun ist' },
      symptoms: { href: '/de/animals/symptoms', label: 'Symptome', desc: 'Was ein Anzeichen bedeuten kann und wann Sie anrufen sollten' },
      guide: { href: '/de/animals', label: 'Tierlexikon', desc: 'Alle Tiere von A bis Z: Steckbriefe, Anzeichen und Gesundheit' },
      checks: { label: 'Schnell-Checks', desc: 'Kurze Hilfen für häufige Fragen', items: [
        { href: '/de/emergency', label: 'Ist es ein Notfall?' },
        { href: '/de/chocolate', label: 'Hund hat Schokolade gefressen?' },
        { href: '/de/can-eat', label: 'Darf mein Tier das fressen?' },
        { href: '/de/vaccine-planner', label: 'Impfplaner für Welpen und Kitten' },
        { href: '/de/travel', label: 'Mit Haustier in Europa reisen' },
        { href: '/de/registry', label: 'Heimtierregister nach Land' },
      ] },
      booklet: { href: '/de/passport', label: 'Mein Heimtierpass', desc: 'Impfungen, Behandlungen und Tierarztkontakte an einem Ort' },
      vets: { href: '/de/vets', label: 'Für Tierärzte' },
      about: { href: '/de/about', label: 'Über uns' },
      privacy: { href: '/privacy', label: 'Datenschutz' },
      open: 'Menü', openAria: 'Menü öffnen', close: 'Menü schließen', lang: 'Sprache', more: 'Mehr',
    },
    tagline: 'Weniger Papierkram. Mehr Zeit für Tiere.',
    disclaimer: 'Die Informationen auf dieser Website sind allgemeiner Art und, wo gekennzeichnet, von Tierärztinnen und Tierärzten geprüft. Sie ersetzen keine tierärztliche Untersuchung. Wenden Sie sich im Notfall sofort an eine Tierarztpraxis oder Tierklinik.',
    footer1: [
      { href: '/de/animals', label: 'Tierinformationen' },
      { href: '/de/passport', label: 'Digitaler Heimtierpass' },
      { href: '/de/vets', label: 'Für Praxisteams' },
      { href: '/de/vets/research', label: 'Recherche' },
      { href: '/de/registry', label: 'Heimtierregister nach Land' },
      { href: '/de/emergency', label: 'Ist es ein Notfall?' },
      { href: '/de/chocolate', label: 'Hund hat Schokolade gefressen?' },
      { href: '/de/can-eat', label: 'Darf mein Tier das fressen?' },
      { href: '/de/vaccine-planner', label: 'Impfplaner für Welpen und Kitten' },
      { href: '/de/travel', label: 'Mit Haustier in Europa reisen' },
      { href: '/de/end-of-life', label: 'Wenn die Zeit kommt' },
    ],
    footer2: [
      { href: '/de/about', label: 'Über uns' },
      { href: '/de/editorial', label: 'Redaktionelle Grundsätze' },
      { href: '/de/newsletter', label: 'Newsletter' },
      { href: '/privacy', label: 'Datenschutz' },
      { href: '/terms', label: 'Nutzungsbedingungen' },
      { href: '/de/impressum', label: 'Impressum' },
    ],
    brandAria: 'AI Veterinary Startseite',
    navAria: 'Hauptnavigation',
    langAria: 'Sprache',
  },
} as const;

const t = strings[L];
// Installable app (docs/29-pwa.md): the service worker is registered only in production builds.
const isProd = import.meta.env.PROD;
const pwa = ({
  en: { install: 'Install the app', update: 'A new version of AI Veterinary is available.', reload: 'Update now', later: 'Later' },
  it: { install: 'Installa l’app', update: 'È disponibile una nuova versione di AI Veterinary.', reload: 'Aggiorna ora', later: 'Più tardi' },
  de: { install: 'App installieren', update: 'Eine neue Version von AI Veterinary ist verfügbar.', reload: 'Jetzt aktualisieren', later: 'Später' },
} as const)[L];
const fh = ({ en: ['Explore', 'About'], it: ['Scopri', 'Chi siamo'], de: ['Entdecken', 'Über uns'] } as any)[L] as [string, string];
const m = t.menu;
// hreflang, noindex and page structured data (src/lib/seo.ts): derived from the collections and the route
// files, so new articles, lexicon entries and routes are covered without editing a list here.
const labels = new Map<string, string>();
for (const x of [...t.footer1, ...t.footer2, m.urgent, m.symptoms, m.guide, ...m.checks.items, m.booklet, m.vets, m.about]) if (!labels.has(x.href)) labels.set(x.href, x.label);
const seo = await pageSeo(path, L, { title, description, labels });
const noindex = !!Astro.props.noindex || seo.noindex;
const alternates = noindex ? [] : (Astro.props.alternates ?? seo.alternates);
// The organisation on the home and About pages, the WebSite (site name) on the root home page only,
// which is where Google reads it, and the page's own nodes (lexicon entry, breadcrumb).
const isHomeOrAbout = /^(\/(it|de))?(\/about)?\/?$/.test(path);
const siteGraph = [
  ...(isHomeOrAbout ? [{ ...ORG, email: 'hello@aiveterinary.org', description: 'Free pet-health information for owners in English, Italian and German, a digital health booklet, and documentation tools for veterinary teams.' }] : []),
  ...(path === '/' ? [{ '@type': 'WebSite', '@id': WEBSITE_ID, name: 'AI Veterinary', url: 'https://aiveterinary.org/', inLanguage: [...LANGS], publisher: { '@id': ORG['@id'] } }] : []),
  ...(noindex ? [] : seo.graph),
];
const siteLd = siteGraph.length ? JSON.stringify({ '@context': 'https://schema.org', '@graph': siteGraph }).replace(/</g, '\\u003c') : null;
const languages: { code: Lang; href: string; label: string }[] = [
  { code: 'en', href: '/', label: 'EN' },
  { code: 'it', href: '/it', label: 'IT' },
  { code: 'de', href: '/de', label: 'DE' },
];
const current = (href: string) => path === href || path.startsWith(href + '/');
const isUrgent = current(m.urgent.href);
const isSymptoms = current(m.symptoms.href);
const isGuide = current(m.guide.href) && !isSymptoms;
const checksActive = m.checks.items.some((c) => current(c.href));
const langNames = { en: 'English', it: 'Italiano', de: 'Deutsch' } as const;
// The current language always links to this page itself (untranslated pages have no alternate entry for it).
const langLinks = languages.map((l) => ({ ...l, name: langNames[l.code], href: l.code === L ? path : (alternates.find(([c]) => c === l.code)?.[1]) ?? l.href }));
// Stroke icons for the header and the phone menu (decorative; labels carry the meaning).
const svg = (d: string) => `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">${d}</svg>`;
const ic = {
  alert: svg('<path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><path d="M12 9v4"/><path d="M12 17h.01"/>'),
  symptoms: svg('<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>'),
  guide: svg('<circle cx="11" cy="4" r="2"/><circle cx="18" cy="8" r="2"/><circle cx="4" cy="8" r="2"/><circle cx="20" cy="16" r="2"/><path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.05Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z"/>'),
  checks: svg('<path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>'),
  booklet: svg('<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/><path d="M12 7v6M9 10h6"/>'),
  chev: svg('<path d="m6 9 6 6 6-6"/>'),
  menu: svg('<path d="M4 6h16M4 12h16M4 18h16"/>'),
  close: svg('<path d="M18 6 6 18M6 6l12 12"/>'),
  globe: svg('<circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>'),
};
const rows = [
  { ...m.urgent, icon: ic.alert, urgent: true, cur: isUrgent },
  { ...m.symptoms, icon: ic.symptoms, cur: isSymptoms },
  { ...m.guide, icon: ic.guide, cur: isGuide },
  { ...m.booklet, icon: ic.booklet, cur: current(m.booklet.href) },
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');
      // Chromium/Android install prompt: keep it for the discreet "Install the app" buttons instead of the browser's banner.
      addEventListener('beforeinstallprompt', function (e) { e.preventDefault(); window.__aivInstall = e; document.dispatchEvent(new Event('aiv:installable')); });</script>
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#fbf7f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14191b" media="(prefers-color-scheme: dark)" />
    {!noindex && <link rel="canonical" href={canonical} />}
    {alternates.map(([l, href]) => <link rel="alternate" hreflang={l} href={new URL(href, Astro.site)} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL((alternates.find(([l]) => l === 'en') ?? alternates[0])[1], Astro.site)} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={seo.kind === 'article' ? 'article' : 'website'} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="AI Veterinary" />
    <meta property="og:locale" content={ogLocale} />
    {alternates.filter(([l]) => l !== L).map(([l]) => <meta property="og:locale:alternate" content={({ en: 'en_GB', it: 'it_IT', de: 'de_DE' } as any)[l]} />)}
    {siteLd && <script type="application/ld+json" set:html={siteLd} />}
    <meta property="og:image" content={new URL(L === 'en' ? '/og.png' : `/og-${L}.png`, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {cfToken && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cfToken })}></script>}
  </head>
  <body>
    <a class="skip" href="#main">{({ en: 'Skip to content', it: 'Vai al contenuto', de: 'Zum Inhalt springen' } as any)[L]}</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={t.home} aria-label={t.brandAria}>
          <Logo size={28} />
          <span class="brand-name">AI Veterinary</span>
        </a>
        <nav class="hn" aria-label={t.navAria}>
          <ul class="hn-list">
            <li><a class="hn-urgent" href={m.urgent.href} aria-current={isUrgent ? 'page' : undefined}><span class="hn-ic" set:html={ic.alert} />{m.urgent.label}</a></li>
            <li><a class="hn-link" href={m.symptoms.href} aria-current={isSymptoms ? 'page' : undefined}>{m.symptoms.label}</a></li>
            <li><a class="hn-link" href={m.guide.href} aria-current={isGuide ? 'page' : undefined}>{m.guide.label}</a></li>
            <li class="hn-dd" data-hn-dd>
              <button type="button" class:list={['hn-link', 'hn-dd-btn', { 'is-active': checksActive }]} aria-expanded="false" aria-controls="hn-checks">{m.checks.label}<span class="hn-chev" set:html={ic.chev} /></button>
              <ul class="hn-dd-panel" id="hn-checks">
                {m.checks.items.map((c) => <li><a href={c.href} aria-current={current(c.href) ? 'page' : undefined}>{c.label}</a></li>)}
              </ul>
            </li>
            <li><a class="hn-link" href={m.booklet.href} aria-current={current(m.booklet.href) ? 'page' : undefined}>{m.booklet.label}</a></li>
          </ul>
          <div class="hn-right">
            <a class="hn-vets" href={m.vets.href} aria-current={current(m.vets.href) ? 'page' : undefined}>{m.vets.label}</a>
            <span class="lang-switch" role="group" aria-label={t.langAria}>
              {langLinks.map((l, i) => (
                <>
                  {i > 0 && <span aria-hidden="true">·</span>}
                  <a href={l.href} hreflang={l.code} lang={l.code} aria-current={L === l.code ? 'true' : undefined}>{l.label}</a>
                </>
              ))}
            </span>
          </div>
        </nav>
        <div class="hn-phone">
          <a class="hn-urgent hn-urgent-sm" href={m.urgent.href} aria-current={isUrgent ? 'page' : undefined}><span class="hn-ic" set:html={ic.alert} />{m.urgent.short}</a>
          <button type="button" class="hn-menu-btn" aria-label={m.openAria} aria-expanded="false" aria-controls="hn-sheet" aria-haspopup="dialog"><span class="hn-ic" set:html={ic.menu} /><span class="hn-menu-txt" aria-hidden="true">{m.open}</span></button>
          <a class="hn-menu-btn hn-menu-nojs" href="#hn-sheet" aria-label={m.openAria}><span class="hn-ic" set:html={ic.menu} /><span class="hn-menu-txt" aria-hidden="true">{m.open}</span></a>
        </div>
      </div>
      <dialog class="hn-sheet" id="hn-sheet" aria-label={m.open}>
        <div class="hn-sheet-top">
          <a class="brand" href={t.home} aria-label={t.brandAria}>
            <Logo size={28} />
            <span class="brand-name">AI Veterinary</span>
          </a>
          <a class="hn-close" href="#" data-hn-close aria-label={m.close}><span class="hn-ic" set:html={ic.close} /></a>
        </div>
        <nav aria-label={t.navAria}>
          <ul class="hn-rows">
            {rows.slice(0, 3).map((r) => (
              <li><a class:list={['hn-row', { 'hn-row-urgent': r.urgent }]} href={r.href} aria-current={r.cur ? 'page' : undefined}>
                <span class="hn-row-ic" set:html={r.icon} />
                <span class="hn-row-txt"><span class="hn-row-l">{r.label}</span><span class="hn-row-d">{r.desc}</span></span>
              </a></li>
            ))}
          </ul>
          <p class="hn-sub-h" id="hn-checks-h"><span class="hn-row-ic" set:html={ic.checks} /><span class="hn-row-txt"><span class="hn-row-l">{m.checks.label}</span><span class="hn-row-d">{m.checks.desc}</span></span></p>
          <ul class="hn-sub" aria-labelledby="hn-checks-h">
            {m.checks.items.slice(1).map((c) => <li><a href={c.href} aria-current={current(c.href) ? 'page' : undefined}>{c.label}</a></li>)}
          </ul>
          <ul class="hn-rows">
            {rows.slice(3).map((r) => (
              <li><a class:list={['hn-row', { 'hn-row-urgent': r.urgent }]} href={r.href} aria-current={r.cur ? 'page' : undefined}>
                <span class="hn-row-ic" set:html={r.icon} />
                <span class="hn-row-txt"><span class="hn-row-l">{r.label}</span><span class="hn-row-d">{r.desc}</span></span>
              </a></li>
            ))}
          </ul>
        </nav>
        <div class="hn-langs" role="group" aria-label={t.langAria}>
          <p class="hn-sub-h" aria-hidden="true"><span class="hn-row-ic" set:html={ic.globe} />{m.lang}</p>
          <div class="hn-lang-btns">
            {langLinks.map((l) => <a href={l.href} hreflang={l.code} lang={l.code} aria-current={L === l.code ? 'true' : undefined}>{l.name}</a>)}
          </div>
        </div>
        <p class="pwa-sheet"><button type="button" class="btn secondary pwa-install" data-pwa-install hidden>{pwa.install}</button></p>
        <ul class="hn-foot">
          <li><a href={m.vets.href} aria-current={current(m.vets.href) ? 'page' : undefined}>{m.vets.label}</a></li>
          <li><a href={m.about.href} aria-current={current(m.about.href) ? 'page' : undefined}>{m.about.label}</a></li>
          <li><a href={m.privacy.href} aria-current={current(m.privacy.href) ? 'page' : undefined}>{m.privacy.label}</a></li>
        </ul>
      </dialog>
    </header>

    <div id="lang-suggest" class="lang-suggest" hidden role="region" aria-label={t.langAria}>
      <span id="lang-suggest-text"></span>
      <a id="lang-suggest-link" class="btn" href="/"></a>
      <button id="lang-suggest-close" type="button" class="lang-suggest-close" aria-label={L === 'it' ? 'Chiudi' : L === 'de' ? 'Schließen' : 'Dismiss'}>×</button>
    </div>
  <script is:inline define:vars={{ pageLang: L, alternates }}>
    // Offer the page in the browser's language once; remembered on this device. Runs right after the
    // banner, before the page below it is parsed, so showing it never pushes painted content down (CLS).
    (function () {
      try {
        if (!alternates || !alternates.length || localStorage.getItem('aiveterinary.langSuggest') === 'off') return;
        var wanted = (navigator.languages || [navigator.language || '']).map(function (l) { return String(l).slice(0, 2).toLowerCase(); });
        var target = null;
        for (var i = 0; i < wanted.length; i++) { if (['en', 'it', 'de'].indexOf(wanted[i]) >= 0) { target = wanted[i]; break; } }
        if (!target || target === pageLang) return;
        var alt = alternates.filter(function (a) { return a[0] === target; })[0]; if (!alt) return;
        var text = { en: 'This page is also available in English.', it: 'Questa pagina è disponibile anche in italiano.', de: 'Diese Seite gibt es auch auf Deutsch.' }[target];
        var label = { en: 'Switch to English', it: 'Passa all\'italiano', de: 'Zu Deutsch wechseln' }[target];
        var box = document.getElementById('lang-suggest'); document.getElementById('lang-suggest-text').textContent = text;
        var link = document.getElementById('lang-suggest-link'); link.textContent = label; link.href = alt[1]; link.setAttribute('hreflang', target);
        box.hidden = false;
        var off = function () { try { localStorage.setItem('aiveterinary.langSuggest', 'off'); } catch (e) {} box.hidden = true; };
        document.getElementById('lang-suggest-close').addEventListener('click', off);
        link.addEventListener('click', off);
      } catch (e) {}
    })();
  </script>
    <main id="main" tabindex="-1">
      <slot />
    </main>

    <div class="foot-peek" aria-hidden="true"><AnimalIcon kind="cat" size={64} /><AnimalIcon kind="dog" size={72} /><AnimalIcon kind="rabbit" size={60} /></div>
    <footer class="site-footer">
      <div class="wrap">
        <div class="foot-brand">
          <strong>AI Veterinary</strong>
          <p class="foot-tag">{t.tagline}</p>
          <p class="foot-disc">{t.disclaimer}</p>
        </div>
        <nav aria-label={fh[0]}>
          <p class="foot-h">{fh[0]}</p>
          <ul>{t.footer1.map((f) => <li><a href={f.href}>{f.label}</a></li>)}</ul>
        </nav>
        <nav aria-label={fh[1]}>
          <p class="foot-h">{fh[1]}</p>
          <ul>{t.footer2.map((f) => <li><a href={f.href}>{f.label}</a></li>)}</ul>
        </nav>
      </div>
    </footer>
  <script is:inline>
    // Header: "Quick checks" disclosure and the phone menu sheet.
    (function () {
      var dd = document.querySelector('[data-hn-dd]');
      if (dd) {
        var btn = dd.querySelector('button'), panel = dd.querySelector('.hn-dd-panel');
        var set = function (open, refocus) { btn.setAttribute('aria-expanded', String(open)); if (!open && refocus) btn.focus(); };
        btn.addEventListener('click', function () { set(btn.getAttribute('aria-expanded') !== 'true'); });
        dd.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') { e.preventDefault(); set(false, true); }
        });
        dd.addEventListener('focusout', function (e) { if (e.relatedTarget && !dd.contains(e.relatedTarget)) set(false); });
        document.addEventListener('click', function (e) { if (!dd.contains(e.target)) set(false); });
      }
      var sheet = document.getElementById('hn-sheet'), opener = document.querySelector('button.hn-menu-btn');
      if (!sheet || !opener || typeof sheet.showModal !== 'function') { document.documentElement.classList.remove('js'); return; }
      var root = document.documentElement;
      var open = function () {
        sheet.showModal(); root.classList.add('hn-locked'); opener.setAttribute('aria-expanded', 'true');
        var first = sheet.querySelector('.hn-close'); if (first) first.focus();
      };
      var close = function () { if (sheet.open) sheet.close(); };
      opener.addEventListener('click', open);
      sheet.addEventListener('close', function () { root.classList.remove('hn-locked'); opener.setAttribute('aria-expanded', 'false'); opener.focus(); });
      sheet.querySelector('[data-hn-close]').addEventListener('click', function (e) { e.preventDefault(); close(); });
      sheet.addEventListener('keydown', function (e) {
        if (e.key !== 'Tab') return;
        var f = Array.prototype.filter.call(sheet.querySelectorAll('a[href], button:not([disabled])'), function (el) { return el.offsetParent !== null; });
        if (!f.length) return;
        var a = f[0], z = f[f.length - 1];
        if (e.shiftKey && document.activeElement === a) { e.preventDefault(); z.focus(); }
        else if (!e.shiftKey && document.activeElement === z) { e.preventDefault(); a.focus(); }
      });
      // A wide window shows the full header: close the sheet when the menu button is no longer shown.
      window.addEventListener('resize', function () { if (sheet.open && opener.offsetParent === null) close(); });
    })();
  </script>
  <div class="pwa-toast" id="pwa-toast" role="status" aria-live="polite" hidden>
    <span>{pwa.update}</span>
    <span class="pwa-toast-btns"><button type="button" class="btn" id="pwa-reload">{pwa.reload}</button><button type="button" class="pwa-later" id="pwa-later">{pwa.later}</button></span>
  </div>
  <script is:inline>
    // Install UI: "Install the app" buttons (Chromium/Android, from beforeinstallprompt) and the iOS hint on
    // the booklet page. Nothing is shown when the site already runs as an installed app.
    (function () {
      var standalone = (window.matchMedia && matchMedia('(display-mode: standalone)').matches) || navigator.standalone === true;
      var buttons = Array.prototype.slice.call(document.querySelectorAll('[data-pwa-install]'));
      var show = function () { buttons.forEach(function (b) { b.hidden = standalone || !window.__aivInstall; }); };
      buttons.forEach(function (b) {
        b.addEventListener('click', function () {
          var e = window.__aivInstall; if (!e) return;
          e.prompt();
          (e.userChoice || Promise.resolve()).finally(function () { window.__aivInstall = null; show(); });
        });
      });
      document.addEventListener('aiv:installable', show);
      addEventListener('appinstalled', function () { window.__aivInstall = null; show(); });
      show();
      var hint = document.querySelector('[data-pwa-ios]'); if (!hint || standalone) return;
      var KEY = 'aiveterinary.iosInstallHint';
      var ios = /iP(hone|od|ad)/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
      var off = false; try { off = localStorage.getItem(KEY) === 'off'; } catch (e) {}
      if (!ios || off) return;
      hint.hidden = false;
      var close = hint.querySelector('button');
      if (close) close.addEventListener('click', function () { try { localStorage.setItem(KEY, 'off'); } catch (e) {} hint.hidden = true; });
    })();
  </script>
  {isProd && (
  <script is:inline>
    // Service worker (public/sw.js): offline booklet, emergency check and pages already read. Production
    // builds only, over https or on localhost. A new version waits until the user chooses "Update now",
    // so the page is never reloaded under someone typing in the booklet.
    (function () {
      if (!('serviceWorker' in navigator)) return;
      var local = /^(localhost|127\.0\.0\.1|\[::1\])$/.test(location.hostname);
      if (location.protocol !== 'https:' && !local) return;
      var toast = document.getElementById('pwa-toast'), asked = false, waiting = null;
      var offer = function (w) {
        // Only an update: on the very first install there is no old version to replace.
        if (!w || !navigator.serviceWorker.controller) return;
        waiting = w; toast.hidden = false;
      };
      document.getElementById('pwa-reload').addEventListener('click', function () {
        if (!waiting) return;
        asked = true; toast.hidden = true;
        waiting.postMessage({ type: 'SKIP_WAITING' });
      });
      document.getElementById('pwa-later').addEventListener('click', function () { toast.hidden = true; });
      // Reload only the tab where the user chose to update (other tabs keep working on what they have).
      navigator.serviceWorker.addEventListener('controllerchange', function () { if (asked) location.reload(); });
      addEventListener('load', function () {
        navigator.serviceWorker.register('/sw.js').then(function (reg) {
          offer(reg.waiting);
          reg.addEventListener('updatefound', function () {
            var w = reg.installing; if (!w) return;
            w.addEventListener('statechange', function () { if (w.state === 'installed') offer(w); });
          });
          // The booklet may stay open for days: look for a new deploy when the tab comes back, at most hourly.
          var last = Date.now();
          document.addEventListener('visibilitychange', function () {
            if (document.visibilityState === 'visible' && Date.now() - last > 36e5) { last = Date.now(); reg.update().catch(function () {}); }
          });
        }).catch(function () {});
      });
    })();
  </script>
  )}
  </body>
