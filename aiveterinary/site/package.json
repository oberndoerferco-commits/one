{
  "name": "aiveterinary-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/review.mjs check && node scripts/check-species.mjs && node scripts/check-lexicon.mjs && node scripts/check-foods.mjs && node scripts/check-sources.mjs && node scripts/check-daily-rules.mjs && node scripts/check-seasonal.mjs && astro build && node scripts/copy-ocr.mjs && pagefind --site dist",
    "preview": "astro preview",
    "check:seo": "node scripts/seo-check.mjs dist",
    "test:db": "bash supabase/tests/run.sh",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.117.3",
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/ita": "^1.0.0",
    "aiveterinary-app": "file:../app",
    "astro": "^5.0.0",
    "tesseract.js": "^5.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "js-yaml": "^4.3.2",
    "pagefind": "^1.5.2",
    "vitest": "5.0.5"
  }
}
