{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "0.1.0",
  "default_locale": "en",
  "action": { "default_popup": "popup.html", "default_title": "__MSG_extName__" },
